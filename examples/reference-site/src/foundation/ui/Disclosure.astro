---
/**
 * Disclosure primitive — Interactive group
 *
 * Contract:
 * - Progressive enhancement: uses <details>/<summary> as base
 * - Accessible via native <details> behavior (no JS required)
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
interface Props {
  /** Initial open state */
  open?: boolean;
  /** Element id */
  id?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const {
  open = false,
  id,
  class: className,
} = Astro.props;
---

<details id={id} open={open} class={className}>
  <slot name="trigger" />
  <div class="pt-[var(--space-2)]">
    <slot />
  </div>
</details>
