---
/**
 * SkipLink primitive — FND-A11Y-08
 *
 * Contract:
 * - Links to #main-content for keyboard navigation
 * - Visually hidden, visible on focus
 * - Text from UI strings dictionary (FND-ARCH-03)
 * - Meets 44×44 target size requirement (FND-A11Y-05)
 * - CSS logical properties only (FND-I18N-13)
 */
const skipText = "Skip to main content";
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:inset-block-start-2 focus:inset-inline-start-2 focus:z-[9999] focus:min-h-11 focus:min-w-11 focus:px-4 focus:py-2 focus:bg-[var(--accent-primary)] focus:text-[var(--text-on-accent)] focus:rounded-[var(--radius-md)] focus:text-base focus:font-medium focus:outline-none focus:ring-2 focus:ring-[var(--focus-ring)] focus:ring-offset-2"
>
  {skipText}
</a>
