---
/**
 * HomePage — shared home-page assembly for every locale.
 *
 * The default-locale (unprefixed) and non-default-locale (prefixed) home routes
 * both render through this one component so there is a single rendering path
 * (route file → shared page component, per astro-architecture.md). The route
 * files own only `getStaticPaths` + the locale; this component owns the
 * editorial content loading, SEO, CTA resolution, and the locked section order.
 *
 * Assembly: docs/home/home-components/13-home-assembly.md
 * Blueprint: docs/home/reference/blueprint.md §5 (Homepage order)
 *
 * Uses the `Page` primitive directly (owns <head>/SEO/hreflang/global CSS — only
 * Page emits head tags) rather than BaseLayout, because the premium home chrome
 * is the SiteHeader + SiteFooter pair, not the generic foundation Header/Footer
 * BaseLayout composes. Body holds: SkipLink (Page), SiteHeader, <main>,
 * SiteFooter.
 *
 * Content is fetched per locale from the `pages` collection and narrowed to the
 * `home` archetype (homePageSchema via the pageType discriminator) so the hero
 * and finalCta blocks are typed and passed straight to the components. All three
 * locales (sr/en/ru) are required (FND-I18N — every locale for every page).
 *
 * Clean-slate shell assembly (Step 1). Verified components mounted in the
 * locked order: SiteHeader (§1), HomepageHero (§2), ServiceShowcase (§3),
 * PrivateChauffeurFeature (§4), TrustStrip (§5), FleetShowcase (§6),
 * HowItWorks (§7), FinalCTA (§9), SiteFooter (§10). The remaining region —
 * GoogleReviews (§8) — is a clean integration boundary only (TODO marker, no
 * rendered markup): it slots in between How It Works and FinalCTA as its
 * homepage-specific component lands in a later task (13 §Exact order). Each
 * component owns its own section spacing, so no wrapper rhythm is added here.
 *
 * Routing invariant (P1.5): the default locale (sr) is UNPREFIXED, so the
 * Serbian home is generated at `/` by pages/index.astro; non-default locales
 * keep the `/locale/` prefix and are generated by pages/[locale]/index.astro
 * (en→/en/, ru→/ru/). Both call this component. `getPath("home", sr)` returns
 * `/` and `getPath("home", en)` returns `/en/`, so generation now matches
 * getPath / hreflang / canonical / internal links for every locale.
 */
import Page from "../../foundation/ui/Page.astro";
import SiteHeader from "../site/SiteHeader.astro";
import SiteFooter from "../site/SiteFooter.astro";
import HomepageHero from "./HomepageHero.astro";
import ServiceShowcase from "./ServiceShowcase.astro";
import PrivateChauffeurFeature from "./PrivateChauffeurFeature.astro";
import FleetShowcase from "./FleetShowcase.astro";
import HowItWorks from "./HowItWorks.astro";
import ReviewsShowcase from "./ReviewsShowcase.astro";
import FinalCTA from "../shared/FinalCTA.astro";
import Section from "../../foundation/ui/Section.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../foundation/ui/SectionHeading.astro";
import TrustStrip from "../shared/TrustStrip.astro";
import { getCollection } from "astro:content";
import { buildPageSeo } from "../../lib/seo.ts";
import { resolveCtaHref, type Cta } from "../../lib/cta.ts";
import { t } from "../../lib/i18n.ts";
import { contact, isVerified } from "../../data/contact.ts";
import { getService } from "../../data/services.ts";
import { getVehicle, type VehicleClass } from "../../data/fleet.ts";
import { homepageFleetMedia, homepageFleetOrder } from "../../data/fleet-media.ts";
import { getReviewsSummary } from "../../data/reviews.ts";
import heroImg from "../../assets/hero-example-2.jpg";
import finalCtaImg from "../../assets/final-cta-bg.webp";
import privateChauffeurSectionImg from "../../assets/sections/home/private-chauffeur.webp";
import type { LocaleCode } from "@astro-foundation/core";

interface Props {
  locale: LocaleCode;
}

const { locale: currentLocale } = Astro.props;

// --- Editorial content (per locale) --------------------------------------
const pages = await getCollection("pages");
const entry = pages.find(
  (p) => p.data.routeKey === "home" && p.data.locale === currentLocale,
);
if (!entry) {
  throw new Error(
    `Home page content not found for locale "${currentLocale}" — every locale requires a published home entry (src/content/pages/home/home.${currentLocale}.md).`,
  );
}
// Discriminate the union to the home archetype so hero/finalCta are typed.
if (entry.data.pageType !== "home") {
  throw new Error(
    `Home route entry for locale "${currentLocale}" has pageType "${entry.data.pageType}" — expected "home".`,
  );
}
const { hero, services, flagshipFeature, finalCta, seoTitle, seoDescription, trust, process, fleet, reviews } = entry.data;

// TrustStrip (blueprint §10 / 13 §5) — canonical content IS authored for all
// three locales (home.*.md `trust`: a `heading.title` + exactly 4 `items` with
// title+text), so the verified TrustStrip is mounted now, not deferred. The
// `trust.heading` slot is optional in homePageSchema; it is present in every
// authored locale, but the section is guarded so an unauthored heading never
// produces an unlabeled <Section> (aria-labelledby only set when heading
// renders). TrustStrip embeds no heading of its own — the page owns the <h2>
// via <SectionHeading> (component-architecture.md §14, TrustStrip JSDoc).
const trustHeading = trust.heading;
const trustHeadingId = "home-trust-heading";

// --- SEO (content-driven) -------------------------------------------------
const seo = buildPageSeo({
  routeKey: "home",
  locale: currentLocale,
  title: seoTitle,
  description: seoDescription,
});

// Hero CTAs resolve via resolveCtaHref (FND-I18N-03 — flow targets route to
// the contact page as the interim booking/quote target; lib/cta.ts).
//
// Locked Hero composition (03-home-hero / blueprint §7) — now authored in the
// editorial home content for all three locales:
//   • primary    Book a ride       → flow:booking  (interim → contact)   [wired]
//   • secondary  Request a Quote   → flow:quote   (interim → contact)   [wired]
//   • right-side support statement → hero.supportText                   [wired]
// The editorial hero block authors `primaryCta` ("Book a ride" → booking flow)
// and `secondaryCta` ("Request a Quote" → quote flow). Both flow intents are
// distinct (blueprint §19 lists booking + quote as separate hooks) but, while
// the dedicated flows are unimplemented, resolveCtaHref's documented interim
// fallback routes both to the contact page — no hardcoded locale URL. The
// right-side support statement is authored per locale and required by
// homeHeroSchema (shared.ts heroSchema marks it optional; pages.ts
// homeHeroSchema requires it for the Homepage 7/5 split), so it is wired here
// and the desktop 7/5 split now activates.
//
// The component props `secondaryAction` / `supportText` remain OPTIONAL on
// HomepageHero (presentation-only, reusable on /dev/ui); promoting them to
// required is a separate visual-lock milestone (HomepageHero.types.ts
// TODO(home-visual-lock)) and does not block this content wiring.
// The hero image is the approved pending S-Class asset (blueprint §21).
const heroPrimaryAction = {
  label: hero.primaryCta.label,
  href: resolveCtaHref(hero.primaryCta as Cta, currentLocale),
};
const heroSecondaryAction = hero.secondaryCta
  ? {
      label: hero.secondaryCta.label,
      href: resolveCtaHref(hero.secondaryCta as Cta, currentLocale),
    }
  : undefined;

// --- FinalCTA (canonical shared component, same as /dev/ui) --------------
// The Homepage uses the SAME authoritative shared/FinalCTA.astro the user
// approved in /dev/ui — the legacy home/FinalCTA.astro adapter is deleted.
// The editorial `finalCta` block (heading/text/primaryCta/secondaryCta) maps
// straight onto the shared component's presentation-only props; CTA hrefs
// resolve via resolveCtaHref (FND-I18N-03 — never manual URLs). The image is
// the approved final-cta-bg.webp, wired via the component's <Image> API with
// imageFit="cover" (contextual photo, right-zone) — matching /dev/ui.
//
// Contacts use the SAME verified-only canonical gating as /dev/ui + SiteFooter
// (contact.ts isVerified): one phone + one email only (no WhatsApp line here).
// Repository contact.ts currently has phone/email = null +
// "owner-confirmation-required" → no verified channels → the contact row is
// absent (no fake placeholder values). Once the owner verifies, exactly one
// phone + one email render here, in /dev/ui, and in SiteFooter.
const finalCtaPrimaryAction = {
  label: finalCta.primaryCta.label,
  href: resolveCtaHref(finalCta.primaryCta as Cta, currentLocale),
};
const finalCtaSecondaryAction = finalCta.secondaryCta
  ? {
      label: finalCta.secondaryCta.label,
      href: resolveCtaHref(finalCta.secondaryCta as Cta, currentLocale),
    }
  : undefined;
const fctaPhone = isVerified(contact.phone) ? contact.phone.value : null;
const fctaEmail = isVerified(contact.email) ? contact.email.value : null;
const finalCtaContacts =
  fctaPhone || fctaEmail
    ? {
        phone: fctaPhone ?? undefined,
        email: fctaEmail ?? undefined,
      }
    : undefined;

// --- Private Chauffeur feature (blueprint §9 / 06-private-chauffeur-feature) -
// The flagship-service editorial split. Three concerns kept separate (task §15):
//   • editorial content  → flagshipFeature (heading/body/cta) from home content
//   • operational facts  → services.privateChauffeur.bookingOptions (services.ts)
//   • CTA destination    → resolveCtaHref via the routing abstraction
// The package summary is informational duration/km structure only — NO monetary
// price is rendered (task §14). Numbers come from canonical service data so
// 1 / 5 / 10 / 100 / 200 are never hardcoded here; localized mode labels and
// unit words come from the UI dictionary (booking.* keys) so no translation is
// invented in markup. If the canonical booking options are unexpectedly absent,
// fail loud at build — no silent numeric fallback that could mask missing data
// (task §33: operational facts must come from canonical data).
const flagshipCta = {
  label: flagshipFeature.cta.label,
  href: resolveCtaHref(flagshipFeature.cta as Cta, currentLocale),
};
const bookingOpts = getService("privateChauffeur").bookingOptions;
if (!bookingOpts?.hourly || !bookingOpts?.halfDay || !bookingOpts?.fullDay) {
  throw new Error(
    "privateChauffeur bookingOptions (hourly/halfDay/fullDay) missing in src/data/services.ts — the Private Chauffeur feature package summary requires these canonical operational facts.",
  );
}
const fromLbl = t("booking.from", currentLocale);
const upToLbl = t("booking.upTo", currentLocale);
const hoursLbl = t("booking.unit.hours", currentLocale);
const kmLbl = t("booking.unit.km", currentLocale);
const flagshipPackages = [
  {
    label: t("booking.mode.hourly", currentLocale),
    detail: `${fromLbl} ${bookingOpts.hourly.minimumHours} ${hoursLbl}`,
  },
  {
    label: t("booking.mode.halfDay", currentLocale),
    detail: `${bookingOpts.halfDay.hours} ${hoursLbl} · ${upToLbl} ${bookingOpts.halfDay.includedKm} ${kmLbl}`,
  },
  {
    label: t("booking.mode.fullDay", currentLocale),
    detail: `${bookingOpts.fullDay.hours} ${hoursLbl} · ${upToLbl} ${bookingOpts.fullDay.includedKm} ${kmLbl}`,
  },
];
// Dedicated contextual image for the Private Chauffeur feature. It is
// decorative because the authored heading and body carry the service meaning.
const flagshipImage = privateChauffeurSectionImg;

// --- Fleet showcase (blueprint §11 / 08-fleet-showcase) ---------------------
// Three concerns kept separate (08 §Content/data boundaries), mirroring the
// Private Chauffeur feature's ownership split:
//   • editorial content  → fleet.heading (title + intro) + fleet.cta (label)
//   • vehicle facts      → vehicles (fleet.ts) projected to display strings
//   • route destination  → resolveCtaHref(fleet.cta) → <Link href>
//
// Vehicle identity is NOT translated — `vehicle.displayName` is rendered
// verbatim (fleet.ts vocabulary: one source, all locales). `vehicleClass` is
// a canonical structural enum (sedan/van/minivan/bus); its localized display
// label comes from the UI dictionary (`fleet.class.*`) via static keys keyed
// by VehicleClass — never a dynamically-built `t()` key (UiStringKey is a
// literal union; FND-ARCH-03 / FND-TYPE-02). Passenger capacity is rendered
// ONLY where `vehicle.passengers !== null` (the 6/7/8 V-Class/Vito facts);
// null capacities are omitted, never fabricated as 0/N/A/unknown (08 §Forbidden;
// task §11). No pricing, no luggage/year/engine facts (task §13). All seven
// canonical vehicles render in the approved homepage presentation order,
// led by the S-Class. NEW fleet.* UI keys (class labels, passenger word, carousel control
// labels) are flagged for loc-owner review, same as the booking.* keys.
const fleetCta = {
  label: fleet.cta.label,
  href: resolveCtaHref(fleet.cta as Cta, currentLocale),
};
const fleetClassLabels: Record<VehicleClass, string> = {
  sedan: t("fleet.class.sedan", currentLocale),
  van: t("fleet.class.van", currentLocale),
  minivan: t("fleet.class.minivan", currentLocale),
  bus: t("fleet.class.bus", currentLocale),
};
const fleetPassengersWord = t("fleet.passengers", currentLocale);
const fleetCarouselLabels = {
  ariaLabel: t("fleet.carousel.ariaLabel", currentLocale),
  previous: t("fleet.carousel.previous", currentLocale),
  next: t("fleet.carousel.next", currentLocale),
};
const fleetVehicles = homepageFleetOrder.map((vehicleId) => {
  const vehicle = getVehicle(vehicleId);
  return {
    id: vehicle.id,
    name: vehicle.displayName,
    classLabel: fleetClassLabels[vehicle.vehicleClass],
    passengerText:
      vehicle.passengers !== null
        ? `${vehicle.passengers} ${fleetPassengersWord}`
        : undefined,
    image: homepageFleetMedia[vehicle.id] ?? undefined,
  };
});

// --- Google Reviews (blueprint §13 / 10-reviews) -----------------------------
// The local Places fixture is development-only. Production gates the whole
// region on the verified Google profile/data boundary so fabricated review
// text and cross-locale fixture copy can never ship.
const reviewsSummary = getReviewsSummary();
const verifiedReviewsProfileUrl =
  contact.office.verificationStatus === "verified" &&
  contact.office.googleMapsUrl
    ? contact.office.googleMapsUrl
    : null;
// Synthetic reviews are a development fixture, never production content. This
// also prevents Serbian fixture copy from leaking onto English/Russian pages.
// Production enables the section only after the verified Google profile/data
// boundary is available; development retains the fixture for component work.
const showReviews = import.meta.env.DEV || Boolean(verifiedReviewsProfileUrl);
const reviewsProfileUrl = import.meta.env.DEV
  ? verifiedReviewsProfileUrl ?? reviewsSummary.googleMapsUrl
  : verifiedReviewsProfileUrl;
---

<Page
  seo={seo}
  headingFontWeight="regular"
  locale={currentLocale}
  class="min-h-screen flex flex-col bg-[var(--color-background)] text-[var(--color-text-primary)]"
>
  <SiteHeader currentRouteKey="home" currentLocale={currentLocale} overHero={true} />

  <main id="main-content" class="flex-1" data-home-motion-root>
    {/* The full-bleed Hero is the first element under the sticky SiteHeader.
        The hero media must start at the page top BEHIND the overlaid header
        (transparent over-hero state at page top, solid on scroll). The header
        is position:sticky (in-flow), so the hero is pulled up under it by
        --site-header-height (exposed by SiteHeader); the header's z-index
        keeps it above the media. The offset is a homepage layout concern
        (owned here, not in the reusable hero component). */}
    <div class="home-hero-offset">
      <HomepageHero
        title={hero.title}
        description={hero.description}
        primaryAction={heroPrimaryAction}
        secondaryAction={heroSecondaryAction}
        supportText={hero.supportText}
        image={heroImg}
        imageAlt=""
        locale={currentLocale}
      />
    </div>

    {/*
      13 §Exact order — locked homepage section sequence. Verified components
      mounted: HomepageHero (§2), ServiceShowcase (§3), TrustStrip (§5),
      FinalCTA (§9). The remaining regions are clean integration boundaries
      only — NO visible placeholders, NO dev fixtures, NO legacy markup. Each
      lands as its homepage-specific component is implemented in a later task.

      §3 ServiceShowcase — MOUNTED below (homepage-specific 35/30/35 asymmetric
        mosaic, blueprint §8 / 04-service-showcase). Consumes canonical
        `services` (entry.data.services) — heading + exactly 4 routeCard items
        in canonical order. ServiceShowcase owns the mosaic topology + section
        heading; the reused generic ServiceCard owns each image-backed tile.

      §4 Private Chauffeur feature — MOUNTED below as <PrivateChauffeurFeature>
        (blueprint §9 / 06-private-chauffeur-feature): editorial
        `flagshipFeature` (heading/body/cta) + canonical package facts from
        services.ts (bookingOptions) + localized labels from the UI dictionary,
        composed on the shared OpenSplitSection (locked 5/7, content left /
        image right). Image: approved dedicated chauffeur/S-Class split
        photograph.

      §5 TrustStrip — MOUNTED below (canonical 4-item content is authored).
    */}

    <ServiceShowcase
      heading={services.heading}
      items={services.items}
      locale={currentLocale}
    />

    <PrivateChauffeurFeature
      heading={flagshipFeature.heading.title}
      body={flagshipFeature.body}
      cta={flagshipCta}
      packages={flagshipPackages}
      image={flagshipImage}
      imageAlt=""
      locale={currentLocale}
    />

    <Section
      spacing="standard"
      aria-labelledby={trustHeading ? trustHeadingId : undefined}
    >
      <PageContainer>
        {trustHeading ? (
          <SectionHeading
            id={trustHeadingId}
            heading={trustHeading.title}
            description={trustHeading.intro}
            class="mb-[var(--space-6)]"
          />
        ) : null}
        <TrustStrip items={trust.items} />
      </PageContainer>
    </Section>

    {/*
      §6 Fleet showcase — MOUNTED below (blueprint §11 / 08-fleet-showcase):
        an open dark feature section with the heading row (editorial
        `fleet.heading` + the resolved "View fleet" section action) and the
        reused shared HorizontalCarousel (itemSize "compact") carrying all
        seven canonical vehicles in the approved homepage order. Each card is a
        presentation-only projection of fleet.ts (display name verbatim,
        localized vehicle-class label, passenger-capacity chip only where
        non-null) over the matching approved fleet photograph when available;
        the Vito keeps the truthful graphite fallback because no matching asset
        exists. No pricing, no fabricated
        facts. The carousel mechanics are reused unchanged (task §8/§17/§27).
    */}
    <FleetShowcase
      heading={fleet.heading}
      cta={fleetCta}
      vehicles={fleetVehicles}
      carouselLabels={fleetCarouselLabels}
      locale={currentLocale}
    />

    {/*
      §7 How It Works — intentional light contained section (blueprint §12 /
        09-how-it-works). MOUNTED below: one contained light panel with the
        heading block + a semantic 3-step ordered process (request →
        confirmation → pickup) from `process` (entry.data.process). The
        component owns its panel/dividers; this page owns the section rhythm.
    */}
    <HowItWorks heading={process.heading} steps={process.steps} />

    {/*
      §8 Google Reviews — development fixture only until the production Google
        profile and review data are verified. The section is omitted from
        production rather than shipping fabricated or cross-locale review copy.
    */}
    {showReviews ? (
      <ReviewsShowcase
        heading={reviews.heading}
        profileLabel={reviews.externalProfileLabel}
        profileUrl={reviewsProfileUrl}
        reviews={reviewsSummary.reviews}
        locale={currentLocale}
      />
    ) : null}

    <FinalCTA
      heading={finalCta.heading}
      description={finalCta.text}
      primaryAction={finalCtaPrimaryAction}
      secondaryAction={finalCtaSecondaryAction}
      contacts={finalCtaContacts}
      image={finalCtaImg}
      imageFit="cover"
      mediaTreatment="integrated"
      imageAlt=""
      locale={currentLocale}
    />
  </main>

  <SiteFooter currentRouteKey="home" currentLocale={currentLocale} />
</Page>

<style>
  /* Pull the full-bleed hero up under the sticky SiteHeader so the hero media
     starts at the page top behind the overlaid header chrome. --site-header-
     height is the header's own total height (exposed globally by
     SiteHeader.astro); using it keeps the offset in lockstep with the header
     instead of a hardcoded magic number. Scoped: this wrapper is rendered by
     the page, so the scope applies. */
  .home-hero-offset {
    margin-block-start: calc(-1 * var(--site-header-height));
  }
</style>

<style is:global>
  /* Progressive enhancement: content remains fully visible until the script
     has identified and registered each section. Sections reveal once, with a
     small vertical settle; reduced-motion users always receive the static page. */
  @media (prefers-reduced-motion: no-preference) {
    [data-home-motion-root][data-home-motion-ready] > [data-home-reveal] {
      opacity: 0;
      transform: translateY(var(--space-4));
      transition:
        opacity var(--duration-cinematic) var(--ease-entrance),
        transform var(--duration-cinematic) var(--ease-entrance);
    }

    [data-home-motion-root][data-home-motion-ready] > [data-home-reveal][data-home-revealed] {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // island: homepage section reveals — progressive, one-shot and motion-safe.
  const motionRoot = document.querySelector<HTMLElement>("[data-home-motion-root]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (motionRoot && !reducedMotion && "IntersectionObserver" in window) {
    const sections = Array.from(
      motionRoot.querySelectorAll<HTMLElement>(":scope > section"),
    );

    for (const section of sections) {
      section.setAttribute("data-home-reveal", "");
      if (section.getBoundingClientRect().top < window.innerHeight * 0.9) {
        section.setAttribute("data-home-revealed", "");
      }
    }

    motionRoot.setAttribute("data-home-motion-ready", "");

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute("data-home-revealed", "");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );

    for (const section of sections) {
      if (!section.hasAttribute("data-home-revealed")) {
        revealObserver.observe(section);
      }
    }
  }
</script>
