---
/**
 * ReviewsShowcase — Homepage Google Reviews section (blueprint §13 /
 * home-components/10-reviews.md "GoogleReviews V1.1").
 *
 * Social-proof section immediately before FinalCTA. Open dark Homepage section
 * on the page canvas (NOT a contained panel); individual review cards use the
 * elevated surface (10-reviews.md). The section stays visually quieter than
 * Hero and FinalCTA.
 *
 * Composition (wireframe §REVIEWS, exact): a heading ROW — heading + short
 * intro left, compact external Google profile action right (stacked on mobile) —
 * followed by a review carousel. The carousel is the approved shared
 * HorizontalCarousel (itemSize "standard" → ~3 cards desktop / ~1.5–2 tablet /
 * swipeable-with-peek mobile, per 10-reviews.md + HorizontalCarousel.types.ts);
 * the same generic carousel is used by Fleet, so no Reviews-only behavior is
 * pushed into the carousel core (component-architecture.md §16). Each review is
 * a `<li><ReviewCard/></li>` — the `<li>` is the carousel item, ReviewCard fills
 * it (block-size:100% under the track's default align-items:stretch).
 *
 * Data: MOCK DATA MODE. The page passes the normalized summary from
 * data/reviews.ts getReviewsSummary() (local mocked Places fixture) + the
 * per-locale editorial heading/CTA from entry.data.reviews. The review text
 * itself is NOT localized per page locale (an external Google review keeps its
 * own language — task §28); only the UI chrome (carousel labels, rating unit,
 * heading, CTA) is localized via content/ui/*.json t(). Raw Google field names
 * never reach the markup — data/reviews.ts normalizes them into
 * ReviewViewModel, and ReviewCard consumes only that clean model.
 *
 * External-link safety (task §22 / 10-reviews.md): the section-level Google
 * profile CTA is GATED — it renders only when `profileUrl` is non-null. In mock
 * mode the page passes the mock place-level googleMapsUri for structural
 * testing; once contact.office.googleMapsUrl is verified it takes precedence
 * (wired in HomePage). The mock URL is an obviously-fake path, the fixture is
 * `.mock.json`, and the import is commented MOCK — so a mock URL can never be
 * mistaken for a verified production Google destination. The <Link> primitive
 * adds rel="noopener noreferrer" + target="_blank" for external hrefs (the
 * project's external-link convention).
 *
 * Heading hierarchy: the Hero owns the only H1; this section renders one H2 via
 * <SectionHeading>. Reviewer names are not headings (10-reviews.md / task §27).
 * Section is aria-labelledby the heading id. Static — only HorizontalCarousel's
 * progressive-enhancement script runs (no Reviews-only island/JS). class
 * passthrough is layout-only (FND-UI-06). CSS logical properties only
 * (FND-I18N-13).
 */
import type { ReviewsShowcaseProps } from "./ReviewsShowcase.types.ts";
import Section from "../../foundation/ui/Section.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../foundation/ui/SectionHeading.astro";
import HorizontalCarousel from "../shared/HorizontalCarousel.astro";
import ReviewCard from "../shared/ReviewCard.astro";
import Link from "../../foundation/ui/Link.astro";
import { t } from "../../lib/i18n.ts";

type Props = ReviewsShowcaseProps;

const { heading, profileLabel, profileUrl, reviews, locale, class: className } =
  Astro.props;

if (reviews.length === 0) {
  throw new Error(
    "ReviewsShowcase requires at least one review — data/reviews.ts returned an empty set. The Google Reviews carousel cannot render with no reviews.",
  );
}

// Stable single-instance heading id → aria-labelledby on the <Section>.
const headingId = "home-reviews-heading";

// Localized carousel control labels + accessible rating unit, from the UI
// dictionary (FND-ARCH-03 — no hardcoded a11y strings). Parallel to the
// fleet.carousel.* keys already used by the Fleet carousel.
const carouselAriaLabel = t("reviews.carousel.ariaLabel", locale);
const carouselPrevious = t("reviews.carousel.previous", locale);
const carouselNext = t("reviews.carousel.next", locale);
const ratingOutOf = t("reviews.rating.outOf", locale);

// The section CTA renders only when a destination exists (gated). 10-reviews.md:
// "Until that destination is verified, do not invent or guess a link." In mock
// mode `profileUrl` is the mock place URL (structural testing); when the owner
// verifies contact.office.googleMapsUrl the page passes that instead.
const showProfileCta = Boolean(profileUrl);
---
<Section
  spacing="standard"
  surface="open-dark"
  aria-labelledby={headingId}
  class={className}
>
  <PageContainer>
    <div
      class="mb-[var(--space-8)] flex flex-col items-start justify-between gap-[var(--space-5)] md:flex-row md:items-end md:justify-between"
    >
      <SectionHeading
        id={headingId}
        heading={heading.title}
        description={heading.intro}
        level={2}
        on="dark"
        accent={false}
        class="max-w-[var(--measure-body)]"
      />
      {showProfileCta ? (
        <Link
          variant="button"
          href={profileUrl ?? undefined}
          locale={locale}
          class="shrink-0"
        >
          {profileLabel}
        </Link>
      ) : null}
    </div>

    <HorizontalCarousel
      id="home-reviews-carousel"
      ariaLabel={carouselAriaLabel}
      previousLabel={carouselPrevious}
      nextLabel={carouselNext}
      itemSize="standard"
    >
      {reviews.map((review) => (
        <li>
          <ReviewCard
            id={review.id}
            authorName={review.authorName}
            rating={review.rating}
            text={review.text}
            relativeTime={review.relativeTime}
            ratingLabel={`${review.rating} ${ratingOutOf}`}
          />
        </li>
      ))}
    </HorizontalCarousel>
  </PageContainer>
</Section>
