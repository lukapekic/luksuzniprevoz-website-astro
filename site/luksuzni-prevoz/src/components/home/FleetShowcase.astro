---
/** Homepage fleet showcase: shared card, canonical family view models, existing CTA. */
import type { FleetShowcaseProps } from "./FleetShowcase.types.ts";
import Section from "../../foundation/ui/Section.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../foundation/ui/SectionHeading.astro";
import Link from "../../foundation/ui/Link.astro";
import HorizontalCarousel from "../shared/HorizontalCarousel.astro";
import FleetCard from "../shared/FleetCard.astro";
type Props = FleetShowcaseProps;
const { heading, cta, vehicles, carouselLabels, locale } = Astro.props;
const headingId = "home-fleet-heading";
---

<Section spacing="feature" surface="open-dark" aria-labelledby={headingId}>
  <PageContainer>
    <div class="mb-[var(--space-8)] flex flex-col items-start justify-between gap-[var(--space-5)] md:flex-row md:items-end">
      <SectionHeading id={headingId} heading={heading.title} description={heading.intro} level={2} class="max-w-2xl" />
      <Link href={cta.href} variant="button" locale={locale}>{cta.label}</Link>
    </div>
    <HorizontalCarousel id="home-fleet-carousel" ariaLabel={carouselLabels.ariaLabel} previousLabel={carouselLabels.previous} nextLabel={carouselLabels.next} itemSize="fleet" itemCount={vehicles.length} showCounter>
      {vehicles.map((vehicle) => (
        <li><FleetCard name={vehicle.name} categoryLabel={vehicle.classLabel} passengerText={vehicle.passengerText} image={vehicle.image} /></li>
      ))}
    </HorizontalCarousel>
  </PageContainer>
</Section>
