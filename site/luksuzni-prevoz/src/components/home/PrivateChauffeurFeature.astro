---
/**
 * PrivateChauffeurFeature — Homepage flagship-service editorial split (V1.1).
 *
 * The Homepage's second, deeper moment for the Private Chauffeur service
 * (blueprint §9 / 06-private-chauffeur-feature). It composes the shared
 * `OpenSplitSection` primitive (content | image, locked 5/7 desktop) inside a
 * page-owned `<Section surface="open-dark" spacing="feature">` + `<PageContainer>`,
 * so section rhythm and horizontal gutter stay with the caller's blueprint
 * composition, exactly as OpenSplitSection's ownership contract requires
 * (OpenSplitSection owns COMPOSITION ONLY — it deliberately renders no
 * <Section>/<PageContainer>).
 *
 * Content stack (06 §Content stack): restrained platinum accent rule → H2 →
 * concise body → package summary → one service-level CTA. The accent rule and
 * H2/body come from `<SectionHeading accent>` (the approved heading primitive,
 * also used by the Trust section) — its `--color-accent` rule is Platinum under
 * Theme V2 and its `font-heading` is Inter Tight, so no local typography
 * override is needed (06 forbids overriding the heading family).
 *
 * Package summary (06 §Package summary): three equal informational columns
 * (Hourly | Half Day | Full Day) with `divider`-role separators — a `<dl>` of
 * `<dt>` mode label + `<dd>` operational detail. It is informational
 * duration/km structure, NOT a pricing UI: no monetary value is rendered here
 * (task §14), and the numbers are assembled by the caller from
 * `services.privateChauffeur.bookingOptions` so this component hardcodes none
 * of 1 / 5 / 10 / 100 / 200 (task §13 / §16). Mobile collapses to one column
 * with horizontal dividers; `sm` activates three columns with vertical
 * dividers — mirroring the wireframe exactly, with no individual cards/pills.
 *
 * Image role (06 §Image / blueprint §21): one contextual chauffeur/S-Class
 * split photo, decorative (alt=""), 4:3 object-cover with `--radius-card` — all
 * owned by OpenSplitSection. The caller passes an approved asset; a dedicated
 * chauffeur/S-Class photograph is not yet produced, so the caller wires an
 * interim approved S-Class asset (flagged in the page) until that asset lands
 * (DESIGN.md §14 — missing assets do not authorize redesign).
 *
 * Ownership/data: presentation-only. The editorial heading/body, the resolved
 * package facts, and the CTA href arrive as props (task §15 — three concerns
 * kept out of one hardcoded component object). The CTA uses the canonical
 * routing abstraction (resolveCtaHref in the page → <Link href>) — no hardcoded
 * locale prefix (FND-I18N-03). No client JS (static Astro output).
 */
import type { PrivateChauffeurFeatureProps } from "./PrivateChauffeurFeature.types.ts";
import Section from "../../foundation/ui/Section.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../foundation/ui/SectionHeading.astro";
import OpenSplitSection from "../shared/OpenSplitSection.astro";
import Link from "../../foundation/ui/Link.astro";

type Props = PrivateChauffeurFeatureProps;

const { heading, body, cta, packages, image, imageAlt, locale } = Astro.props;

// Stable single-instance heading id → aria-labelledby on the <Section> (the
// Section owns the landmark, not OpenSplitSection — FND-A11Y landmarks).
const headingId = "home-private-chauffeur-heading";

// Package-summary cell classes — three complete static class strings keyed by
// column index (tailwind-v4.md §12/§13 — never constructed dynamically). The
// border pattern mirrors the wireframe exactly: mobile = horizontal divider
// between rows (border-b on cells 0/1, none on 2); sm+ = vertical divider
// between columns (border-e on cells 0/1, none on 2) with matching inline
// padding so the `divider`-role line sits centered in the gutter. No cards,
// pills, or boxes (06 §Package summary / DESIGN.md §17 "No cardification").
const SUMMARY_CELL_CLASSES = [
  "grid gap-[var(--space-1)] border-b border-[var(--color-divider)] py-[var(--space-4)] sm:border-b-0 sm:border-e sm:pe-[var(--space-4)]",
  "grid gap-[var(--space-1)] border-b border-[var(--color-divider)] py-[var(--space-4)] sm:border-b-0 sm:border-e sm:px-[var(--space-4)]",
  "grid gap-[var(--space-1)] py-[var(--space-4)] sm:ps-[var(--space-4)]",
];
---

<Section spacing="feature" surface="open-dark" aria-labelledby={headingId}>
  <PageContainer>
    <OpenSplitSection
      image={image}
      imageAlt={imageAlt}
      layout="content-image"
      ratio="5-7"
    >
      <div slot="content" class="flex flex-col gap-[var(--space-6)]">
        <SectionHeading
          id={headingId}
          heading={heading}
          description={body}
          level={2}
          on="dark"
          accent={true}
        />

        <dl class="grid grid-cols-1 border-y border-[var(--color-divider)] sm:grid-cols-3">
          {packages.map((pkg, i) => (
            <div class:list={[SUMMARY_CELL_CLASSES[i]]}>
              <dt class="font-body text-[length:var(--text-ui)] font-semibold leading-[var(--line-height-ui)] tracking-[var(--letter-spacing-ui)] text-[var(--color-text-primary)]">
                {pkg.label}
              </dt>
              <dd class="font-body text-[length:var(--text-sm)] leading-[var(--line-height-body)] text-[var(--color-text-muted)]">
                {pkg.detail}
              </dd>
            </div>
          ))}
        </dl>

        <div>
          <Link href={cta.href} variant="button" locale={locale}>{cta.label}</Link>
        </div>
      </div>
    </OpenSplitSection>
  </PageContainer>
</Section>
