---
import type { CollectionEntry } from "astro:content";
import type { LocaleCode } from "@astro-foundation/core";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import Section from "../../foundation/ui/Section.astro";
import Link from "../../foundation/ui/Link.astro";
import { getUiStrings } from "../../lib/i18n.ts";
import { buildPageSeo } from "../../lib/seo.ts";
import { vehicles } from "../../data/fleet.ts";
import { privateChauffeurService } from "../../data/services.ts";
import { contact } from "../../data/contact.ts";
import { operations } from "../../data/operations.ts";
import BookingWizard from "./BookingWizard.astro";

interface Props {
  routeKey: "booking";
  locale: LocaleCode;
  content: CollectionEntry<"pages">;
}

const { routeKey, locale, content } = Astro.props;
if (content.data.pageType !== "booking" || content.data.routeKey !== routeKey) {
  throw new Error("BookingPage received incompatible content.");
}
if (!content.data.h1) throw new Error(`BookingPage requires an h1 for ${locale}.`);

const data = content.data;
const copy = getUiStrings(locale);
const seo = buildPageSeo({
  routeKey,
  locale,
  title: data.seoTitle ?? data.h1,
  description: data.seoDescription ?? data.intro ?? "",
  noindex: true,
});
---

<BaseLayout seo={seo} currentRouteKey={routeKey} currentLocale={locale}>
  <div data-booking-root>
    <Section spacing="standard" aria-labelledby="booking-page-heading">
      <PageContainer>
        <div class="booking-shell">
        <div class="booking-intro">
        <h1
          id="booking-page-heading"
          class="font-heading text-[length:var(--text-h1)] font-bold leading-[var(--line-height-heading)] tracking-[var(--letter-spacing-heading)]"
        >
          {data.h1}
        </h1>
        {data.intro && (
          <p class="mt-[var(--space-4)] font-body text-[length:var(--text-xl)] leading-[var(--line-height-body)] text-[var(--color-text-muted)]">
            {data.intro}
          </p>
        )}
        </div>
        <BookingWizard
          locale={locale}
          copy={copy}
          vehicles={vehicles}
          privateOptions={privateChauffeurService.bookingOptions}
          publicMinimumHours={contact.bookingLeadTime.publicMinimumHours}
          timeZone={contact.bookingLeadTime.timeZone}
          childSeatAvailable={operations.service.childSeatOnRequest}
        />
        <div class="booking-assurance">
          <h2 class="font-heading text-[length:var(--text-h3)] font-bold leading-[var(--line-height-heading)]">
            {data.booking.assuranceTitle}
          </h2>
          <p>{data.booking.assuranceBody}</p>
        </div>
        <div class="booking-contact"><Link to="contact" locale={locale}>{copy["booking.action.contactDirectly"]}</Link></div>
        </div>
      </PageContainer>
    </Section>
  </div>
</BaseLayout>

<style>
  .booking-shell { max-inline-size: calc(var(--container-reading) - var(--space-12)); margin-inline: auto; }
  .booking-intro { max-inline-size: var(--measure-body); margin-inline: auto; margin-block-end: var(--space-8); text-align: center; }
  .booking-assurance { display: grid; gap: var(--space-3); margin-block-start: var(--space-8); padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-divider); }
  .booking-assurance h2, .booking-assurance p { margin: 0; }
  .booking-assurance p { font-family: var(--font-body); color: var(--color-text-muted); line-height: var(--line-height-body); }
  .booking-contact { margin-block-start: var(--space-3); font-family: var(--font-body); font-size: var(--text-sm); }
</style>
