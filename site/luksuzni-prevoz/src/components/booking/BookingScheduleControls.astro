---
/** Visible DD/MM/YYYY and 24-hour controls; hidden values preserve API format. */
import Field from "../../foundation/ui/Field.astro";
interface Props {
  dateName: "date" | "returnDate";
  timeName: "time" | "returnTime";
  dateLabel: string;
  timeLabel: string;
  dateFormatHint: string;
  hourFormatHint: string;
  minuteFormatHint: string;
  openCalendarLabel: string;
  required?: boolean;
  idPrefix?: string;
  nativeValidation?: boolean;
}
const { dateName, timeName, dateLabel, timeLabel, dateFormatHint, hourFormatHint, minuteFormatHint, openCalendarLabel, required = false, idPrefix = "booking", nativeValidation = false } = Astro.props;
const dateId = `${idPrefix}-${dateName}-display`;
const hours = Array.from({ length: 24 }, (_, hour) => String(hour).padStart(2, "0"));
const minutes = Array.from({ length: 60 }, (_, minute) => String(minute).padStart(2, "0"));
---

<div class="booking-schedule-controls">
  <div>
    <Field label={dateLabel} htmlFor={dateId} hint={dateFormatHint} {required}>
      <div slot="control" class="booking-schedule-controls__date">
        <input id={dateId} name={`${dateName}Display`} type="text" required={nativeValidation && required} maxlength={10} pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" inputmode="numeric" autocomplete="off" placeholder={dateFormatHint} aria-describedby={`${dateId}-hint ${dateId}-error`} data-booking-date-display data-canonical-name={dateName} class="booking-schedule-controls__input" />
        <button type="button" data-booking-calendar-button data-date-for={dateName} aria-label={`${openCalendarLabel} (${dateLabel})`} title={openCalendarLabel} hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2" /></svg>
        </button>
        <input type="date" data-booking-calendar data-date-for={dateName} tabindex="-1" aria-hidden="true" class="booking-schedule-controls__native" />
      </div>
    </Field>
    <input type="hidden" name={dateName} />
  </div>
  <fieldset>
    <legend>{timeLabel}{required && <span aria-hidden="true"> *</span>}</legend>
    <div class="booking-schedule-controls__time">
      <select required={nativeValidation && required} name={`${timeName}Hour`} data-booking-hour data-time-for={timeName} aria-label={`${timeLabel} (00–23)`}>
        <option value="">{hourFormatHint}</option>
        {hours.map((hour) => <option value={hour}>{hour}</option>)}
      </select>
      <span aria-hidden="true">:</span>
      <select required={nativeValidation && required} name={`${timeName}Minute`} data-booking-minute data-time-for={timeName} aria-label={`${timeLabel} (00–59)`}>
        <option value="">{minuteFormatHint}</option>
        {minutes.map((minute) => <option value={minute}>{minute}</option>)}
      </select>
    </div>
    <input type="hidden" name={timeName} />
  </fieldset>
</div>

<style>
  .booking-schedule-controls { display: contents; }
  fieldset { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  legend { margin-block-end: var(--space-2); font-family: var(--font-body); font-size: var(--text-ui); font-weight: var(--font-weight-medium); color: var(--color-text-on-light); }
  legend span { color: var(--color-accent); }
  .booking-schedule-controls__input, select { inline-size: 100%; min-block-size: 2.75rem; padding-inline: var(--space-3); border: 1px solid var(--color-input-border); border-radius: var(--radius-control); background: var(--color-input-surface); color: var(--color-text-on-light); font-family: var(--font-body); font-size: var(--text-ui); }
  .booking-schedule-controls__time { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-2); }
  .booking-schedule-controls__date { position: relative; }
  .booking-schedule-controls__input { min-inline-size: 0; padding-inline-end: calc(var(--space-11) + var(--space-2)); }
  button { position: absolute; inset-inline-end: 0; inset-block-start: 0; inline-size: var(--space-11); block-size: 100%; min-block-size: var(--space-11); display: grid; place-items: center; border: 0; border-radius: var(--radius-control); background: transparent; color: var(--color-text-on-light); cursor: pointer; }
  button[hidden] { display: none; }
  button:hover { background: var(--color-surface-light); }
  button svg { inline-size: var(--space-5); block-size: var(--space-5); }
  .booking-schedule-controls__native { position: absolute; inset-inline-end: 0; inset-block-start: 0; inline-size: var(--space-11); block-size: var(--space-11); opacity: 0; pointer-events: none; }
  .booking-schedule-controls__input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid var(--color-focus-light); outline-offset: 2px; }
</style>
