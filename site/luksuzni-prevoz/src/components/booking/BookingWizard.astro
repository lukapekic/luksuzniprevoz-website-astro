---
import type { LocaleCode, UiStringKey } from "@astro-foundation/core";
import type { Vehicle } from "../../data/fleet.ts";
import type { PrivateChauffeurBookingOptions } from "../../data/services.ts";
import Button from "../../foundation/ui/Button.astro";
import Checkbox from "../../foundation/ui/Checkbox.astro";
import Field from "../../foundation/ui/Field.astro";
import FormStatus from "../../foundation/ui/FormStatus.astro";
import Input from "../../foundation/ui/Input.astro";
import Link from "../../foundation/ui/Link.astro";
import Textarea from "../../foundation/ui/Textarea.astro";
import { interpolateTokens } from "../../lib/interpolate.ts";

interface Props {
  locale: LocaleCode;
  copy: Record<string, string>;
  vehicles: Vehicle[];
  privateOptions: PrivateChauffeurBookingOptions;
  publicMinimumHours: number;
  timeZone: "Europe/Belgrade";
  childSeatAvailable: boolean;
}

const { locale, copy, vehicles, privateOptions, publicMinimumHours, timeZone, childSeatAvailable } = Astro.props;
const ui = (key: UiStringKey): string => {
  const value = copy[key];
  if (!value) throw new Error(`BookingWizard missing UI key: ${key}`);
  return value;
};
const interpolate = (key: UiStringKey, values: Record<string, string | number>) =>
  interpolateTokens(ui(key), values, `BookingWizard:${key}`);

const choiceClass = "booking-choice";
const groupErrorClass = "font-body text-[length:var(--text-sm)] font-medium leading-[var(--line-height-body)] text-[var(--color-error)]";
---

<form
  class="booking-form grid gap-[var(--space-6)] lg:grid-cols-12 lg:gap-[var(--space-10)]"
  novalidate
  data-booking-wizard
  data-step="service"
  data-locale={locale}
  data-time-zone={timeZone}
  data-public-minimum-hours={publicMinimumHours}
  data-hourly-minimum-hours={privateOptions.hourly.minimumHours}
  data-not-selected={ui("booking.summary.notSelected")}
  data-price-fixed={ui("booking.price.fixed")}
  data-price-calculated={ui("booking.price.calculated")}
  data-price-estimate={ui("booking.price.estimate")}
  data-price-quote-required={ui("booking.price.quoteRequired")}
  data-price-unavailable={ui("booking.price.unavailable")}
  data-request-booking={ui("booking.action.requestBooking")}
  data-request-quote={ui("booking.action.requestQuote")}
  data-draft-recovered={ui("booking.status.draftRecovered")}
  data-error-required={ui("booking.error.required")}
  data-error-service={ui("booking.error.service")}
  data-error-date-time={ui("booking.error.dateTime")}
  data-error-lead-time={interpolate("booking.error.leadTime", { hours: publicMinimumHours })}
  data-error-hourly-minimum={interpolate("booking.error.hourlyMinimum", { hours: privateOptions.hourly.minimumHours })}
  data-error-airport-scope={ui("booking.error.airportScope")}
  data-error-return-fields={ui("booking.error.returnFields")}
  data-error-passenger-count={ui("booking.error.passengers")}
  data-error-vehicle-required={ui("booking.error.vehicleRequired")}
  data-error-vehicle-capacity={ui("booking.error.capacity")}
  data-error-email={ui("booking.error.email")}
  data-error-company={ui("booking.error.company")}
  data-error-summary-heading={ui("booking.error.summaryHeading")}
  data-quote-multi-day={ui("booking.quote.reason.multiDay")}
  data-quote-international={ui("booking.quote.reason.international")}
  data-quote-outside-airport-scope={ui("booking.quote.reason.airportScope")}
  data-quote-airport-return-policy-undefined={ui("booking.quote.reason.airportReturn")}
  data-quote-package-distance-exceeded={ui("booking.quote.reason.packageDistance")}
  data-quote-business-estimate-policy-undefined={ui("booking.quote.reason.businessPolicy")}
  data-quote-multiple-vehicles={ui("booking.quote.reason.multipleVehicles")}
  data-quote-complex-itinerary={ui("booking.quote.reason.complex")}
  data-quote-quote-only-service={ui("booking.quote.reason.quoteOnly")}
  data-quote-vehicle-recommendation={ui("booking.quote.reason.vehicleRecommendation")}
>
  <div class="booking-work lg:col-span-7 lg:p-[var(--space-10)]">
    <div class="booking-error-summary" data-error-summary hidden tabindex="-1" role="alert">
      <h2 class="font-heading text-[length:var(--text-h3)] font-bold leading-[var(--line-height-heading)]">
        {ui("booking.error.summaryHeading")}
      </h2>
      <ul class="mt-[var(--space-3)] list-disc ps-[var(--space-5)]" data-error-summary-list></ul>
    </div>

    <section data-step-panel="service" aria-labelledby="booking-service-heading">
      <h2 id="booking-service-heading" tabindex="-1" class="booking-step-heading">{ui("booking.service.heading")}</h2>
      <p class="booking-step-intro">{ui("booking.service.intro")}</p>
      <fieldset class="booking-choice-group" aria-describedby="booking-service-error">
        <legend>{ui("booking.service.legend")}</legend>
        <label class={choiceClass}>
          <input type="radio" name="serviceCategory" value="privateChauffeur" />
          <span><strong>{ui("booking.service.privateChauffeur")}</strong><small>{ui("booking.service.privateChauffeurHint")}</small></span>
        </label>
        <label class={choiceClass}>
          <input type="radio" name="serviceCategory" value="airportTransportation" />
          <span><strong>{ui("booking.service.airport")}</strong><small>{ui("booking.service.airportHint")}</small></span>
        </label>
        <label class={choiceClass}>
          <input type="radio" name="serviceCategory" value="business" />
          <span><strong>{ui("booking.service.business")}</strong><small>{ui("booking.service.businessHint")}</small></span>
        </label>
        <label class={choiceClass}>
          <input type="radio" name="serviceCategory" value="special-event" />
          <span><strong>{ui("booking.service.specialEvents")}</strong><small>{ui("booking.service.specialEventsHint")}</small></span>
        </label>
      </fieldset>
      <fieldset class="booking-choice-group" data-service-subgroup="business" hidden>
        <legend>{ui("booking.service.businessLegend")}</legend>
        <label class={choiceClass}><input type="radio" name="service" value="corporateTransportation" /><strong>{ui("booking.service.corporate")}</strong></label>
        <label class={choiceClass}><input type="radio" name="service" value="delegationTransportation" /><strong>{ui("booking.service.delegation")}</strong></label>
        <label class={choiceClass}><input type="radio" name="service" value="conferenceCongressTransportation" /><strong>{ui("booking.service.conference")}</strong></label>
      </fieldset>
      <fieldset class="booking-choice-group" data-service-subgroup="special-event" hidden>
        <legend>{ui("booking.service.specialEventsLegend")}</legend>
        <label class={choiceClass}><input type="radio" name="service" value="weddingTransportation" /><strong>{ui("booking.service.wedding")}</strong></label>
        <label class={choiceClass}><input type="radio" name="service" value="promTransportation" /><strong>{ui("booking.service.prom")}</strong></label>
        <label class={choiceClass}><input type="radio" name="service" value="vipTransportation" /><strong>{ui("booking.service.vip")}</strong></label>
        <label class={choiceClass}><input type="radio" name="service" value="specialEvents" /><strong>{ui("booking.service.otherEvent")}</strong></label>
      </fieldset>
      <p id="booking-service-error" class={groupErrorClass} data-error-for="service" hidden></p>
    </section>

    <section data-step-panel="journey" aria-labelledby="booking-journey-heading" hidden>
      <h2 id="booking-journey-heading" tabindex="-1" class="booking-step-heading">{ui("booking.journey.heading")}</h2>
      <p class="booking-step-intro">{ui("booking.journey.intro")}</p>
      <p class="booking-time-note">{interpolate("booking.timeZone.note", { timeZone })}</p>

      <div class="booking-fields md:grid-cols-2">
        <Field label={ui("booking.field.date")} htmlFor="booking-date" required>
          <Input slot="control" id="booking-date" name="date" type="date" required />
        </Field>
        <Field label={ui("booking.field.time")} htmlFor="booking-time" required>
          <Input slot="control" id="booking-time" name="time" type="time" required step={300} />
        </Field>
        <p class={`${groupErrorClass} md:col-span-2`} data-error-for="dateTime" hidden></p>
        <Field label={ui("booking.field.pickup")} htmlFor="booking-pickup" required class="md:col-span-2">
          <Input slot="control" id="booking-pickup" name="pickup" autocomplete="off" required />
        </Field>
        <p class={`${groupErrorClass} md:col-span-2`} data-error-for="pickup" hidden></p>
        <div class="md:col-span-2" data-destination-field>
          <Field label={ui("booking.field.destination")} htmlFor="booking-destination" required>
            <Input slot="control" id="booking-destination" name="destination" autocomplete="off" required />
          </Field>
          <p class={groupErrorClass} data-error-for="destination" hidden></p>
        </div>
      </div>

      <div data-journey-branch="privateChauffeur" hidden>
        <fieldset class="booking-choice-group" aria-describedby="booking-hire-mode-error">
          <legend>{ui("booking.field.hireMode")}</legend>
          <label class={choiceClass}><input type="radio" name="hireMode" value="hourly" /><strong>{ui("booking.mode.hourly")}</strong></label>
          <label class={choiceClass}><input type="radio" name="hireMode" value="halfDay" /><strong>{ui("booking.mode.halfDay")}</strong></label>
          <label class={choiceClass}><input type="radio" name="hireMode" value="fullDay" /><strong>{ui("booking.mode.fullDay")}</strong></label>
        </fieldset>
        <p id="booking-hire-mode-error" class={groupErrorClass} data-error-for="hireMode" hidden></p>
        <div class="booking-fields" data-hourly-fields hidden>
          <Field label={ui("booking.field.hours")} htmlFor="booking-hours" required>
            <Input slot="control" id="booking-hours" name="hours" type="number" min={privateOptions.hourly.minimumHours} step={1} inputmode="numeric" />
          </Field>
          <p class={groupErrorClass} data-error-for="hours" hidden></p>
        </div>
        <div class="booking-fields">
          <Field label={ui("booking.field.plannedStops")} htmlFor="booking-stops">
            <Textarea slot="control" id="booking-stops" name="plannedStops" rows={3} autocomplete="off" />
          </Field>
          <Checkbox id="booking-multi-day" name="multiDay" label={ui("booking.field.multiDay")} />
          <Checkbox id="booking-international" name="international" label={ui("booking.field.international")} />
        </div>
      </div>

      <div data-journey-branch="airportTransportation" hidden>
        <fieldset class="booking-choice-group">
          <legend>{ui("booking.field.airportDirection")}</legend>
          <label class={choiceClass}><input type="radio" name="airportDirection" value="airport-to-city" /><strong>{ui("booking.airport.arrival")}</strong></label>
          <label class={choiceClass}><input type="radio" name="airportDirection" value="city-to-airport" /><strong>{ui("booking.airport.departure")}</strong></label>
        </fieldset>
        <p class={groupErrorClass} data-error-for="airportDirection" hidden></p>
        <fieldset class="booking-choice-group" aria-describedby="booking-airport-scope-hint booking-airport-scope-error">
          <legend>{ui("booking.field.airportScope")}</legend>
          <p id="booking-airport-scope-hint" class="booking-group-hint">{ui("booking.airport.scopeHint")}</p>
          <label class={choiceClass}><input type="radio" name="airportScope" value="belgrade-city" /><strong>{ui("booking.airport.scopeBelgradeCity")}</strong></label>
          <label class={choiceClass}><input type="radio" name="airportScope" value="other" /><strong>{ui("booking.airport.scopeOther")}</strong></label>
        </fieldset>
        <p id="booking-airport-scope-error" class={groupErrorClass} data-error-for="airportScope" hidden></p>
        <div class="booking-fields">
          <Field label={ui("booking.field.flightNumber")} htmlFor="booking-flight-number">
            <Input slot="control" id="booking-flight-number" name="flightNumber" autocomplete="off" />
          </Field>
          <Checkbox id="booking-return" name="returnRequested" label={ui("booking.field.return")} />
          <div class="booking-fields md:grid-cols-2" data-return-fields hidden>
            <Field label={ui("booking.field.returnDate")} htmlFor="booking-return-date">
              <Input slot="control" id="booking-return-date" name="returnDate" type="date" />
            </Field>
            <Field label={ui("booking.field.returnTime")} htmlFor="booking-return-time">
              <Input slot="control" id="booking-return-time" name="returnTime" type="time" step={300} />
            </Field>
            <p class={`${groupErrorClass} md:col-span-2`} data-error-for="return" hidden></p>
          </div>
        </div>
      </div>

      <div data-schedule-fields hidden>
        <div class="booking-fields">
          <Field label={ui("booking.field.scheduleOutline")} htmlFor="booking-schedule" required>
            <Textarea slot="control" id="booking-schedule" name="scheduleOutline" rows={4} autocomplete="off" required />
          </Field>
          <p class={groupErrorClass} data-error-for="scheduleOutline" hidden></p>
        </div>
      </div>

      <div data-business-fields hidden>
        <div data-corporate-fields hidden>
          <fieldset class="booking-choice-group">
            <legend>{ui("booking.field.engagement")}</legend>
            <label class={choiceClass}><input type="radio" name="engagement" value="one-off" /><strong>{ui("booking.business.oneOff")}</strong></label>
            <label class={choiceClass}><input type="radio" name="engagement" value="recurring" /><strong>{ui("booking.business.recurring")}</strong></label>
          </fieldset>
          <p class={groupErrorClass} data-error-for="engagement" hidden></p>
          <Field label={ui("booking.field.invoiceReference")} htmlFor="booking-invoice-reference">
            <Input slot="control" id="booking-invoice-reference" name="invoiceReference" autocomplete="off" />
          </Field>
        </div>
        <Checkbox id="booking-multiple-locations" name="multipleLocations" label={ui("booking.field.multipleLocations")} />
      </div>

      <div data-event-fields hidden>
        <div class="booking-fields">
          <Field label={ui("booking.field.eventVenue")} htmlFor="booking-event-venue" required>
            <Input slot="control" id="booking-event-venue" name="eventVenue" autocomplete="off" required />
          </Field>
          <p class={groupErrorClass} data-error-for="eventVenue" hidden></p>
          <Checkbox id="booking-waiting" name="waitingRequested" label={ui("booking.field.waiting")} />
        </div>
      </div>

      <div data-multiple-vehicles-field hidden>
        <Checkbox id="booking-multiple-vehicles" name="multipleVehiclesRequested" label={ui("booking.field.multipleVehicles")} />
      </div>
    </section>

    <section data-step-panel="vehicle" aria-labelledby="booking-vehicle-heading" hidden>
      <h2 id="booking-vehicle-heading" tabindex="-1" class="booking-step-heading">{ui("booking.vehicle.heading")}</h2>
      <p class="booking-step-intro">{ui("booking.vehicle.intro")}</p>
      <div class="booking-fields md:grid-cols-2">
        <Field label={ui("booking.field.passengers")} htmlFor="booking-passengers" required>
          <Input slot="control" id="booking-passengers" name="passengerCount" type="number" min={1} step={1} inputmode="numeric" required />
        </Field>
        <Field label={ui("booking.field.luggage")} htmlFor="booking-luggage">
          <Input slot="control" id="booking-luggage" name="luggageCount" type="number" min={0} step={1} inputmode="numeric" />
        </Field>
        <p class={`${groupErrorClass} md:col-span-2`} data-error-for="passengerCount" hidden></p>
        {childSeatAvailable && <Checkbox id="booking-child-seat" name="childSeatRequested" label={ui("booking.field.childSeat")} class="md:col-span-2" />}
      </div>
      <fieldset class="booking-choice-group" aria-describedby="booking-vehicle-error booking-vehicle-note">
        <legend>{ui("booking.field.vehiclePreference")}</legend>
        <label class={choiceClass}>
          <input type="radio" name="vehiclePreference" value="recommend" />
          <span><strong>{ui("booking.vehicle.recommend")}</strong><small>{ui("booking.price.afterVehicleRecommendation")}</small></span>
        </label>
        {vehicles.map((vehicle) => (
          <label class={choiceClass} data-vehicle-option data-capacity={vehicle.passengers ?? ""}>
            <input type="radio" name="vehiclePreference" value={vehicle.id} />
            <span>
              <strong>{vehicle.displayName}</strong>
              <small>{vehicle.passengers === null ? ui("booking.vehicle.capacityOnReview") : interpolate("booking.vehicle.capacity", { passengers: vehicle.passengers })}</small>
              <small data-capacity-warning hidden>{ui("booking.vehicle.notEligible")}</small>
            </span>
          </label>
        ))}
      </fieldset>
      <p id="booking-vehicle-error" class={groupErrorClass} data-error-for="vehiclePreference" hidden></p>
      <p id="booking-vehicle-note" class="booking-group-hint">{ui("booking.vehicle.selectionConfirmation")}</p>
    </section>

    <section data-step-panel="review" aria-labelledby="booking-review-heading" hidden>
      <h2 id="booking-review-heading" tabindex="-1" class="booking-step-heading">{ui("booking.review.heading")}</h2>
      <p class="booking-step-intro">{ui("booking.review.intro")}</p>
      <div class="booking-review" data-booking-review>
        <dl>
          <div><dt>{ui("booking.summary.service")}</dt><dd data-review-value="service"></dd><button type="button" data-edit-step="service">{ui("booking.action.edit")}</button></div>
          <div><dt>{ui("booking.summary.schedule")}</dt><dd data-review-value="schedule"></dd><button type="button" data-edit-step="journey">{ui("booking.action.edit")}</button></div>
          <div><dt>{ui("booking.summary.journey")}</dt><dd data-review-value="journey"></dd><button type="button" data-edit-step="journey">{ui("booking.action.edit")}</button></div>
          <div><dt>{ui("booking.summary.passengers")}</dt><dd data-review-value="passengers"></dd><button type="button" data-edit-step="vehicle">{ui("booking.action.edit")}</button></div>
          <div><dt>{ui("booking.summary.vehicle")}</dt><dd data-review-value="vehicle"></dd><button type="button" data-edit-step="vehicle">{ui("booking.action.edit")}</button></div>
          <div><dt>{ui("booking.summary.price")}</dt><dd data-review-value="price"></dd><button type="button" data-edit-step="vehicle">{ui("booking.action.edit")}</button></div>
        </dl>
      </div>
      <h3 class="mt-[var(--space-10)] font-heading text-[length:var(--text-h3)] font-bold leading-[var(--line-height-heading)]">{ui("booking.contact.heading")}</h3>
      <div class="booking-fields mt-[var(--space-6)] md:grid-cols-2">
        <Field label={ui("booking.field.fullName")} htmlFor="booking-full-name" required>
          <Input slot="control" id="booking-full-name" name="fullName" autocomplete="name" required />
        </Field>
        <Field label={ui("booking.field.email")} htmlFor="booking-email" required>
          <Input slot="control" id="booking-email" name="email" type="email" autocomplete="email" required />
        </Field>
        <p class={groupErrorClass} data-error-for="fullName" hidden></p>
        <p class={groupErrorClass} data-error-for="email" hidden></p>
        <Field label={ui("booking.field.phone")} htmlFor="booking-phone">
          <Input slot="control" id="booking-phone" name="phone" type="tel" autocomplete="tel" />
        </Field>
        <div data-company-field hidden>
          <Field label={ui("booking.field.company")} htmlFor="booking-company" required>
            <Input slot="control" id="booking-company" name="company" autocomplete="organization" />
          </Field>
          <p class={groupErrorClass} data-error-for="company" hidden></p>
        </div>
        <Field label={ui("booking.field.notes")} htmlFor="booking-notes" class="md:col-span-2">
          <Textarea slot="control" id="booking-notes" name="notes" rows={4} autocomplete="off" maxlength={1000} />
        </Field>
      </div>
      <p class="booking-time-note">{ui("booking.confirmation.note")}</p>
    </section>
  </div>

  <aside class="booking-summary lg:sticky lg:top-[var(--space-8)] lg:col-span-5" aria-labelledby="booking-summary-heading" data-booking-summary>
    <h2 id="booking-summary-heading" class="font-heading text-[length:var(--text-h3)] font-bold leading-[var(--line-height-heading)]">{ui("booking.summary.heading")}</h2>
    <dl class="mt-[var(--space-6)]">
      <div><dt>{ui("booking.summary.service")}</dt><dd data-summary-value="service">{ui("booking.summary.notSelected")}</dd></div>
      <div><dt>{ui("booking.summary.schedule")}</dt><dd data-summary-value="schedule">{ui("booking.summary.notSelected")}</dd></div>
      <div><dt>{ui("booking.summary.journey")}</dt><dd data-summary-value="journey">{ui("booking.summary.notSelected")}</dd></div>
      <div><dt>{ui("booking.summary.passengers")}</dt><dd data-summary-value="passengers">{ui("booking.summary.notSelected")}</dd></div>
      <div><dt>{ui("booking.summary.vehicle")}</dt><dd data-summary-value="vehicle">{ui("booking.summary.notSelected")}</dd></div>
      <div><dt>{ui("booking.summary.price")}</dt><dd data-summary-value="price">{ui("booking.summary.notSelected")}</dd></div>
    </dl>
    <p class="mt-[var(--space-6)] text-[length:var(--text-sm)] text-[var(--color-text-muted)]">{ui("booking.price.manualConfirmation")}</p>
  </aside>

  <div class="booking-actions lg:col-span-7" data-booking-actions hidden>
    <div data-booking-back hidden><Button type="button" variant="secondary">{ui("booking.action.back")}</Button></div>
    <div data-booking-continue><Button type="button">{ui("booking.action.continue")}</Button></div>
    <div data-booking-final hidden>
      <Button type="button" disabled><span data-booking-final-label>{ui("booking.action.requestBooking")}</span></Button>
      <FormStatus id="booking-form-status" type="info" on="light" message={ui("booking.status.submissionUnavailable")} class="mt-[var(--space-3)]" />
    </div>
    <Link to="contact" locale={locale} variant="on-light">{ui("booking.action.contactDirectly")}</Link>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-booking-live></p>
  </div>

  <noscript>
    <div class="booking-noscript lg:col-span-12">
      <p>{ui("booking.status.noScript")}</p>
      <Link to="contact" locale={locale}>{ui("booking.action.contactDirectly")}</Link>
    </div>
  </noscript>
</form>

<style>
  .booking-work { min-inline-size: 0; border-radius: var(--radius-section); background: var(--color-surface-light); color: var(--color-text-on-light); padding: var(--space-6); }
  .booking-step-heading { font-family: var(--font-heading); font-size: var(--text-h2); font-weight: var(--font-weight-bold); line-height: var(--line-height-heading); }
  .booking-step-intro { max-inline-size: var(--measure-body); margin-block-start: var(--space-3); color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 30%); }
  .booking-time-note, .booking-group-hint { margin-block-start: var(--space-4); font-size: var(--text-sm); color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 30%); }
  .booking-fields { display: grid; gap: var(--space-5); margin-block-start: var(--space-7); }
  .booking-choice-group { display: grid; gap: var(--space-3); margin-block-start: var(--space-7); padding: 0; border: 0; }
  .booking-choice-group legend { margin-block-end: var(--space-2); font-weight: var(--font-weight-semibold); }
  .booking-choice { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-4); min-block-size: var(--space-11); padding: var(--space-4); border: 1px solid var(--color-input-border); border-radius: var(--radius-control); background: var(--color-input-surface); cursor: pointer; }
  .booking-choice:has(input:checked) { border-color: var(--color-focus-light); outline: 2px solid var(--color-focus-light); outline-offset: 1px; }
  .booking-choice:has(input:disabled) { cursor: not-allowed; border-color: var(--color-disabled); }
