---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Group {
  icon?: "chauffeur" | "vehicle" | "care" | "comfort";
  marker?: string;
  title: string;
  items: string[];
}

type StandardsVariant = "cards" | "divided-panel" | "editorial-list" | "numbered-matrix";

interface Props {
  heading?: string;
  intro?: string;
  groups: Group[];
  label?: string;
  variant?: StandardsVariant;
  surface?: "contained-dark" | "light";
}

const { heading, intro, groups, label, variant = "cards", surface = "contained-dark" } = Astro.props;
const onLight = surface === "light";
const isNumbered = variant === "editorial-list" || variant === "numbered-matrix";

if (
  variant === "numbered-matrix" &&
  (groups.length !== 4 || groups.some((group) => !group.marker || group.items.length !== 3))
) {
  throw new Error(
    "ServiceStandards numbered-matrix requires exactly four marked groups with three items each.",
  );
}
---

<Section spacing="compact" {surface} aria-labelledby="service-standards-heading">
  <PageContainer>
    <div class="standards-layout">
      <div class="standards-intro">
        {heading ? (
          <>
            {label && <p class:list={["section-label", onLight && "section-label--light"]}><span aria-hidden="true"></span>{label}</p>}
            <SectionHeading id="service-standards-heading" heading={heading} description={intro} on={onLight ? "light" : undefined} />
          </>
        ) : (
          <h2 id="service-standards-heading" class="standards-heading">{label}</h2>
        )}
      </div>
      <div class="standards-grid" data-variant={variant} data-surface={surface}>{groups.map((group)=><article>
        {isNumbered && group.marker && <span class="standard-marker" aria-hidden="true">{group.marker}</span>}
        <div class="standard-copy">
          {!isNumbered && group.icon && <span class="standard-icon" aria-hidden="true">
            {group.icon === "chauffeur" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3" /><path d="M6 20v-3a6 6 0 0 1 12 0v3M10 13l2 3 2-3" /></svg>}
            {group.icon === "vehicle" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 16 1.5-6h11L19 16M4 16h16v3H4zM7 19v2M17 19v2M8 13h8" /></svg>}
            {group.icon === "care" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" /></svg>}
            {group.icon === "comfort" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M8 5l4 2 4-2M8 19l4-2 4 2" /></svg>}
          </span>}
          <h3>{group.title}</h3>
          <ul>{group.items.map(item=><li>{item}</li>)}</ul>
        </div>
      </article>)}</div>
    </div>
  </PageContainer>
</Section>

<style>
  .standards-heading { max-inline-size:var(--measure-body);font-family:var(--font-heading);font-size:var(--text-h2);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading);letter-spacing:var(--letter-spacing-heading) }
  .standards-layout { display:grid; }
  .standards-intro { max-inline-size: var(--measure-body); }
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .section-label--light { color:color-mix(in oklab,var(--color-text-on-light),var(--color-surface-light) 35%) }
  .section-label--light span { background:var(--color-focus-light) }
  .standards-grid { display:grid; gap:var(--space-4); margin-block-start:var(--space-8); }
  article { padding:var(--space-5); border-radius:var(--radius-card); background:var(--color-surface-elevated); }
  .standard-copy { min-inline-size:0; }
  .standard-icon{display:grid;place-items:center;inline-size:var(--space-10);block-size:var(--space-10);border:1px solid var(--color-divider);border-radius:var(--radius-control);background:var(--color-surface);color:var(--color-accent)}
  .standard-icon svg{inline-size:var(--space-5);block-size:var(--space-5)}
  h3{margin-block-start:var(--space-4);font-family:var(--font-heading);font-size:var(--text-xl);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading)}
  ul{display:grid;gap:var(--space-3);margin-block-start:var(--space-5);padding:0;list-style:none}
  li{position:relative;padding-inline-start:var(--space-4);font-family:var(--font-body);font-size:var(--text-sm);line-height:var(--line-height-body);color:var(--color-text-muted)}
  li::before{position:absolute;inset-block-start:var(--space-3);inset-inline-start:0;inline-size:var(--space-2);block-size:1px;background:var(--color-accent);content:""}
  .standards-grid[data-variant="divided-panel"] { gap: 0; overflow: hidden; border: 1px solid var(--color-divider); border-radius: var(--radius-card); background: var(--color-surface-elevated); }
  .standards-grid[data-variant="divided-panel"] article { border-radius: 0; background: transparent; }
  .standards-grid[data-variant="divided-panel"] article + article { border-block-start: 1px solid var(--color-divider); }
  .standards-grid[data-variant="editorial-list"] { gap:0;border-block-start:1px solid var(--color-input-border); }
  .standards-grid[data-variant="editorial-list"] article { display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-5);padding:var(--space-6) 0;border-block-end:1px solid var(--color-input-border);border-radius:0;background:transparent; }
  .standards-grid[data-variant="editorial-list"] h3 { margin-block-start:0;color:var(--color-text-on-light); }
  .standards-grid[data-variant="editorial-list"] li { color:color-mix(in oklab,var(--color-text-on-light),var(--color-surface-light) 30%); }
  .standards-grid[data-variant="editorial-list"] li::before { background:var(--color-focus-light); }
  .standard-marker { min-inline-size:var(--space-8);font-family:var(--font-body);font-size:var(--text-caption);font-weight:var(--font-weight-semibold);color:var(--color-focus-light); }
  .standards-grid[data-variant="numbered-matrix"] {
    gap: 0;
    margin-block-start: var(--space-8);
    border-block-start: 1px solid var(--color-divider);
  }
  .standards-grid[data-variant="numbered-matrix"] article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: 0;
    background: transparent;
  }
  .standards-grid[data-variant="numbered-matrix"] article + article {
    border-block-start: 1px solid var(--color-divider);
  }
  .standards-grid[data-variant="numbered-matrix"] h3 {
    margin-block-start: 0;
  }
  .standards-grid[data-variant="numbered-matrix"] .standard-marker {
    color: var(--color-accent);
  }
  @media(min-width:48rem){.standards-grid[data-variant="cards"],.standards-grid[data-variant="divided-panel"]{grid-template-columns:repeat(2,minmax(0,1fr))}.standards-grid[data-variant="divided-panel"] article:nth-child(2n){border-inline-start:1px solid var(--color-divider)}.standards-grid[data-variant="divided-panel"] article:nth-child(2){border-block-start:0}}
  @media(min-width:64rem){
    .standards-layout:has(.standards-grid[data-variant="editorial-list"]),
    .standards-layout:has(.standards-grid[data-variant="numbered-matrix"]){grid-template-columns:4fr 8fr;gap:var(--column-gap-desktop);align-items:start}
    .standards-grid[data-variant="editorial-list"],
    .standards-grid[data-variant="numbered-matrix"]{margin-block-start:0}
    .standards-grid[data-variant="numbered-matrix"]{grid-template-columns:repeat(2,minmax(0,1fr));border-block-start:0}
    .standards-grid[data-variant="numbered-matrix"] article+article{border-block-start:0}
    .standards-grid[data-variant="numbered-matrix"] article:nth-child(2n){border-inline-start:1px solid var(--color-divider)}
    .standards-grid[data-variant="numbered-matrix"] article:nth-child(n+3){border-block-start:1px solid var(--color-divider)}
  }
  @media(min-width:80rem){.standards-grid[data-variant="cards"],.standards-grid[data-variant="divided-panel"]{grid-template-columns:repeat(4,minmax(0,1fr))}.standards-grid[data-variant="divided-panel"] article{border-block-start:0}.standards-grid[data-variant="divided-panel"] article+article{border-inline-start:1px solid var(--color-divider)}}
</style>
