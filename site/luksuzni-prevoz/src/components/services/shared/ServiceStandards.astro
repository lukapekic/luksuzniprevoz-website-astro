---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Group { title:string; items:string[] }
interface Props { heading?: string; intro?: string; groups: Group[]; index?:string; label?:string; variant?: "cards" | "divided-panel" }
const { heading, intro, groups, index, label, variant = "cards" } = Astro.props;
---

<Section spacing="compact" surface="contained-dark" aria-labelledby="service-standards-heading">
  <PageContainer>
    {heading && index && label && <p class="section-index"><b>{index}</b><span aria-hidden="true"></span>{label}</p>}
    {heading ? <SectionHeading id="service-standards-heading" heading={heading} description={intro} /> : <h2 id="service-standards-heading" class="standards-sr-heading">{label}</h2>}
    <div class="standards-grid" data-variant={variant}>{groups.map((group,index)=><article><span aria-hidden="true">0{index+1}</span><h3>{group.title}</h3><ul>{group.items.map(item=><li>{item}</li>)}</ul></article>)}</div>
  </PageContainer>
</Section>

<style>
  .section-index{display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);color:var(--color-text-muted)}.section-index b{color:var(--color-accent)}.section-index>span{inline-size:var(--space-10);block-size:1px;background:var(--color-accent)}
  .standards-sr-heading { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .standards-grid { display:grid; gap:var(--space-4); margin-block-start:var(--space-8); }
  article { padding:var(--space-5); border-radius:var(--radius-card); background:var(--color-surface-elevated); }
  article>span{font-family:var(--font-body);font-size:var(--text-caption);color:var(--color-accent)} h3{margin-block-start:var(--space-3);font-family:var(--font-heading);font-size:var(--text-h3)} ul{margin-block-start:var(--space-4);padding:0;list-style:none} li{padding-block:var(--space-2);font-family:var(--font-body);font-size:var(--text-sm);line-height:var(--line-height-body);color:var(--color-text-muted)}
  .standards-grid[data-variant="divided-panel"] { gap: 0; margin-block-start: 0; overflow: hidden; border-radius: var(--radius-section); background: var(--color-surface); }
  .standards-grid[data-variant="divided-panel"] article { border-radius: 0; background: transparent; }
  .standards-grid[data-variant="divided-panel"] article + article { border-block-start: 1px solid var(--color-divider); }
  @media(min-width:48rem){.standards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.standards-grid[data-variant="divided-panel"] article:nth-child(2n){border-inline-start:1px solid var(--color-divider)}.standards-grid[data-variant="divided-panel"] article:nth-child(2){border-block-start:0}}
  @media(min-width:64rem){.standards-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.standards-grid[data-variant="divided-panel"] article{border-block-start:0}.standards-grid[data-variant="divided-panel"] article+article{border-inline-start:1px solid var(--color-divider)}}
</style>
