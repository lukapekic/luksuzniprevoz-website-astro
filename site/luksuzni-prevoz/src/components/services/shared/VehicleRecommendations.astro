---
/** Service wrapper for canonical model families and the shared FleetCard. */
import type { ImageMetadata } from "astro";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import type { Vehicle } from "../../../data/fleet.ts";
import { homepageFleetMedia } from "../../../data/fleet-media.ts";
import { airportFamilyFare, fleetFamilyKey, fleetFamilyName, fleetFamilyPassengers, uniqueFleetFamilies } from "../../../data/fleet-presentation.ts";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";
import HorizontalCarousel from "../../shared/HorizontalCarousel.astro";
import FleetCard from "../../shared/FleetCard.astro";

interface VehicleRecommendation {
  vehicle: Vehicle;
  image?: ImageMetadata | null;
  displayName?: string;
  showPassengerCapacity?: boolean;
  suitability?: string;
  meta?: { label: string; value: string };
  fareScope?: "airport";
}
interface Props {
  heading: string; intro?: string; recommendations: VehicleRecommendation[];
  cta: { label: string; to: RouteKey }; locale: LocaleCode;
  passengerLabel: string; classLabels: Record<string,string>;
  ariaLabel:string; previousLabel:string; nextLabel:string; label:string;
  carouselId: string;
}
const { heading, intro, recommendations, cta, locale, passengerLabel, classLabels,
  ariaLabel, previousLabel, nextLabel, label, carouselId } = Astro.props;
const cards = uniqueFleetFamilies(recommendations).map((item) => {
  const family = fleetFamilyKey(item.vehicle.id);
  const passengers = fleetFamilyPassengers(item.vehicle);
  const fareFact = item.fareScope === "airport" ? airportFamilyFare(family) : null;
  return {
    name: fleetFamilyName(item.vehicle),
    categoryLabel: classLabels[item.vehicle.vehicleClass],
    image: homepageFleetMedia[item.vehicle.id] ?? item.image,
    passengerText: passengers !== null ? `${passengers} ${passengerLabel}` : undefined,
    fare: fareFact && item.meta ? {
      label: item.meta.label,
      value: new Intl.NumberFormat(locale, { style: "currency", currency: fareFact.currency }).format(fareFact.amount),
    } : undefined,
    suitability: item.suitability,
  };
});
---

<Section spacing="standard" surface="open-dark" aria-labelledby="vehicle-recommendations-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="vehicle-recommendations-heading" heading={heading} description={intro} />
    <div class="vehicles">
      <HorizontalCarousel id={carouselId} {ariaLabel} {previousLabel} {nextLabel} itemSize="fleet" itemCount={cards.length} showCounter>
        {cards.map((card) => (
          <li><FleetCard name={card.name} categoryLabel={card.categoryLabel} image={card.image} passengerText={card.passengerText} fare={card.fare} /></li>
        ))}
      </HorizontalCarousel>
    </div>
    {cards.some((card) => card.suitability) && <ul class="suitability" role="list">
      {cards.filter((card) => card.suitability).map((card) => <li><strong>{card.name}</strong><span>{card.suitability}</span></li>)}
    </ul>}
    <div class="vehicle-cta"><Link variant="button" to={cta.to} locale={locale}>{cta.label}</Link></div>
  </PageContainer>
</Section>

<style>
  .section-label { display: flex; align-items: center; gap: var(--space-3); margin-block-end: var(--space-5); font-family: var(--font-body); font-size: var(--text-ui); font-weight: var(--font-weight-medium); color: var(--color-text-muted); }
  .section-label span { inline-size: var(--space-8); block-size: 1px; background: var(--color-accent); }
  .vehicles { margin-block-start: var(--space-8); }
  .suitability { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin: var(--space-5) 0 0; padding: 0; list-style: none; font-family: var(--font-body); font-size: var(--text-sm); line-height: var(--line-height-body); color: var(--color-text-muted); }
  .suitability li { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .suitability strong { color: var(--color-text-primary); font-weight: var(--font-weight-semibold); }
  .vehicle-cta { margin-block-start: var(--space-8); }
</style>
