---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import type { Vehicle } from "../../../data/fleet.ts";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";
import HorizontalCarousel from "../../shared/HorizontalCarousel.astro";

interface VehicleRecommendation {
  vehicle: Vehicle;
  image?: ImageMetadata | null;
  displayName?: string;
  showPassengerCapacity?: boolean;
  suitability?: string;
  meta?: { label: string; value: string };
}
interface Props {
  heading: string; intro?: string; recommendations: VehicleRecommendation[];
  cta: { label: string; to: RouteKey }; locale: LocaleCode;
  passengerLabel: string; classLabels: Record<string,string>;
  ariaLabel:string; previousLabel:string; nextLabel:string; label:string;
  carouselId: string;
}
const { heading, intro, recommendations, cta, locale, passengerLabel, classLabels,
  ariaLabel, previousLabel, nextLabel, label, carouselId } = Astro.props;
---

<Section spacing="standard" surface="open-dark" aria-labelledby="vehicle-recommendations-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="vehicle-recommendations-heading" heading={heading} description={intro} />
    <HorizontalCarousel id={carouselId} {ariaLabel} {previousLabel} {nextLabel} itemSize="compact" itemCount={recommendations.length} class="vehicles" showCounter>
      {recommendations.map(({ vehicle, image, displayName, showPassengerCapacity = true, suitability, meta }) => (
        <li><article class="vehicle">
          <div class="vehicle__media" aria-hidden="true">
            {image ? (
              <Image
                class="vehicle__image"
                src={image}
                alt=""
                role="presentation"
                loading="lazy"
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 26rem, 82vw"
              />
            ) : <span class="vehicle__placeholder"></span>}
          </div>
          <div class="vehicle__scrim" aria-hidden="true"></div>
          <div class="vehicle__copy">
            <h3>{displayName ?? vehicle.displayName}</h3>
            <p>{classLabels[vehicle.vehicleClass]}</p>
            {suitability && <p class="vehicle__suitability">{suitability}</p>}
            {(showPassengerCapacity && vehicle.passengers !== null || meta) && <div class="vehicle__meta">
              {showPassengerCapacity && vehicle.passengers !== null && <span>{vehicle.passengers} {passengerLabel}</span>}
              {meta && <span><small>{meta.label}</small>{meta.value}</span>}
            </div>}
          </div>
        </article></li>
      ))}
    </HorizontalCarousel>
    <div class="vehicle-cta"><Link variant="button" to={cta.to} locale={locale}>{cta.label}</Link></div>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label span{inline-size:var(--space-8);block-size:1px;background:var(--color-accent)}
  .vehicles { margin-block-start: var(--space-8); }
  .vehicle { position: relative; display: grid; min-block-size: calc(var(--space-24) * 5); align-items: end; overflow: hidden; border-radius: var(--radius-card); background: var(--color-surface); isolation: isolate; }
  .vehicle__media { position: absolute; inset: 0; z-index: 0; background: var(--color-surface-elevated); }
  .vehicle__image { inline-size:100%;block-size:100%;object-fit:cover;object-position:center;filter:brightness(.66) contrast(1.08) saturate(.68);transition:filter var(--duration-normal) var(--ease-standard) }
  li[data-carousel-active] .vehicle__image { filter:brightness(.8) contrast(1.08) saturate(.76) }
  .vehicle__placeholder { display:block;inline-size:100%;block-size:100%;background:linear-gradient(145deg,var(--color-surface-elevated),var(--color-background)) }
  .vehicle__scrim { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg,color-mix(in oklab,var(--color-background),transparent 78%) 0%,color-mix(in oklab,var(--color-background),transparent 62%) 34%,color-mix(in oklab,var(--color-background),transparent 10%) 78%,var(--color-background) 100%); }
  .vehicle__copy { position:relative;z-index:2;display: grid; gap: var(--space-2); padding: var(--space-6); }
  h3 { font-family: var(--font-heading); font-size: var(--text-h3); font-weight: var(--font-weight-semibold); }
  p { font-family: var(--font-body); color: var(--color-text-muted); }
  .vehicle__suitability { max-inline-size: var(--measure-narrow); font-size: var(--text-sm); line-height: var(--line-height-body); }
  .vehicle__meta { display: flex; align-items: end; justify-content: space-between; gap: var(--space-3); padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-divider); font-family: var(--font-body); font-size: var(--text-sm); color: var(--color-text-primary); }
  .vehicle__meta small { display: block; color: var(--color-text-muted); }
  .vehicle-cta { margin-block-start: var(--space-8); }
  @media(prefers-reduced-motion:reduce){.vehicle__image{transition:none}}
</style>
