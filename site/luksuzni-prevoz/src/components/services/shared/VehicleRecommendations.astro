---
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import type { Vehicle } from "../../../data/fleet.ts";
import type { VehiclePricing } from "../../../data/pricing.ts";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";
import HorizontalCarousel from "../../shared/HorizontalCarousel.astro";

interface VehicleRecommendation { vehicle: Vehicle; pricing: VehiclePricing }
interface Props {
  heading: string; intro?: string; recommendations: VehicleRecommendation[];
  cta: { label: string; to: RouteKey }; locale: LocaleCode;
  passengerLabel: string; classLabels: Record<string,string>;
  fareLabel: string; farePendingLabel: string;
  ariaLabel:string; previousLabel:string; nextLabel:string; index:string; label:string;
}
const { heading, intro, recommendations, cta, locale, passengerLabel, classLabels,
  fareLabel, farePendingLabel, ariaLabel, previousLabel, nextLabel, index, label } = Astro.props;

const formatFare = (pricing: VehiclePricing) => pricing.airportTransfer
  ? new Intl.NumberFormat(locale, { style: "currency", currency: pricing.airportTransfer.currency }).format(pricing.airportTransfer.amount)
  : farePendingLabel;
---

<Section spacing="standard" surface="open-dark" aria-labelledby="vehicle-recommendations-heading">
  <PageContainer>
    <p class="section-index"><b>{index}</b><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="vehicle-recommendations-heading" heading={heading} description={intro} />
    <HorizontalCarousel id="airport-vehicles" {ariaLabel} {previousLabel} {nextLabel} itemSize="compact" class="vehicles">
      {recommendations.map(({ vehicle, pricing }, index) => (
        <li><article class="vehicle">
          <div class:list={["vehicle__media", `vehicle__media--${(index % 3) + 1}`]} aria-hidden="true"></div>
          <div class="vehicle__scrim" aria-hidden="true"></div>
          <div class="vehicle__copy">
            <h3>{vehicle.displayName}</h3>
            <p>{classLabels[vehicle.vehicleClass]}</p>
            <div class="vehicle__meta">
              {vehicle.passengers !== null && <span>{vehicle.passengers} {passengerLabel}</span>}
              <span><small>{fareLabel}</small>{formatFare(pricing)}</span>
            </div>
          </div>
        </article></li>
      ))}
    </HorizontalCarousel>
    <div class="vehicle-cta"><Link variant="button" to={cta.to} locale={locale}>{cta.label}</Link></div>
  </PageContainer>
</Section>

<style>
  .section-index { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);color:var(--color-text-muted) }
  .section-index b{color:var(--color-accent)} .section-index span{inline-size:var(--space-10);block-size:1px;background:var(--color-accent)}
  .vehicles { margin-block-start: var(--space-8); }
  .vehicle { position: relative; display: grid; min-block-size: calc(var(--space-24) * 5); align-items: end; overflow: hidden; border-radius: var(--radius-card); background: var(--color-surface); isolation: isolate; }
  .vehicle__media { position: absolute; inset: 0; z-index: -3; background: linear-gradient(145deg, var(--color-surface-elevated), var(--color-background)); }
  .vehicle__media--2 { background: linear-gradient(160deg, var(--color-surface), var(--color-surface-elevated)); }
  .vehicle__media--3 { background: linear-gradient(180deg, var(--color-background), var(--color-surface)); }
  .vehicle__scrim { position: absolute; inset: 0; z-index: -2; background: linear-gradient(to top, var(--color-background), transparent); }
  .vehicle__copy { display: grid; gap: var(--space-2); padding: var(--space-5); }
  h3 { font-family: var(--font-heading); font-size: var(--text-h3); font-weight: var(--font-weight-semibold); }
  p { font-family: var(--font-body); color: var(--color-text-muted); }
  .vehicle__meta { display: flex; align-items: end; justify-content: space-between; gap: var(--space-3); padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-divider); font-family: var(--font-body); font-size: var(--text-sm); color: var(--color-text-primary); }
  .vehicle__meta small { display: block; color: var(--color-text-muted); }
  .vehicle-cta { margin-block-start: var(--space-8); }
</style>
