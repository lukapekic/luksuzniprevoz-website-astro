---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Group { key: string; icon: "transfer" | "arrival" | "assistance" | "aviation"; title: string; text: string }
interface Props { heading: string; intro?: string; body: string; groups: Group[]; index: string; label: string; variant?: "divider-facts" | "grouped-icons"; surface?: "open-dark" | "contained-dark" }
const { heading, intro, body, groups, index, label, variant = "grouped-icons", surface = "contained-dark" } = Astro.props;
---

<Section spacing={surface === "open-dark" ? "standard" : "compact"} surface={surface} aria-labelledby="service-overview-heading">
  <PageContainer class="overview-grid">
    <div>
      <p class="section-index"><b>{index}</b><span aria-hidden="true"></span>{label}</p>
      <SectionHeading id="service-overview-heading" heading={heading} description={intro} accent />
      <p class="overview-body">{body}</p>
    </div>
    <ul class="fact-list" role="list" data-variant={variant}>
      {groups.map((group) => <li>
        <span class="fact-icon" data-icon={group.icon} aria-hidden="true"></span>
        <span><strong>{group.title}</strong><small>{group.text}</small></span>
      </li>)}
    </ul>
  </PageContainer>
</Section>

<style>
  .overview-grid { display: grid; gap: var(--space-10); }
  .section-index { display:flex; align-items:center; gap:var(--space-3); margin-block-end:var(--space-5); font-family:var(--font-body); font-size:var(--text-ui); color:var(--color-text-muted); }
  .section-index b { color:var(--color-accent); } .section-index > span { inline-size:var(--space-10); block-size:1px; background:var(--color-accent); }
  .overview-body { max-inline-size: var(--measure-body); margin-block-start: var(--space-5); font-family: var(--font-body); line-height: var(--line-height-body); color: var(--color-text-muted); }
  .fact-list { display:grid; margin: 0; padding: 0; list-style: none; border-block-start: 1px solid var(--color-divider); }
  .fact-list li { display:grid; grid-template-columns:auto 1fr; gap:var(--space-4); padding-block: var(--space-5); border-block-end: 1px solid var(--color-divider); font-family: var(--font-body); }
  .fact-list strong,.fact-list small { display:block; } .fact-list strong { font-weight:var(--font-weight-semibold); } .fact-list small { margin-block-start:var(--space-2); font-size:var(--text-sm); line-height:var(--line-height-body); color:var(--color-text-muted); }
  .fact-icon { inline-size:var(--space-8); block-size:var(--space-8); border:1px solid var(--color-border-subtle); border-radius:var(--radius-control); }
  .fact-icon::before { content:""; display:block; inline-size:var(--space-3); block-size:var(--space-3); margin:calc((var(--space-8) - var(--space-3) - 2px)/2); border:1px solid var(--color-accent); border-radius:50%; }
  @media (min-width:48rem) { .fact-list { grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--space-6); } }
  @media (min-width: 64rem) { .overview-grid { grid-template-columns: 5fr 7fr; gap: var(--column-gap-desktop); align-items: start; } }
</style>
