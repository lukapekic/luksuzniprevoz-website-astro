---
import type { ImageMetadata } from "astro";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import ServiceCard from "../../shared/ServiceCard.astro";

interface Item {
  routeKey: RouteKey;
  title: string;
  text?: string;
  ctaLabel: string;
  image?: ImageMetadata | null;
  imageAlt?: string;
}

interface Props {
  heading: string;
  intro?: string;
  items: Item[];
  locale: LocaleCode;
  label?: string;
}

const { heading, intro, items, locale, label } = Astro.props;
if (items.length !== 3) throw new Error(`HubServiceSelector requires exactly three children; received ${items.length}.`);
---

<Section spacing="standard" surface="open-dark" aria-labelledby="hub-service-selector-heading">
  <PageContainer>
    <div class="selector-heading">
      {label && <p class="section-label"><span aria-hidden="true"></span>{label}</p>}
      <SectionHeading id="hub-service-selector-heading" heading={heading} description={intro} />
    </div>
    <div class="selector-grid">
      {items.map((item) => (
        <ServiceCard
          title={item.title}
          description={item.text ?? ""}
          image={item.image ?? undefined}
          imageAlt={item.imageAlt ?? ""}
          action={{ label: item.ctaLabel, to: item.routeKey }}
          locale={locale}
        />
      ))}
    </div>
  </PageContainer>
</Section>

<style>
  .selector-heading { max-inline-size: var(--measure-body); }
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .selector-grid { display:grid;gap:var(--space-5);margin-block-start:var(--space-8) }
  @media(min-width:64rem){.selector-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-6)}}
</style>
