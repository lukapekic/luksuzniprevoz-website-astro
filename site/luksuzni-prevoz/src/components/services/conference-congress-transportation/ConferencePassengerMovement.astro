---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface MovementItem {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  intro: string;
  body: string;
  label: string;
  items: readonly [MovementItem, MovementItem];
  sharedScheduleLabel: string;
  executiveVehicleLabel: string;
  groupVehicleLabel: string;
  executiveImage: ImageMetadata;
  groupImage: ImageMetadata;
}

const {
  heading,
  intro,
  body,
  label,
  items,
  sharedScheduleLabel,
  executiveVehicleLabel,
  groupVehicleLabel,
  executiveImage,
  groupImage,
} = Astro.props;

const roles = [
  { item: items[0], vehicleLabel: executiveVehicleLabel, image: executiveImage },
  { item: items[1], vehicleLabel: groupVehicleLabel, image: groupImage },
] as const;
---

<Section spacing="feature" surface="light" aria-labelledby="conference-passenger-movement-heading">
  <PageContainer>
    <div class="passenger-intro">
      <p class="section-label"><span aria-hidden="true"></span>{label}</p>
      <SectionHeading
        id="conference-passenger-movement-heading"
        heading={heading}
        description={intro}
        on="light"
      />
      <p class="body-copy">{body}</p>
    </div>

    <p class="schedule-context"><span>{sharedScheduleLabel}</span></p>

    <ol class="role-grid" aria-label={heading}>
      {roles.map((role, index) => (
        <li>
          <div class="role-copy">
            <span class="role-marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{role.item.title}</h3>
            <p>{role.item.text}</p>
            <strong>{role.vehicleLabel}</strong>
          </div>
          <figure>
            <Image
              src={role.image}
              alt=""
              role="presentation"
              loading="lazy"
              widths={[400, 640, 800, 1000]}
              sizes="(min-width: 80rem) 36rem, (min-width: 48rem) 46vw, calc(100vw - 3rem)"
            />
          </figure>
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .passenger-intro {
    max-inline-size: var(--measure-body);
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 35%);
  }

  .section-label span {
    flex: 0 0 auto;
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-focus-light);
  }

  .body-copy {
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 30%);
  }

  .schedule-context {
    display: grid;
    grid-template-columns: minmax(var(--space-8), 1fr) auto minmax(var(--space-8), 1fr);
    gap: var(--space-4);
    align-items: center;
    margin: var(--space-10) 0 var(--space-7);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-ui);
    color: var(--color-text-on-light);
    text-align: center;
    text-transform: uppercase;
  }

  .schedule-context::before,
  .schedule-context::after {
    block-size: 1px;
    background: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 75%);
    content: "";
  }

  .schedule-context span {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .role-grid {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role-grid > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-inline-size: 0;
    padding-block-start: var(--space-6);
    border-block-start: 1px solid
      color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 75%);
  }

  .role-copy {
    min-inline-size: 0;
    padding-block-end: var(--space-6);
    overflow-wrap: anywhere;
  }

  .role-marker {
    display: block;
    margin-block-end: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-focus-light);
  }

  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    color: var(--color-text-on-light);
    text-wrap: balance;
  }

  .role-copy p {
    margin: var(--space-4) 0 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 30%);
  }

  .role-copy strong {
    display: block;
    margin-block-start: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-ui);
    color: var(--color-text-on-light);
    text-transform: uppercase;
  }

  figure {
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: clip;
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 90%);
  }

  figure :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .role-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--column-gap-desktop);
    }

    .role-grid > li:nth-child(2) {
      padding-inline-start: var(--column-gap-desktop);
      border-inline-start: 1px solid
        color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 75%);
    }
  }
</style>
