---
import type { LocaleCode } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";

interface ScheduleItem {
  title: string;
  text: string;
}

interface Role {
  label: string;
  vehicleLabel: string;
}

interface Props {
  heading: string;
  intro: string;
  label: string;
  items: readonly [ScheduleItem, ScheduleItem, ScheduleItem];
  roles: readonly [Role, Role, Role];
  outcomeLabel: string;
  action: { label: string; href: string };
  locale: LocaleCode;
}

const { heading, intro, label, items, roles, outcomeLabel, action, locale } = Astro.props;
---

<Section spacing="feature" surface="open-dark" aria-labelledby="conference-multi-vehicle-heading">
  <PageContainer>
    <div class="schedule-layout">
      <div class="section-copy">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading
          id="conference-multi-vehicle-heading"
          heading={heading}
          description={intro}
        />
        <Link href={action.href} {locale}>{action.label}</Link>
      </div>

      <div class="role-model">
        <ol class="role-nodes" aria-label={heading}>
          {items.map((item, index) => (
            <li>
              <span class="node-marker" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="lane-copy">
                <h3>{roles[index]?.label ?? item.title}</h3>
                <strong>{roles[index]?.vehicleLabel}</strong>
                <p>{item.text}</p>
              </span>
            </li>
          ))}
        </ol>
        <p class="schedule-outcome"><span>{outcomeLabel}</span></p>
      </div>
    </div>
  </PageContainer>
</Section>

<style>
  .schedule-layout {
    display: grid;
    gap: var(--space-10);
  }

  .schedule-layout > *,
  .section-copy,
  .role-model,
  .role-nodes > li {
    min-inline-size: 0;
  }

  .section-copy {
    overflow-wrap: anywhere;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    flex: 0 0 auto;
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .section-copy :global(a) {
    margin-block-start: var(--space-6);
  }

  .role-nodes {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-divider);
    list-style: none;
  }

  .role-nodes::before {
    position: absolute;
    inset-block: calc(var(--space-12) + 1px);
    inset-inline-start: var(--space-8);
    inline-size: 1px;
    background: var(--color-accent);
    content: "";
  }

  .role-nodes > li {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr);
    gap: var(--space-5);
    min-block-size: var(--space-24);
    align-items: center;
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--color-divider);
    overflow-wrap: anywhere;
  }

  .role-nodes > li::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--space-8);
    inline-size: var(--space-7);
    block-size: 1px;
    background: var(--color-accent);
    content: "";
  }

  .node-marker {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    text-wrap: balance;
  }

  .role-nodes strong {
    display: block;
    margin-block-start: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-ui);
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .role-nodes p {
    margin: var(--space-4) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .schedule-outcome {
    position: relative;
    display: grid;
    min-block-size: var(--space-24);
    place-items: center;
    margin: var(--space-8) 0 0;
    padding: var(--space-6) 0;
    border-block: 1px solid var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-text-primary);
    text-align: center;
  }

  .schedule-outcome::before {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-start: var(--space-8);
    inline-size: 1px;
    block-size: var(--space-8);
    background: var(--color-accent);
    content: "";
  }

  .schedule-outcome span {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 64rem) {
    .schedule-layout {
      grid-template-columns: 5fr 7fr;
      gap: var(--column-gap-desktop);
      align-items: start;
    }

    .role-nodes {
      position: relative;
    }

    .role-model {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(var(--space-24), 3fr);
      gap: var(--space-10);
      align-items: stretch;
    }

    .role-nodes::after {
      position: absolute;
      inset-block: calc(var(--space-12) + 1px);
      inset-inline-end: calc(var(--space-5) * -1);
      inline-size: 1px;
      background: var(--color-accent);
      content: "";
    }

    .role-nodes::before {
      content: none;
    }

    .role-nodes > li::after {
      inset-inline-start: auto;
      inset-inline-end: calc(var(--space-5) * -1);
      inline-size: var(--space-5);
    }

    .schedule-outcome {
      align-self: stretch;
      margin: 0;
      padding-inline: var(--space-5);
      border-block: 0;
      border-inline-start: 1px solid var(--color-accent);
      text-align: start;
    }

    .schedule-outcome::before {
      inset-block-start: 50%;
      inset-block-end: auto;
      inset-inline-start: calc(var(--space-10) * -1);
      inline-size: var(--space-10);
      block-size: 1px;
    }
  }
</style>
