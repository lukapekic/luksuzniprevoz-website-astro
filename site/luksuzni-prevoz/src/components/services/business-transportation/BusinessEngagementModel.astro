---
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";

interface Item { title: string; text: string }
interface Props {
  heading: string;
  intro?: string;
  body?: string;
  label: string;
  items: readonly [Item, Item];
  cta: { label: string; to: RouteKey };
  locale: LocaleCode;
}

const { heading, intro, body, label, items, cta, locale } = Astro.props;
---

<Section spacing="compact" surface="contained-dark" aria-labelledby="business-engagement-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <div class="engagement-intro">
      <SectionHeading id="business-engagement-heading" {heading} description={intro} />
      {body && <p>{body}</p>}
    </div>
    <ol class="engagement-grid grid md:grid-cols-2">
      {items.map((item, index) => (
        <li class="md:border-b-0 md:p-[var(--space-8)] md:first:border-e md:first:border-[var(--color-divider)] md:first:ps-0 md:last:pe-0">
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          {index === 1 && <Link variant="default" to={cta.to} {locale}>{cta.label}<span aria-hidden="true">→</span></Link>}
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .engagement-intro { max-inline-size:var(--measure-body) }
  .engagement-intro > p { margin-block-start:var(--space-5);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
  .engagement-grid { margin-block-start:var(--space-8);padding:0;border-block-start:1px solid var(--color-divider);list-style:none }
  .engagement-grid li { display:flex;min-inline-size:0;flex-direction:column;align-items:flex-start;padding-block:var(--space-7);border-block-end:1px solid var(--color-divider) }
  .engagement-grid li > span { font-family:var(--font-body);font-size:var(--text-caption);font-weight:var(--font-weight-semibold);color:var(--color-accent) }
  h3 { margin-block-start:var(--space-3);font-family:var(--font-heading);font-size:var(--text-h3);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading) }
  li > p { margin-block:var(--space-4);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
</style>
