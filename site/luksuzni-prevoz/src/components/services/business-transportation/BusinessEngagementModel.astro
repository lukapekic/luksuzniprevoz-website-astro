---
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";
import BusinessDividedPanel from "./BusinessDividedPanel.astro";

interface Item { title: string; text: string }
interface Props {
  heading: string;
  intro?: string;
  body?: string;
  label: string;
  items: readonly [Item, Item];
  cta: { label: string; to: RouteKey };
  locale: LocaleCode;
}

const { heading, intro, body, label, items, cta, locale } = Astro.props;
---

<Section spacing="compact" surface="contained-dark" aria-labelledby="business-engagement-heading">
  <PageContainer>
    <div class="engagement-layout">
      <div class="engagement-copy">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="business-engagement-heading" {heading} description={intro} />
        {body && <p class="body-copy">{body}</p>}
        <div class="engagement-action">
          <Link variant="default" to={cta.to} {locale}>
            {cta.label}<span aria-hidden="true">→</span>
          </Link>
        </div>
      </div>
      <div class="engagement-panel">
        <BusinessDividedPanel {items} layout="stacked" />
      </div>
    </div>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .engagement-layout { display:grid;gap:var(--space-8);align-items:start }
  .engagement-copy,.engagement-panel { min-inline-size:0 }
  .body-copy { max-inline-size:var(--measure-body);margin-block-start:var(--space-5);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
  .engagement-action { margin-block-start:var(--space-6) }

  @media (min-width:64rem) {
    .engagement-layout { grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--column-gap-desktop) }
    .engagement-copy { grid-column:span 5 }
    .engagement-panel { grid-column:span 7 }
  }
</style>
