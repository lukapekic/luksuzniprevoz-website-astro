---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface TimelineItem { title: string; text: string }
interface Props {
  heading: string;
  intro?: string;
  body?: string;
  label: string;
  items: readonly TimelineItem[];
}

const { heading, intro, body, label, items } = Astro.props;
---

<Section spacing="feature" surface="open-dark" aria-labelledby="business-coordination-heading">
  <PageContainer>
    <div class="grid gap-[var(--space-10)] lg:grid-cols-12 lg:items-stretch">
      <div class="lg:col-span-7">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="business-coordination-heading" {heading} description={intro} />
        {body && <p class="body-copy">{body}</p>}
        <ol class="timeline">
          {items.map((item) => (
            <li>
              <time>{item.title}</time>
              <span>{item.text}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="coordination-media lg:col-span-5" aria-hidden="true">
        <span aria-hidden="true"></span>
      </div>
    </div>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .body-copy { max-inline-size:var(--measure-body);margin-block-start:var(--space-5);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
  .timeline { display:grid;margin:var(--space-8) 0 0;padding:0;border-block-start:1px solid var(--color-divider);list-style:none }
  .timeline li { display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-5);padding-block:var(--space-4);border-block-end:1px solid var(--color-divider);font-family:var(--font-body);line-height:var(--line-height-body) }
  .timeline time { min-inline-size:var(--space-16);font-weight:var(--font-weight-semibold);color:var(--color-accent) }
  .timeline span { color:var(--color-text-primary) }
  .coordination-media { position:relative;min-block-size:calc(var(--space-24) * 4);overflow:hidden;border-radius:var(--radius-section);background:linear-gradient(145deg,var(--color-surface-elevated),var(--color-surface));isolation:isolate }
  .coordination-media::before,.coordination-media::after { position:absolute;inset-inline:var(--space-8);block-size:1px;background:color-mix(in oklab,var(--color-accent),transparent 72%);content:"" }
  .coordination-media::before { inset-block-start:34%;transform:rotate(-8deg) }
  .coordination-media::after { inset-block-start:66%;transform:rotate(6deg) }
  .coordination-media span { position:absolute;inset-block-start:50%;inset-inline-start:50%;inline-size:var(--space-16);block-size:var(--space-16);border:1px solid var(--color-border-subtle);border-radius:var(--radius-full);transform:translate(-50%,-50%) }
</style>
