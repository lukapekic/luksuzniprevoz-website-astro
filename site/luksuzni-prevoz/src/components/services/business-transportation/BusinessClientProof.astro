---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface ApprovedClient { id: string; displayName: string; logoAsset: ImageMetadata }
interface Props { heading: string; intro?: string; label: string; clients: readonly ApprovedClient[] }
const { heading, intro, label, clients } = Astro.props;
---

{clients.length > 0 && (
  <Section spacing="compact" surface="open-dark" aria-labelledby="business-clients-heading">
    <PageContainer>
      <p class="section-label"><span aria-hidden="true"></span>{label}</p>
      <SectionHeading id="business-clients-heading" {heading} description={intro} />
      <ul class="client-grid grid grid-cols-2 gap-[var(--space-3)] lg:grid-cols-4" role="list">
        {clients.map((client) => (
          <li>
            <Image
              src={client.logoAsset}
              alt={client.displayName}
              loading="lazy"
              decoding="async"
              widths={[320, 480, 640]}
              sizes="(min-width: 64rem) 18rem, 44vw"
              format="webp"
              quality={80}
            />
          </li>
        ))}
      </ul>
    </PageContainer>
  </Section>
)}

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .client-grid { margin-block-start:var(--space-8);padding:0;list-style:none }
  .client-grid li { display:grid;min-block-size:calc(var(--space-24) + var(--space-8));place-items:center;overflow:hidden;border-radius:var(--radius-card);background:var(--color-surface-light) }
  .client-grid :global(img) { inline-size:100%;block-size:100%;object-fit:contain;filter:grayscale(1) contrast(1.65) brightness(1.12) }
</style>
