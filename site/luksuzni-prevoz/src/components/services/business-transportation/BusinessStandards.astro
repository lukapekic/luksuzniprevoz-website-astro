---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Standard { title: string; text: string }
interface Props { heading: string; intro?: string; body?: string; label: string; items: readonly Standard[] }
const { heading, intro, body, label, items } = Astro.props;
---

<Section spacing="standard" surface="contained-dark" aria-labelledby="business-standards-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <div class="standards-intro">
      <SectionHeading id="business-standards-heading" {heading} description={intro} />
      {body && <p>{body}</p>}
    </div>
    <ol class="standards-grid grid md:grid-cols-2 lg:grid-cols-3">
      {items.map((item, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .standards-intro { max-inline-size:var(--measure-body) }
  .standards-intro > p { margin-block-start:var(--space-5);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
  .standards-grid { margin-block-start:var(--space-8);padding:0;border-block-start:1px solid var(--color-divider);list-style:none }
  .standards-grid li { min-inline-size:0;padding:var(--space-6);border-block-end:1px solid var(--color-divider) }
  .standards-grid li > span { font-family:var(--font-body);font-size:var(--text-caption);font-weight:var(--font-weight-semibold);color:var(--color-accent) }
  h3 { margin-block-start:var(--space-3);font-family:var(--font-heading);font-size:var(--text-h3);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading) }
  li > p { margin-block-start:var(--space-3);font-family:var(--font-body);font-size:var(--text-sm);line-height:var(--line-height-body);color:var(--color-text-muted) }
</style>
