---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import BusinessDividedPanel from "./BusinessDividedPanel.astro";

interface Step { title: string; text: string }
interface Props { heading: string; intro?: string; label: string; steps: readonly [Step, Step, Step] }
const { heading, intro, label, steps } = Astro.props;
---

<Section spacing="compact" surface="open-dark" aria-labelledby="business-process-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="business-process-heading" {heading} description={intro} />
    <div class="process-panel">
      <BusinessDividedPanel items={steps} layout="three-columns" />
    </div>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .process-panel { margin-block-start:var(--space-8) }
</style>
