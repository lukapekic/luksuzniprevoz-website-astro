---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Step { title: string; text: string }
interface Props { heading: string; intro?: string; label: string; steps: readonly [Step, Step, Step] }
const { heading, intro, label, steps } = Astro.props;
---

<Section spacing="compact" surface="open-dark" aria-labelledby="business-process-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="business-process-heading" {heading} description={intro} />
    <ol class="process-grid grid lg:grid-cols-3">
      {steps.map((step, index) => (
        <li class="lg:border-b-0 lg:p-[var(--space-7)] lg:first:ps-0 lg:last:pe-0 lg:[&:not(:last-child)]:border-e lg:[&:not(:last-child)]:border-[var(--color-divider)]">
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .process-grid { margin-block-start:var(--space-8);padding:0;border-block-start:1px solid var(--color-divider);list-style:none }
  .process-grid li { min-inline-size:0;padding-block:var(--space-6);border-block-end:1px solid var(--color-divider) }
  .process-grid li > span { font-family:var(--font-body);font-size:var(--text-caption);font-weight:var(--font-weight-semibold);color:var(--color-accent) }
  h3 { margin-block-start:var(--space-3);font-family:var(--font-heading);font-size:var(--text-h3);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading) }
  li > p { margin-block-start:var(--space-3);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
</style>
