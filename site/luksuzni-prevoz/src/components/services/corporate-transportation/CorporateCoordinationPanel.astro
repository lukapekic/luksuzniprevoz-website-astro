---
import type { LocaleCode } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";

interface Node {
  title: string;
  text: string;
}

interface Action {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  intro: string;
  body: string;
  label: string;
  nodes: readonly [Node, Node, Node];
  destination: string;
  action: Action;
  locale: LocaleCode;
}

const { heading, intro, body, label, nodes, destination, action, locale } = Astro.props;
---

<Section spacing="compact" surface="elevated" aria-labelledby="corporate-coordination-heading">
  <PageContainer>
    <div class="coordination-layout grid gap-[var(--space-10)] lg:grid-cols-12 lg:gap-[var(--column-gap-desktop)]">
      <div class="coordination-copy lg:col-span-5">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading
          id="corporate-coordination-heading"
          {heading}
          description={intro}
        />
        <p class="body-copy">{body}</p>
        <Link href={action.href} {locale}>{action.label}</Link>
      </div>

      <div class="coordination-model lg:col-span-7">
        <ul class="coordination-nodes grid gap-0 lg:grid-cols-3" role="list">
          {nodes.map((node) => (
            <li>
              <span class="node-rule" aria-hidden="true"></span>
              <h3>{node.title}</h3>
              <p>{node.text}</p>
            </li>
          ))}
        </ul>
        <div class="coordination-destination">
          <span aria-hidden="true"></span>
          <p>{destination}</p>
        </div>
      </div>
    </div>
  </PageContainer>
</Section>

<style>
  .coordination-copy,
  .coordination-model {
    min-inline-size: 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label > span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .body-copy {
    max-inline-size: var(--measure-body);
    margin-block: var(--space-5) var(--space-6);
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .coordination-model {
    align-self: center;
  }

  .coordination-nodes {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-divider);
    list-style: none;
  }

  .coordination-nodes li {
    position: relative;
    min-inline-size: 0;
    padding: var(--space-6) var(--space-5);
    border-block-end: 1px solid var(--color-divider);
  }

  .node-rule {
    display: block;
    inline-size: var(--space-8);
    block-size: 1px;
    margin-block-end: var(--space-4);
    background: var(--color-accent);
  }

  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    text-wrap: balance;
  }

  .coordination-nodes p {
    margin-block: var(--space-3) 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .coordination-destination {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: var(--space-20);
    margin-block-start: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    text-align: center;
  }

  .coordination-destination > span {
    position: absolute;
    inset-block-start: calc(-1 * var(--space-6));
    inset-inline-start: 50%;
    inline-size: 1px;
    block-size: var(--space-6);
    background: var(--color-accent);
  }

  .coordination-destination p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  @media (min-width: 64rem) {
    .coordination-nodes li + li {
      border-inline-start: 1px solid var(--color-divider);
    }
  }
</style>
