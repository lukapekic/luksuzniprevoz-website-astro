---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { LocaleCode } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";

interface Action {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  intro?: string;
  body: string;
  label: string;
  action: Action;
  locale: LocaleCode;
  image: ImageMetadata;
}

const { heading, intro, body, label, action, locale, image } = Astro.props;
---

<Section spacing="feature" surface="open-dark" aria-labelledby="prom-presentation-heading">
  <PageContainer>
    <div class="presentation-layout">
      <div class="presentation-content">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="prom-presentation-heading" {heading} description={intro} />
        <p class="body-copy">{body}</p>
        <div class="presentation-action">
          <Link variant="button" href={action.href} {locale}>{action.label}</Link>
        </div>
      </div>

      <figure class="presentation-media">
        <Image
          src={image}
          alt=""
          role="presentation"
          loading="lazy"
          widths={[400, 640, 800, 1000]}
          sizes="(min-width: 64rem) 32rem, (min-width: 48rem) 38rem, calc(100vw - 3rem)"
        />
      </figure>
    </div>
  </PageContainer>
</Section>

<style>
  .presentation-layout {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .presentation-content {
    min-inline-size: 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .body-copy {
    max-inline-size: var(--measure-body);
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .presentation-action {
    margin-block-start: var(--space-8);
  }

  .presentation-media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface-elevated);
  }

  .presentation-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  @media (min-width: 64rem) {
    .presentation-layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--column-gap-desktop);
    }

    .presentation-content {
      grid-column: 6 / span 7;
      grid-row: 1;
    }

    .presentation-media {
      grid-column: 1 / span 5;
      grid-row: 1;
      aspect-ratio: 4 / 5;
    }
  }
</style>
