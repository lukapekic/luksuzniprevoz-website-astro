---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Stage {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  intro?: string;
  body: string;
  label: string;
  stages: readonly [Stage, Stage, Stage, Stage];
  image: ImageMetadata;
}

const { heading, intro, body, label, stages, image } = Astro.props;
---

<Section spacing="feature" surface="open-dark" aria-labelledby="prom-arrival-heading">
  <PageContainer>
    <div class="arrival-layout">
      <div class="arrival-content">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="prom-arrival-heading" {heading} description={intro} />
        <p class="body-copy">{body}</p>

        <ol class="arrival-stages">
          {stages.map((stage, index) => (
            <li>
              <span class="stage-marker" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{stage.title}</h3>
                <p>{stage.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <figure class="arrival-media">
        <Image
          src={image}
          alt=""
          role="presentation"
          loading="lazy"
          widths={[400, 640, 800, 1000]}
          sizes="(min-width: 64rem) 32rem, (min-width: 48rem) 38rem, calc(100vw - 3rem)"
        />
      </figure>
    </div>
  </PageContainer>
</Section>

<style>
  .arrival-layout {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .arrival-content {
    min-inline-size: 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .body-copy {
    max-inline-size: var(--measure-body);
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .arrival-stages {
    margin: var(--space-8) 0 0;
    padding: 0;
    border-block-start: 1px solid var(--color-divider);
    list-style: none;
  }

  .arrival-stages li {
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-divider);
  }

  .stage-marker {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  h3 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
  }

  .arrival-stages p {
    margin-block: var(--space-2) 0;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .arrival-media {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface-elevated);
  }

  .arrival-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 64rem) {
    .arrival-layout {
      grid-template-columns: 7fr 5fr;
      gap: var(--column-gap-desktop);
    }
  }
</style>
