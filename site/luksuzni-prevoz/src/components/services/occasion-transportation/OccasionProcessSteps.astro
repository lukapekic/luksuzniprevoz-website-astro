---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Step {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  intro?: string;
  label: string;
  steps: readonly [Step, Step, Step];
}

const { heading, intro, label, steps } = Astro.props;
---

<Section spacing="compact" surface="open-dark" aria-labelledby="occasion-process-heading">
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="occasion-process-heading" {heading} description={intro} />

    <ol class="process-panel">
      {steps.map((step, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .process-panel {
    display: grid;
    min-inline-size: 0;
    margin: var(--space-8) 0 0;
    padding: var(--space-4) var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-section);
    background: var(--color-surface-light);
    color: var(--color-text-on-light);
    list-style: none;
  }

  .process-panel li {
    min-inline-size: 0;
    padding-block: var(--space-6);
    border-block-end: 1px solid color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 75%);
  }

  .process-panel li:last-child {
    border-block-end: 0;
  }

  .process-panel li > span {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 42%);
  }

  h3 {
    margin-block-start: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    color: var(--color-text-on-light);
  }

  li p {
    margin-block: var(--space-3) 0;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 35%);
  }

  @media (min-width: 64rem) {
    .process-panel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: var(--space-7);
    }

    .process-panel li {
      padding-block: 0;
      padding-inline: var(--space-7);
      border-block-end: 0;
      border-inline-end: 1px solid color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 75%);
    }

    .process-panel li:first-child {
      padding-inline-start: 0;
    }

    .process-panel li:last-child {
      padding-inline-end: 0;
      border-inline-end: 0;
    }
  }
</style>
