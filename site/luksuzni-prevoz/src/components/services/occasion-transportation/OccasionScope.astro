---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Item {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  intro?: string;
  body: string;
  label: string;
  items: readonly [Item, Item, Item];
  capabilities: readonly string[];
}

const { heading, intro, body, label, items, capabilities } = Astro.props;
---

<Section spacing="standard" surface="open-dark" aria-labelledby="occasion-scope-heading">
  <PageContainer>
    <div class="scope-intro">
      <p class="section-label"><span aria-hidden="true"></span>{label}</p>
      <SectionHeading id="occasion-scope-heading" {heading} description={intro} />
      <p class="body-copy">{body}</p>
    </div>

    <div class="scope-panel">
      <ol>
        {items.map((item, index) => (
          <li>
            <span class="scope-marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>

      {capabilities.length > 0 && (
        <ul class="capability-list" aria-label={heading}>
          {capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      )}
    </div>
  </PageContainer>
</Section>

<style>
  .scope-intro {
    max-inline-size: var(--measure-body);
    min-inline-size: 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .body-copy {
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .scope-panel {
    margin-block-start: var(--space-10);
    overflow: hidden;
    border-radius: var(--radius-section);
    background: var(--color-surface);
  }

  ol,
  .capability-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol > li {
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-6);
    border-block-end: 1px solid var(--color-divider);
  }

  .scope-marker {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  h3 {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
  }

  ol p {
    margin-block: var(--space-3) 0;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .capability-list li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .capability-list li::before {
    inline-size: var(--space-1);
    block-size: var(--space-1);
    flex: none;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    content: "";
  }

  @media (min-width: 48rem) {
    ol > li {
      grid-template-columns: var(--space-12) minmax(0, 1fr);
      padding: var(--space-7) var(--space-8);
    }

    .capability-list {
      padding-inline: var(--space-8);
    }
  }
</style>
