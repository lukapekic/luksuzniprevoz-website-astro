---
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Standard {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  intro?: string;
  body: string;
  label: string;
  items: readonly [Standard, Standard, Standard, Standard, Standard, Standard];
}

const { heading, intro, body, label, items } = Astro.props;
---

<Section spacing="standard" surface="open-dark" aria-labelledby="occasion-standards-heading">
  <PageContainer>
    <div class="standards-intro">
      <p class="section-label"><span aria-hidden="true"></span>{label}</p>
      <SectionHeading id="occasion-standards-heading" {heading} description={intro} />
      <p class="body-copy">{body}</p>
    </div>

    <ol class="standards-matrix">
      {items.map((item, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .standards-intro {
    max-inline-size: var(--measure-body);
    min-inline-size: 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .body-copy {
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .standards-matrix {
    display: grid;
    margin: var(--space-10) 0 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-section);
    list-style: none;
  }

  .standards-matrix li {
    min-inline-size: 0;
    padding: var(--space-6);
    border-block-end: 1px solid var(--color-divider);
  }

  .standards-matrix li:last-child {
    border-block-end: 0;
  }

  .standards-matrix li > span {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  h3 {
    margin-block-start: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
  }

  li p {
    margin-block: var(--space-3) 0;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .standards-matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .standards-matrix li:nth-child(odd) {
      border-inline-end: 1px solid var(--color-divider);
    }

    .standards-matrix li:nth-last-child(-n + 2) {
      border-block-end: 0;
    }
  }

  @media (min-width: 64rem) {
    .standards-matrix {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .standards-matrix li:not(:nth-child(3n)) {
      border-inline-end: 1px solid var(--color-divider);
    }

    .standards-matrix li:nth-last-child(-n + 3) {
      border-block-end: 0;
    }
  }
</style>
