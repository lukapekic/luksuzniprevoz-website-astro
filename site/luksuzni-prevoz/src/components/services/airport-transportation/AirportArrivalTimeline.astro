---
interface Step { title:string; text:string }
interface Props { steps:Step[] }
const { steps }=Astro.props;
---
<ol class="timeline">{steps.map((step,index)=><li><span aria-hidden="true">0{index+1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
<style>
  .timeline { position:relative;margin-block-start:var(--space-8);padding:0;list-style:none }
  .timeline::before { content:"";position:absolute;inset-block:var(--space-4);inset-inline-start:calc(var(--space-4) - .5px);inline-size:1px;background:var(--color-divider) }
  li { position:relative;display:grid;grid-template-columns:var(--space-8) minmax(0,1fr);gap:var(--space-4);padding-block-end:var(--space-6) }
  li:last-child { padding-block-end:0 }
  li>span { z-index:1;display:grid;place-items:center;inline-size:var(--space-8);block-size:var(--space-8);border:1px solid var(--color-accent);border-radius:var(--radius-full);background:var(--color-surface);font-family:var(--font-body);font-size:var(--text-caption);color:var(--color-accent) }
  h3 { font-family:var(--font-heading);font-size:var(--text-xl);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading);color:var(--color-text-primary) }
  p { max-inline-size:var(--measure-body);margin-block-start:var(--space-2);font-family:var(--font-body);font-size:var(--text-sm);line-height:var(--line-height-body);color:var(--color-text-muted) }
</style>
