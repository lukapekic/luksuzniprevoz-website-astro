---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { LocaleCode, RouteKey, UiStringKey } from "@astro-foundation/core";
import { buildFaqPage } from "@astro-foundation/core/seo";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import ReadingContainer from "../../../foundation/ui/ReadingContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import ServiceHero from "../shared/ServiceHero.astro";
import ServiceOverview from "../shared/ServiceOverview.astro";
import VehicleRecommendations from "../shared/VehicleRecommendations.astro";
import ServiceStandards from "../shared/ServiceStandards.astro";
import AirportBookingBlock from "./AirportBookingBlock.astro";
import AirportArrivalTimeline from "./AirportArrivalTimeline.astro";
import OpenSplitSection from "../../shared/OpenSplitSection.astro";
import FAQ from "../../shared/FAQ.astro";
import FinalCTA from "../../shared/FinalCTA.astro";
import { getService } from "../../../data/services.ts";
import { getVehicle } from "../../../data/fleet.ts";
import { homepageFleetEntries, homepageFleetMedia, type HomepageFleetEntry } from "../../../data/fleet-media.ts";
import { getPricing } from "../../../data/pricing.ts";
import { buildServiceStandardGroups } from "../../../lib/service-standards.ts";
import { contact, isVerified } from "../../../data/contact.ts";
import { t } from "../../../lib/i18n.ts";
import { resolveCtaHref } from "../../../lib/cta.ts";
import { buildPageSeo } from "../../../lib/seo.ts";
import heroImage from "../../../assets/pages/airport-transfer/hero.webp";
import arrivalImage from "../../../assets/rear-seat.webp";
import aviationImage from "../../../assets/private-flight.webp";
import finalCtaImage from "../../../assets/final-cta-bg.webp";

interface Props { routeKey:"airportTransportation"; locale:LocaleCode; content:CollectionEntry<"pages"> }
const { routeKey,locale,content }=Astro.props;
if(routeKey!=="airportTransportation"||content.data.pageType!=="service"||content.data.routeKey!==routeKey)throw new Error("AirportTransportationPage received incompatible data.");
const data=content.data;if(!data.hero||!data.vehicleRecommendations||!data.faq)throw new Error(`Airport content incomplete for ${locale}.`);
const service=getService(routeKey);const section=(key:string)=>{const value=data.sections.find(item=>item.key===key);if(!value)throw new Error(`Missing Airport section ${key}.`);return value};
const booking=section("booking"),arrival=section("arrivalHandling"),aviation=section("privateAviationFbo");
const ui=(key:string)=>t(key as UiStringKey,locale);const fill=(value:string,token:string,n:number)=>value.replace(`{${token}}`,String(n));
const overviewGroups=[
  service.standardStops==="point-to-point"&&service.oneWay&&service.return&&{key:"transfer",icon:"transfer" as const,title:ui("airport.overview.transfer.title"),text:ui("airport.overview.transfer.text")},
  service.flightTracking&&service.meetAndGreet&&service.standardWaitingMinutesAfterLanding!==undefined&&{key:"arrival",icon:"arrival" as const,title:ui("airport.overview.arrival.title"),text:fill(ui("airport.overview.arrival.text"),"minutes",service.standardWaitingMinutesAfterLanding)},
  service.luggageAssistance&&service.nameSign&&{key:"assistance",icon:"assistance" as const,title:ui("airport.overview.assistance.title"),text:ui("airport.overview.assistance.text")},
  service.commercialAviation&&service.privateAviation&&service.fboCoordination&&{key:"aviation",icon:"aviation" as const,title:ui("airport.overview.aviation.title"),text:ui("airport.overview.aviation.text")},
].filter((item):item is Exclude<typeof item,false|undefined>=>Boolean(item));
const timelineSteps=[service.flightTracking&&{title:ui("airport.timeline.flight.title"),text:ui("airport.timeline.flight.text")},service.meetAndGreet&&{title:ui("airport.timeline.meeting.title"),text:ui("airport.timeline.meeting.text")},service.luggageAssistance&&{title:ui("airport.timeline.luggage.title"),text:ui("airport.timeline.luggage.text")},service.standardStops==="point-to-point"&&{title:ui("airport.timeline.destination.title"),text:ui("airport.timeline.destination.text")}].filter((item):item is Exclude<typeof item,false|undefined>=>Boolean(item));
const standardGroups=buildServiceStandardGroups(locale);
const primaryAction={label:data.hero.primaryCta.label,href:resolveCtaHref(data.hero.primaryCta,locale,{service:routeKey})};const secondaryAction=data.hero.secondaryCta?{label:data.hero.secondaryCta.label,href:resolveCtaHref(data.hero.secondaryCta,locale,{service:routeKey})}:undefined;
const finalPrimary={label:data.finalCta.primaryCta.label,href:resolveCtaHref(data.finalCta.primaryCta,locale,{service:routeKey})};const finalSecondary=data.finalCta.secondaryCta?{label:data.finalCta.secondaryCta.label,href:resolveCtaHref(data.finalCta.secondaryCta,locale,{service:routeKey})}:undefined;
const contacts={phone:isVerified(contact.phone)?contact.phone.value??undefined:undefined,email:isVerified(contact.email)?contact.email.value??undefined:undefined};
const seo=buildPageSeo({routeKey,locale,title:data.seoTitle,description:data.seoDescription,noindex:data.noindex??false,structuredData:[buildFaqPage(data.faq.items)]});
const classes={sedan:ui("fleet.class.sedan"),suv:ui("fleet.class.suv"),van:ui("fleet.class.van"),minivan:ui("fleet.class.minivan"),bus:ui("fleet.class.bus")};
const vehicleRecommendations=data.vehicleRecommendations.vehicleIds.map((id)=>{
  const vehicle=getVehicle(id);
  const vehiclePricing=getPricing(vehicle.id);
  if(!vehiclePricing)throw new Error(`Published Airport recommendation ${vehicle.id} is missing pricing.`);
  const showcaseEntry: HomepageFleetEntry | undefined = homepageFleetEntries.find((entry)=>entry.vehicleId===id);
  return {
    vehicle,
    image:homepageFleetMedia[vehicle.id],
    displayName:showcaseEntry?.displayName,
    showPassengerCapacity:showcaseEntry?.showPassengerCapacity,
    meta:{label:ui("airport.fare.label"),value:new Intl.NumberFormat(locale,{style:"currency",currency:vehiclePricing.airportTransfer.currency}).format(vehiclePricing.airportTransfer.amount)},
  };
});
---
<BaseLayout seo={seo} currentRouteKey={routeKey} currentLocale={locale} overHero>
  <div class="airport-hero-offset">
    <ServiceHero
      title={data.hero.title}
      description={data.hero.description}
      supportText={data.hero.supportText}
      primaryAction={primaryAction}
      secondaryAction={secondaryAction}
      locale={locale}
      variant="full-bleed"
      image={heroImage}
      imageAlt=""
    />
  </div>

  <ServiceOverview
    heading={data.overview.heading.title}
    intro={data.overview.heading.intro}
    body={data.overview.body}
    groups={overviewGroups}
    label={ui("airport.section.overview")}
    variant="grouped-icons"
    surface="open-dark"
  />

  <Section spacing="standard" surface="open-dark" aria-labelledby="arrival-heading">
    <PageContainer>
      <OpenSplitSection
        image={arrivalImage}
        imageAlt=""
        layout="image-content"
        ratio="5-7"
        mobileOrder="content-first"
        mediaHeight="match-content"
        mediaOverlay
      >
        <div slot="content" class="split-copy">
          <p class="section-label"><span aria-hidden="true"></span>{ui("airport.section.arrival")}</p>
          <SectionHeading id="arrival-heading" heading={arrival.heading.title} description={arrival.heading.intro} />
          {arrival.body && <p class="body-copy">{arrival.body}</p>}
          <AirportArrivalTimeline steps={timelineSteps} />
        </div>
      </OpenSplitSection>
    </PageContainer>
  </Section>

  <AirportBookingBlock
    heading={booking.heading.title}
    intro={booking.heading.intro}
    body={booking.body}
    label={ui("airport.section.booking")}
    flightLabel={ui("airport.booking.form.flightNumberOptional")}
    dateLabel={ui("airport.booking.form.date")}
    timeLabel={ui("airport.booking.form.time")}
    continueLabel={ui("airport.booking.form.continue")}
    handoffNote={ui("airport.booking.form.handoffNote")}
    confirmationNote={ui("airport.booking.form.pendingConfirmation")}
    action={primaryAction.href}
    secondaryAction={secondaryAction}
    locale={locale}
    class="mt-[var(--space-8)]"
  />

  {service.privateAviation && service.commercialAviation && service.fboCoordination && (
    <Section spacing="feature" surface="open-dark" aria-labelledby="aviation-heading">
      <PageContainer>
        <div class="fbo-feature md:landscape:grid-cols-[7fr_5fr] md:landscape:gap-[var(--column-gap-tablet)] lg:grid-cols-[7fr_5fr] lg:gap-[var(--column-gap-desktop)]">
          <div class="fbo-copy">
            <p class="section-label"><span aria-hidden="true"></span>{ui("airport.section.privateAviation")}</p>
            <SectionHeading id="aviation-heading" heading={aviation.heading.title} description={aviation.heading.intro} />
            {aviation.body && <p class="body-copy">{aviation.body}</p>}
            <div class="vip-list">
              {aviation.items?.map((item) => (
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </div>
              ))}
            </div>
          </div>
          <figure class="fbo-media">
            <Image
              class="fbo-image"
              src={aviationImage}
              alt=""
              role="presentation"
              loading="lazy"
              widths={[480, 640, 800]}
              sizes="(min-width: 64rem) 32rem, (min-width: 48rem) 34rem, calc(100vw - 2rem)"
            />
          </figure>
        </div>
      </PageContainer>
    </Section>
  )}

  <VehicleRecommendations
    heading={data.vehicleRecommendations.heading.title}
    intro={data.vehicleRecommendations.heading.intro}
    recommendations={vehicleRecommendations}
    cta={{
      label: data.vehicleRecommendations.cta.label,
      to: data.vehicleRecommendations.cta.target.type === "route"
        ? data.vehicleRecommendations.cta.target.routeKey as RouteKey
        : "fleet",
    }}
    locale={locale}
    passengerLabel={ui("fleet.passengers")}
    classLabels={classes}
    ariaLabel={ui("fleet.carousel.ariaLabel")}
    previousLabel={ui("fleet.carousel.previous")}
    nextLabel={ui("fleet.carousel.next")}
    label={ui("airport.section.vehicles")}
    carouselId="airport-vehicles"
  />

  <ServiceStandards
    heading={ui("serviceStandards.heading")}
    intro={ui("serviceStandards.intro")}
    groups={standardGroups}
    label={ui("airport.section.standards")}
    variant="divided-panel"
  />

  <Section spacing="compact" surface="light" aria-labelledby="faq-heading" class="mt-[var(--space-8)]">
    <ReadingContainer>
      <p class="section-label section-label--light"><span aria-hidden="true"></span>{ui("airport.section.faq")}</p>
      <SectionHeading id="faq-heading" heading={data.faq.heading} on="light" />
      <FAQ items={data.faq.items} on="light" class="faq-spacing" />
    </ReadingContainer>
  </Section>

  <FinalCTA
    heading={data.finalCta.heading}
    description={data.finalCta.text}
    primaryAction={finalPrimary}
    secondaryAction={finalSecondary}
    contacts={contacts}
    image={finalCtaImage}
    imageAlt=""
    imageFit="cover"
    mediaTreatment="integrated"
    locale={locale}
  />
</BaseLayout>

<style>
  .airport-hero-offset {
    margin-block-start: calc(-1 * var(--site-header-height));
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }
  .section-label > span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }
  .section-label--light {
    color: color-mix(in oklab, var(--color-text-on-light), var(--color-surface-light) 35%);
  }
  .section-label--light > span {
    background: var(--color-focus-light);
  }

  .body-copy {
    max-inline-size: var(--measure-body);
    margin-block-start: var(--space-5);
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .fbo-feature {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }
  .fbo-media {
    position: relative;
    margin: 0;
    inline-size: 100%;
    max-inline-size: var(--container-narrow);
    aspect-ratio: 4 / 5;
    justify-self: center;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    isolation: isolate;
  }
  .fbo-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.82) contrast(1.06) saturate(0.8);
  }
  .fbo-media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--color-background), transparent 16%) 0%,
      transparent 46%,
      color-mix(in oklab, var(--color-background), transparent 72%) 100%
    );
    content: "";
  }

  .vip-list {
    margin-block: var(--space-6);
    border-block-start: 1px solid var(--color-divider);
  }
  .vip-list > div {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-divider);
  }
  .vip-list strong {
    font-family: var(--font-body);
  }
  .vip-list span {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .faq-spacing {
    margin-block-start: var(--space-8);
  }

  @media (min-width: 64rem) {
    .fbo-media {
      max-inline-size: none;
      justify-self: stretch;
    }
  }
</style>
