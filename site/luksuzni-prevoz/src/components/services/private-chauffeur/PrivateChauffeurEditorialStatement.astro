---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Statement {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  intro: string;
  statements: readonly [Statement, Statement, Statement, Statement];
  image: ImageMetadata;
  imageAlt: "";
}

const { heading, intro, statements, image, imageAlt } = Astro.props;

if (statements.length !== 4 || statements.some(({ title, text }) => !title || !text)) {
  throw new Error("PrivateChauffeurEditorialStatement requires four complete statements.");
}
---

<Section spacing="feature" surface="open-dark" aria-labelledby="private-chauffeur-editorial-heading">
  <PageContainer>
    <div class="editorial-layout">
      <div class="editorial-copy">
        <SectionHeading id="private-chauffeur-editorial-heading" heading={heading} />
        <p class="editorial-intro">{intro}</p>
        <ol class="statements" role="list">
          {statements.map((statement, index) => (
            <li>
              <span class="statement-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{statement.title}</h3>
                <p>{statement.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <figure class="editorial-media">
        <Image
          class="editorial-image"
          src={image}
          alt={imageAlt}
          role="presentation"
          loading="lazy"
          widths={[400, 560, 720, 900]}
          sizes="(min-width: 64rem) 30vw, calc(100vw - 2rem)"
        />
      </figure>
    </div>
  </PageContainer>
</Section>

<style>
  .editorial-layout {
    display: grid;
    gap: var(--space-10);
  }

  .editorial-copy {
    min-inline-size: 0;
  }

  .editorial-intro {
    max-inline-size: var(--measure-body);
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .statements {
    display: grid;
    margin: var(--space-8) 0 0;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface-elevated);
    list-style: none;
  }

  .statements li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .statements li + li {
    border-block-start: 1px solid var(--color-divider);
  }

  .statement-marker {
    min-inline-size: var(--space-8);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-ui);
    color: var(--color-accent);
  }

  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
  }

  .statements p {
    max-inline-size: var(--measure-body);
    margin-block: var(--space-3) 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .editorial-media {
    position: relative;
    margin: 0;
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface-elevated);
  }

  .editorial-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 64rem) {
    .editorial-layout {
      grid-template-columns: 8fr 4fr;
      gap: var(--column-gap-desktop);
      align-items: stretch;
    }

    .editorial-media {
      min-block-size: 100%;
      aspect-ratio: auto;
    }

    .statements {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .statements li + li {
      border-block-start: 0;
    }

    .statements li:nth-child(2n) {
      border-inline-start: 1px solid var(--color-divider);
    }

    .statements li:nth-child(n + 3) {
      border-block-start: 1px solid var(--color-divider);
    }
  }
</style>
