---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";

interface ServiceItem {
  index: string;
  routeKey: RouteKey;
  title: string;
  text: string;
  ctaLabel: string;
  capabilities: readonly [string, string, string];
  image: ImageMetadata;
}

interface Props {
  heading: string;
  intro?: string;
  label: string;
  items: readonly [ServiceItem, ServiceItem, ServiceItem];
  locale: LocaleCode;
}

const { heading, intro, label, items, locale } = Astro.props;
---

<Section
  id="event-services"
  spacing="standard"
  surface="open-dark"
  aria-labelledby="event-services-heading"
  class="scroll-mt-[calc(var(--site-header-height)+var(--space-4))]"
>
  <PageContainer>
    <p class="section-label"><span aria-hidden="true"></span>{label}</p>
    <SectionHeading id="event-services-heading" {heading} description={intro} />

    <ol class="special-event-service-grid grid gap-[var(--space-5)] md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="md:first:col-span-2 lg:first:col-span-1">
          <article class="service-card">
            <div class="service-card__media" aria-hidden="true">
              <Image
                src={item.image}
                alt=""
                role="presentation"
                loading="lazy"
                decoding="async"
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 26rem, (min-width: 48rem) 44vw, 92vw"
                format="avif"
                quality={60}
              />
              <span>{item.index}</span>
            </div>
            <div class="service-card__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <ul class="capabilities" role="list">
                {item.capabilities.map((capability) => <li>{capability}</li>)}
              </ul>
              <Link variant="default" to={item.routeKey} {locale}>
                {item.ctaLabel}<span aria-hidden="true">→</span>
              </Link>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .special-event-service-grid { margin-block-start:var(--space-10);padding:0;list-style:none }
  .special-event-service-grid > li { min-inline-size:0 }
  .service-card { display:flex;min-block-size:100%;flex-direction:column;overflow:hidden;border:1px solid var(--color-border-subtle);border-radius:var(--radius-card);background:var(--color-surface) }
  .service-card__media { position:relative;aspect-ratio:4 / 3;overflow:hidden;background:var(--color-surface-elevated);isolation:isolate }
  .service-card__media::after { position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,transparent 48%,color-mix(in oklab,var(--color-background),transparent 22%) 100%);content:"" }
  .service-card__media :global(img) { position:absolute;inset:0;inline-size:100%;block-size:100%;object-fit:cover;filter:brightness(.76) contrast(1.04) saturate(.74) }
  .service-card__media > span { position:absolute;inset-block-end:var(--space-5);inset-inline-start:var(--space-5);z-index:2;font-family:var(--font-body);font-size:var(--text-sm);font-weight:var(--font-weight-semibold);color:var(--color-accent) }
  .service-card__body { display:flex;min-block-size:0;flex:1;flex-direction:column;align-items:flex-start;padding:var(--space-6) }
  h3 { font-family:var(--font-heading);font-size:var(--text-h3);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading);letter-spacing:var(--letter-spacing-heading) }
  .service-card__body > p { margin-block-start:var(--space-4);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
  .capabilities { inline-size:100%;margin:var(--space-6) 0;padding:0;border-block-start:1px solid var(--color-divider);list-style:none }
  .capabilities li { display:flex;align-items:center;gap:var(--space-3);padding-block:var(--space-3);border-block-end:1px solid var(--color-divider);font-family:var(--font-body);font-size:var(--text-sm);line-height:var(--line-height-body);color:var(--color-text-primary) }
  .capabilities li::before { flex:none;inline-size:var(--space-1);block-size:var(--space-1);border-radius:var(--radius-full);background:var(--color-accent);content:"" }
  .service-card__body > :global(a) { margin-block-start:auto;min-block-size:2.75rem }
</style>
