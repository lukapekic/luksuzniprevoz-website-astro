---
import type { ImageMetadata } from "astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import OpenSplitSection from "../../shared/OpenSplitSection.astro";

interface Item { title: string; text: string }
interface Props { heading: string; intro?: string; body?: string; label: string; items: readonly [Item, Item, Item, Item, Item]; image: ImageMetadata }
const { heading, intro, body, label, items, image } = Astro.props;
---

<Section spacing="feature" surface="open-dark" aria-labelledby="special-event-coordination-heading">
  <PageContainer>
    <OpenSplitSection {image} imageAlt="" layout="content-image" ratio="7-5" mobileOrder="content-first" mediaHeight="match-content">
      <div slot="content">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="special-event-coordination-heading" {heading} description={intro} />
        {body && <p class="body-copy">{body}</p>}
        <ol class="coordination-flow">
          {items.map((item, index) => (
            <li>
              <span class="flow-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </OpenSplitSection>
  </PageContainer>
</Section>

<style>
  .section-label { display:flex;align-items:center;gap:var(--space-3);margin-block-end:var(--space-5);font-family:var(--font-body);font-size:var(--text-ui);font-weight:var(--font-weight-medium);color:var(--color-text-muted) }
  .section-label > span { inline-size:var(--space-8);block-size:1px;background:var(--color-accent) }
  .body-copy { max-inline-size:var(--measure-body);margin-block-start:var(--space-5);font-family:var(--font-body);line-height:var(--line-height-body);color:var(--color-text-muted) }
  .coordination-flow { margin:var(--space-8) 0 0;padding:0;border-block-start:1px solid var(--color-divider);list-style:none }
  .coordination-flow li { display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-4);padding-block:var(--space-4);border-block-end:1px solid var(--color-divider) }
  .flow-marker { min-inline-size:var(--space-8);font-family:var(--font-body);font-size:var(--text-caption);font-weight:var(--font-weight-semibold);color:var(--color-accent) }
  h3 { font-family:var(--font-heading);font-size:var(--text-xl);font-weight:var(--font-weight-semibold);line-height:var(--line-height-heading) }
  li p { margin-block-start:var(--space-2);font-family:var(--font-body);font-size:var(--text-sm);line-height:var(--line-height-body);color:var(--color-text-muted) }
</style>
