---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { LocaleCode } from "@astro-foundation/core";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";
import Link from "../../../foundation/ui/Link.astro";

interface Item { title: string; text: string }
interface Action { label: string; href: string }
interface Props {
  heading: string;
  intro?: string;
  body: string;
  label: string;
  items: readonly [Item, Item, Item];
  action: Action;
  locale: LocaleCode;
  primaryImage: ImageMetadata;
  supportingImage: ImageMetadata;
}

const { heading, intro, body, label, items, action, locale, primaryImage, supportingImage } = Astro.props;
---

<Section spacing="standard" surface="open-dark" aria-labelledby="vip-aviation-heading">
  <PageContainer>
    <div class="aviation-layout">
      <div class="aviation-content">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="vip-aviation-heading" {heading} description={intro} />
        <p class="body-copy">{body}</p>

        <ol class="aviation-list">
          {items.map((item, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
            </li>
          ))}
        </ol>

        <div class="aviation-action"><Link variant="button" href={action.href} {locale}>{action.label}</Link></div>
      </div>

      <div class="aviation-media" aria-hidden="true">
        <Image
          class="aviation-media__primary"
          src={primaryImage}
          alt=""
          role="presentation"
          loading="lazy"
          widths={[640, 960, 1440]}
          sizes="(min-width: 64rem) 55vw, calc(100vw - 2rem)"
        />
        <Image
          class="aviation-media__supporting"
          src={supportingImage}
          alt=""
          role="presentation"
          loading="lazy"
          widths={[360, 540, 720]}
          sizes="(min-width: 64rem) 20rem, 62vw"
        />
      </div>
    </div>
  </PageContainer>
</Section>

<style>
  .aviation-layout { display: grid; gap: var(--space-10); align-items: start; }
  .aviation-content { min-inline-size: 0; }
  .section-label { display: flex; align-items: center; gap: var(--space-3); margin-block-end: var(--space-5); font-family: var(--font-body); font-size: var(--text-ui); font-weight: var(--font-weight-medium); color: var(--color-text-muted); }
  .section-label span { inline-size: var(--space-8); block-size: 1px; background: var(--color-accent); }
  .body-copy { max-inline-size: var(--measure-body); margin-block: var(--space-5) 0; font-family: var(--font-body); line-height: var(--line-height-body); color: var(--color-text-muted); }
  .aviation-list { margin: var(--space-8) 0 0; padding: 0; border-block-start: 1px solid var(--color-divider); list-style: none; }
  .aviation-list li { display: grid; grid-template-columns: var(--space-10) minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); border-block-end: 1px solid var(--color-divider); }
  .aviation-list li > span { font-family: var(--font-body); font-size: var(--text-caption); font-weight: var(--font-weight-semibold); color: var(--color-accent); }
  h3 { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: var(--font-weight-semibold); line-height: var(--line-height-heading); }
  .aviation-list p { margin-block: var(--space-2) 0; overflow-wrap: anywhere; font-family: var(--font-body); font-size: var(--text-sm); line-height: var(--line-height-body); color: var(--color-text-muted); }
  .aviation-action { margin-block-start: var(--space-7); }
  .aviation-media { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); grid-template-rows: minmax(18rem, 1fr) auto; gap: var(--space-4); min-inline-size: 0; }
  .aviation-media :global(img) { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; filter: brightness(0.78) contrast(1.05) saturate(0.72); }
  .aviation-media__primary { grid-column: 1 / -1; grid-row: 1; min-block-size: 22rem; border-radius: var(--radius-section); }
  .aviation-media__supporting { grid-column: 2; grid-row: 2; min-block-size: 11rem; border-radius: var(--radius-card); }
  @media (min-width: 64rem) {
    .aviation-layout { grid-template-columns: 5fr 7fr; gap: var(--column-gap-desktop); }
    .aviation-media { grid-template-rows: minmax(30rem, 1fr) auto; }
    .aviation-media__supporting { min-block-size: 14rem; }
  }
</style>
