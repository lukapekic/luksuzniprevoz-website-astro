---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../../../foundation/ui/Section.astro";
import PageContainer from "../../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../../foundation/ui/SectionHeading.astro";

interface Props {
  heading: string;
  intro?: string;
  body: string;
  label: string;
  principles: readonly [string, string, string];
  image: ImageMetadata;
}

const { heading, intro, body, label, principles, image } = Astro.props;
---

<Section spacing="standard" surface="open-dark" aria-labelledby="vip-definition-heading">
  <PageContainer>
    <div class="definition-layout">
      <div class="definition-content">
        <p class="section-label"><span aria-hidden="true"></span>{label}</p>
        <SectionHeading id="vip-definition-heading" {heading} description={intro} />
        <p class="body-copy">{body}</p>

        <ol class="principles">
          {principles.map((principle, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <p>{principle}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="definition-media" aria-hidden="true">
        <Image
          src={image}
          alt=""
          role="presentation"
          loading="lazy"
          widths={[480, 720, 960]}
          sizes="(min-width: 64rem) 38vw, calc(100vw - 2rem)"
        />
      </div>
    </div>
  </PageContainer>
</Section>

<style>
  .definition-layout {
    display: grid;
    gap: var(--space-10);
    align-items: stretch;
  }

  .definition-content {
    min-inline-size: 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .section-label span {
    inline-size: var(--space-8);
    block-size: 1px;
    background: var(--color-accent);
  }

  .body-copy {
    max-inline-size: var(--measure-body);
    margin-block: var(--space-5) 0;
    font-family: var(--font-body);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .principles {
    margin: var(--space-8) 0 0;
    padding: 0;
    border-block-start: 1px solid var(--color-divider);
    list-style: none;
  }

  .principles li {
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--color-divider);
  }

  .principles li > span {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .principles p {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: var(--line-height-heading);
  }

  .definition-media {
    min-block-size: 22rem;
    overflow: hidden;
    border-radius: var(--radius-section);
    background: var(--color-surface);
  }

  .definition-media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 62% center;
    filter: brightness(0.78) contrast(1.04) saturate(0.72);
  }

  @media (min-width: 64rem) {
    .definition-layout {
      grid-template-columns: 7fr 5fr;
      gap: var(--column-gap-desktop);
    }

    .definition-media {
      min-block-size: 36rem;
    }
  }
</style>
