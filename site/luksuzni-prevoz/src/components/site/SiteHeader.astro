---
/**
 * SiteHeader — premium site chrome for the Luxury Transportation homepage V1.
 *
 * Contract: docs/home/home-components/02-site-header.md
 * Blueprint: docs/home/reference/blueprint.md §6 (Header)
 * Tokens: docs/home/home-components/00-token-matrix.md (locked color/space/radius vars)
 *
 * Composite built on foundation primitives (LanguageSwitcher). Internal hrefs
 * resolve via getPath() (FND-I18N-03 — never manual slug concatenation). Labels
 * come from navigation-labels.json via getNavLabel; generic UI strings come
 * from the UI dictionary via t() (FND-ARCH-03). No raw internal URLs.
 *
 * Islands (each justified, fail-open, wrapped in try/catch — FND-ARCH-06):
 *   - sticky/transparent-over-hero surface state (scroll observer)
 *   - desktop dropdowns (Services + Business/Special Events flyouts)
 *   - mobile full-height menu (toggle, ESC, focus management)
 * All links are server-rendered regardless of JS.
 */
import { getPath } from "@astro-foundation/core/i18n";
import { config } from "../../../foundation.config.ts";
import { routes } from "../../data/routes.ts";
import {
  navigation,
  getNavLabel,
  type NavGroup,
  type NavLeaf,
  type NavBranch,
} from "../../data/navigation.ts";
import { t } from "../../lib/i18n.ts";
import LanguageSwitcher from "../../foundation/ui/LanguageSwitcher.astro";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";

interface Props {
  currentRouteKey: RouteKey;
  currentLocale: LocaleCode;
  /**
   * Whether the header sits over the hero at page top, allowing the
   * transparent-over-hero state (02 §Surface). Defaults true (homepage).
   * Pages without a hero should pass `overHero={false}` for a always-solid bar.
   */
  overHero?: boolean;
}

const { currentRouteKey, currentLocale, overHero = true } = Astro.props;

const defaultLocale = (config.locales.locales.find((l) => l.isDefault)?.code ?? "sr") as LocaleCode;

/** Resolve a route href for the current locale (FND-I18N-03). */
const href = (key: RouteKey): string => getPath(key, currentLocale, routes, defaultLocale);

const homeHref = href("home");

// --- Navigation model ------------------------------------------------------
// Top level: Services▾ (dropdown of the 4 main services, with nested flyouts
// for Business & Special Events) + Fleet, Pricing, About, Contact.
const servicesGroup = navigation.header.find(
  (item): item is NavGroup => "id" in item && item.id === "services",
);
if (!servicesGroup) throw new Error("SiteHeader: 'services' nav group missing in navigation.ts");

const servicesChildren = servicesGroup.children; // privateChauffeur, airport, business▾, specialEvents▾
const topLeaves = navigation.header.filter(
  (item): item is NavLeaf => "routeKey" in item && !("children" in item),
);

// --- Book CTA -------------------------------------------------------------
// headerPrimaryAction target is the "booking" FLOW (flowKey: "booking"), not a
// route. The booking flow is not yet implemented; V1 routes Book to the contact
// page as the interim booking entry. Replace with the booking-flow route when
// implemented — do not treat contact as the final target.
const bookLabel = getNavLabel("book", currentLocale);
const bookHref = href("contact");

// --- UI strings (FND-ARCH-03) ---------------------------------------------
const menuLabel = t("nav.menu", currentLocale);
const closeLabel = t("nav.close", currentLocale);
const mainNavLabel = t("nav.main", currentLocale);
const langLabel = t("nav.language", currentLocale);
const skipLabel = t("a11y.skipToContent", currentLocale);
const monogram = t("brand.monogram", currentLocale);

const isCurrent = (key: RouteKey): boolean => currentRouteKey === key;

// Stable panel IDs for aria-controls wiring.
const servicesPanelId = "hdr-services";
const subPanelId = (key: string): string => `hdr-sub-${key}`;
const mobilePanelId = "hdr-mobile";

/** Type guard: a dropdown-capable branch (route + children). */
const isBranch = (node: unknown): node is NavBranch =>
  typeof node === "object" && node !== null && "routeKey" in node && "children" in node;

/** Type guard: a plain leaf (route, no children). */
const isLeaf = (node: unknown): node is NavLeaf =>
  typeof node === "object" && node !== null && "routeKey" in node && !("children" in node);

const branches = servicesChildren.filter(isBranch); // business, specialEvents
const leafServices = servicesChildren.filter(isLeaf); // privateChauffeur, airport
---

<!-- Skip link target is #main-content (rendered by Container as="main"). -->
<a href="#main-content" class="skip-link" data-skip-link>{skipLabel}</a>

<header
  data-site-header
  data-state="top"
  data-over-hero={overHero ? "true" : "false"}
  class="site-header"
>
  <div class="site-header__shell">
    <div class="site-header__row">
      <!-- Brand: GS mark + coded wordmark -->
      <a href={homeHref} class="brand" aria-label={config.brand}>
        <span class="brand__mark" aria-hidden="true">{monogram}</span>
        <span class="brand__word">{config.brand}</span>
      </a>

      <!-- Desktop navigation (lg+): Services▾ + top leaves -->
      <nav class="nav-desktop" aria-label={mainNavLabel}>
        <ul class="nav-list" role="list">
          <li class="nav-item" data-dropdown>
            <button
              type="button"
              class="nav-trigger"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls={servicesPanelId}
              data-dropdown-trigger
            >
              <span>{getNavLabel("services", currentLocale)}</span>
              <svg class="nav-trigger__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div id={servicesPanelId} class="dropdown" data-dropdown-panel role="menu" hidden>
              <ul class="dropdown__list" role="list">
                {leafServices.map((item) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      class="dropdown-link"
                      href={href(item.routeKey)}
                      aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                      data-astro-prefetch
                    >
                      {getNavLabel(item.routeKey, currentLocale)}
                    </a>
                  </li>
                ))}
                {branches.map((branch) => (
                  <li class="dropdown__sub" data-dropdown role="none">
                    <button
                      type="button"
                      role="menuitem"
                      class="dropdown-link dropdown-link--branch"
                      aria-haspopup="menu"
                      aria-expanded="false"
                      aria-controls={subPanelId(branch.routeKey)}
                      data-dropdown-trigger
                    >
                      <span>{getNavLabel(branch.routeKey, currentLocale)}</span>
                      <svg class="dropdown-link__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                      </svg>
                    </button>
                    <div id={subPanelId(branch.routeKey)} class="dropdown dropdown--sub" data-dropdown-panel role="menu" hidden>
                      <ul class="dropdown__list" role="list">
                        {branch.children.map((child) => (
                          <li role="none">
                            <a
                              role="menuitem"
                              class="dropdown-link"
                              href={href(child.routeKey)}
                              aria-current={isCurrent(child.routeKey) ? "page" : undefined}
                              data-astro-prefetch
                            >
                              {getNavLabel(child.routeKey, currentLocale)}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </li>
          {topLeaves.map((item) => (
            <li class="nav-item">
              <a
                class="nav-link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Actions: language switcher + Book CTA + mobile trigger -->
      <div class="header-actions">
        <LanguageSwitcher
          currentLocale={currentLocale}
          currentRouteKey={currentRouteKey}
          class="lang-switcher"
          ariaLabel={langLabel}
        />
        <a href={bookHref} class="book-cta" data-astro-prefetch>
          {bookLabel}
        </a>
        <button
          type="button"
          class="menu-toggle"
          aria-expanded="false"
          aria-controls={mobilePanelId}
          aria-label={menuLabel}
          data-menu-toggle
          data-menu-label={menuLabel}
          data-close-label={closeLabel}
        >
          <svg class="menu-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Hide the mobile panel ASAP when JS is available; it is server-rendered
     OPEN so no-JS users can still navigate (FND-ARCH-06). */}
  <script is:inline>
    try { document.getElementById("hdr-mobile")?.setAttribute("hidden", ""); } catch (e) {}
  </script>

  <!-- Mobile full-height menu panel -->
  <div id={mobilePanelId} class="mobile-panel" data-mobile-panel role="dialog" aria-modal="true" aria-label={mainNavLabel}>
    <div class="mobile-panel__inner">
      <nav class="mobile-nav" aria-label={mainNavLabel}>
        <p class="mobile-nav__group-label">{getNavLabel("services", currentLocale)}</p>
        <ul class="mobile-nav__list" role="list">
          {leafServices.map((item) => (
            <li>
              <a
                class="mobile-link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
          {branches.map((branch) => (
            <li class="mobile-nav__branch">
              <a
                class="mobile-link mobile-link--branch"
                href={href(branch.routeKey)}
                aria-current={isCurrent(branch.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(branch.routeKey, currentLocale)}
              </a>
              <ul class="mobile-nav__sub" role="list">
                {branch.children.map((child) => (
                  <li>
                    <a
                      class="mobile-link mobile-link--sub"
                      href={href(child.routeKey)}
                      aria-current={isCurrent(child.routeKey) ? "page" : undefined}
                      data-astro-prefetch
                    >
                      {getNavLabel(child.routeKey, currentLocale)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>

        <ul class="mobile-nav__list mobile-nav__list--pages" role="list">
          {topLeaves.map((item) => (
            <li>
              <a
                class="mobile-link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-panel__actions">
        <LanguageSwitcher
          currentLocale={currentLocale}
          currentRouteKey={currentRouteKey}
          ariaLabel={langLabel}
        />
        <a href={bookHref} class="book-cta book-cta--mobile" data-astro-prefetch>
          {bookLabel}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* --- Shell & sticky surface states -------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Default = solid (no-JS safe). JS promotes to transparent at page top
       only when over the hero (02 §Surface). */
    background: var(--color-background);
    border-block-end: 1px solid transparent;
    transition: background var(--duration-normal) var(--ease-standard),
                border-color var(--duration-normal) var(--ease-standard);
  }
  /* Transparent-over-hero at scroll top (JS sets data-state="scrolled" on scroll). */
  .site-header[data-over-hero="true"][data-state="top"] {
    background: transparent;
  }
  .site-header[data-state="scrolled"] {
    background: var(--color-background);
    border-block-end-color: var(--color-border-subtle);
  }

  .site-header__shell {
    width: min(calc(100% - (2 * var(--gutter-page))), var(--container-main));
    margin-inline: auto;
  }
  .site-header__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.75rem; /* mobile */
    padding-block: var(--space-3);
  }
  @media (min-width: 64rem) {
    .site-header__row { min-height: 4.25rem; } /* desktop */
  }

  /* --- Brand -------------------------------------------------------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text-primary);
  }
  .brand__mark {
    display: inline-grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-text-on-light);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xs);
    letter-spacing: var(--letter-spacing-tight);
  }
  .brand__word {
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    letter-spacing: var(--letter-spacing-ui);
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  /* --- Desktop nav -------------------------------------------------------- */
  .nav-desktop { display: none; }
  @media (min-width: 64rem) {
    .nav-desktop { display: block; justify-self: center; }
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-item { position: relative; }
  .nav-trigger, .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-1);
    background: transparent;
    border: 0;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-ui);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .nav-trigger__chevron { inline-size: 1rem; block-size: 1rem; transition: transform var(--duration-fast) var(--ease-standard); }
  [data-dropdown-trigger][aria-expanded="true"] .nav-trigger__chevron { transform: rotate(180deg); }
  .nav-trigger:hover, .nav-link:hover { color: var(--color-accent-hover); }
  .nav-link[aria-current="page"], .nav-trigger[aria-current="page"] { color: var(--color-accent); }
  .nav-trigger:focus-visible, .nav-link:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 2px;
    border-radius: var(--radius-control);
  }

  /* --- Dropdowns (desktop) ----------------------------------------------- */
  .dropdown {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-start: 0;
    min-inline-size: 16rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    box-shadow: 0 var(--space-2) var(--space-6) rgba(0, 0, 0, 0.45);
    padding: var(--space-2);
    z-index: 60;
  }
  .dropdown--sub {
    inset-block-start: 0;
    inset-inline-start: calc(100% + var(--space-1));
    min-inline-size: 14rem;
  }
  .dropdown[hidden] { display: none; }
  .dropdown__list { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .dropdown__sub { position: relative; }
  .dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    inline-size: 100%;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    border: 0;
    border-radius: var(--radius-control);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    text-align: start;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .dropdown-link:hover { background: var(--color-surface-elevated); color: var(--color-accent-hover); }
  .dropdown-link[aria-current="page"] { color: var(--color-accent); }
  .dropdown-link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  .dropdown-link__chevron { inline-size: 1rem; block-size: 1rem; }

  /* --- Actions ------------------------------------------------------------ */
  .header-actions { display: flex; align-items: center; gap: var(--space-3); justify-self: end; }
  .lang-switcher { display: none; }
  @media (min-width: 64rem) { .lang-switcher { display: block; } }

  .book-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    padding-inline: var(--space-4);
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-text-on-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-ui);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .book-cta:hover { background: var(--color-accent-hover); }
  .book-cta:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding: var(--space-2);
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    color: var(--color-text-primary);
    cursor: pointer;
  }
  .menu-toggle:hover { color: var(--color-accent-hover); }
  .menu-toggle:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  .menu-toggle__icon { inline-size: 1.5rem; block-size: 1.5rem; }
  @media (min-width: 64rem) { .menu-toggle { display: none; } }

  /* --- Mobile panel ------------------------------------------------------- */
  .mobile-panel {
    position: fixed;
    inset: 0;
    inset-inline-start: auto;
    inline-size: min(100%, 28rem);
    background: var(--color-surface);
    border-inline-start: 1px solid var(--color-border-subtle);
    overflow-y: auto;
    z-index: 70;
    transform: translateX(100%);
    transition: transform var(--duration-normal) var(--ease-entrance);
  }
  .mobile-panel[hidden] { display: block; transform: translateX(100%); }
  .mobile-panel[data-open] { transform: translateX(0); }
  /* When JS is absent the is:inline script doesn't run, so [hidden] isn't set;
     the panel is visible & static — no transform animation, just open. */
  @media (prefers-reduced-motion: reduce) {
    .mobile-panel, .mobile-panel[data-open], .mobile-panel[hidden] { transition: none; }
  }
  .mobile-panel__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-block-size: 100%;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-5);
  }
  .mobile-nav__group-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-ui);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .mobile-nav__list { margin: 0 0 var(--space-6); padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .mobile-nav__branch { display: grid; gap: var(--space-1); }
  .mobile-link {
    display: block;
    padding: var(--space-3) var(--space-1);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-block-end: 1px solid var(--color-divider);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .mobile-link--branch { font-weight: var(--font-weight-semibold); }
  .mobile-link--sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    padding-inline-start: var(--space-4);
  }
  .mobile-link:hover { color: var(--color-accent-hover); }
  .mobile-link[aria-current="page"] { color: var(--color-accent); }
  .mobile-link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  .mobile-nav__sub { margin: 0 0 var(--space-2); padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .mobile-panel__actions { display: flex; flex-direction: column; gap: var(--space-4); align-items: stretch; border-block-start: 1px solid var(--color-divider); padding-block-start: var(--space-5); }
  .book-cta--mobile { min-block-size: 3rem; }

  /* --- Skip link (visual until focused) ----------------------------------- */
  .skip-link {
    position: fixed;
    top: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-text-on-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transform: translateY(-150%);
  }
  .skip-link:focus { transform: translateY(0); }
</style>

<script>
  // island: SiteHeader — sticky surface state + dropdowns + mobile menu.
  // FND-ARCH-06: every island entry is wrapped in try/catch so a failure never
  // breaks the page — all links are server-rendered in the DOM already.
  try {
    const header = document.querySelector<HTMLElement>("[data-site-header]");

    // --- Sticky / transparent-over-hero surface state ----------------------
    if (header) {
      const onScroll = () => {
        const scrolled = window.scrollY > 8;
        header.setAttribute("data-state", scrolled ? "scrolled" : "top");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    // --- Generic dropdown system (desktop) --------------------------------
    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger]"),
    );
    const getPanel = (trigger: HTMLButtonElement): HTMLElement | null => {
      const id = trigger.getAttribute("aria-controls");
      return id ? document.getElementById(id) : null;
    };
    const openPanel = (trigger: HTMLButtonElement): void => {
      const panel = getPanel(trigger);
      if (!panel) return;
      panel.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
    };
    const closePanel = (trigger: HTMLButtonElement, restoreFocus = false): void => {
      const panel = getPanel(trigger);
      if (!panel) return;
      // Close any nested open dropdown first.
      panel.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
        .forEach((t) => closePanel(t));
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger.focus();
    };
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const expanded = trigger.getAttribute("aria-expanded") === "true";
        if (expanded) {
          closePanel(trigger, true);
          return;
        }
        // Close sibling dropdowns at the same level (other top-level items),
        // keep ancestor panels open.
        const parentList = trigger.closest("ul");
        if (parentList) {
          parentList
            .querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
            .forEach((t) => { if (t !== trigger) closePanel(t); });
        }
        openPanel(trigger);
        // Focus first item for keyboard users.
        const panel = getPanel(trigger);
        const first = panel?.querySelector<HTMLElement>("a, button");
        first?.focus();
      });
    });

    // Click outside closes all top-level dropdowns.
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-dropdown]") || target.closest("[data-dropdown-trigger]")) return;
      document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
        .forEach((t) => { if (!t.closest("[data-dropdown] [data-dropdown]")) closePanel(t); });
    });

    // Escape closes innermost open dropdown, then mobile menu, restoring focus.
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openTop = document.querySelectorAll<HTMLButtonElement>(
        "[data-dropdown-trigger][aria-expanded='true']",
      );
      if (openTop.length) {
        const inner = openTop[openTop.length - 1];
        closePanel(inner, true);
        event.preventDefault();
        return;
      }
      // Delegate to mobile menu close if open.
      mobileClose();
    });

    // --- Mobile menu ------------------------------------------------------
    const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const mobilePanel = document.getElementById("hdr-mobile");
    let lastFocused: HTMLElement | null = null;

    function mobileOpen(): void {
      if (!menuToggle || !mobilePanel) return;
      lastFocused = document.activeElement as HTMLElement;
      mobilePanel.removeAttribute("hidden");
      mobilePanel.setAttribute("data-open", "");
      menuToggle.setAttribute("aria-expanded", "true");
      const closeLabel = menuToggle.getAttribute("data-close-label");
      if (closeLabel) menuToggle.setAttribute("aria-label", closeLabel);
      document.body.style.overflow = "hidden";
      const first = mobilePanel.querySelector<HTMLElement>("a, button");
      first?.focus();
    }
    function mobileClose(restoreFocus = true): void {
      if (!menuToggle || !mobilePanel) return;
      if (menuToggle.getAttribute("aria-expanded") !== "true") return;
      mobilePanel.removeAttribute("data-open");
      mobilePanel.setAttribute("hidden", "");
      menuToggle.setAttribute("aria-expanded", "false");
      const menuLabel = menuToggle.getAttribute("data-menu-label");
      if (menuLabel) menuToggle.setAttribute("aria-label", menuLabel);
      document.body.style.overflow = "";
      if (restoreFocus && lastFocused) lastFocused.focus();
    }
    if (menuToggle) {
      menuToggle.addEventListener("click", () => {
        const expanded = menuToggle.getAttribute("aria-expanded") === "true";
        expanded ? mobileClose() : mobileOpen();
      });
    }
    // Basic focus trap inside the mobile panel.
    if (mobilePanel) {
      mobilePanel.addEventListener("keydown", (event) => {
        if (event.key !== "Tab") return;
        const focusable = Array.from(
          mobilePanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
        );
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    }
  } catch (e) {
    // FND-ARCH-06: fail open — nav is server-rendered.
  }
</script>
