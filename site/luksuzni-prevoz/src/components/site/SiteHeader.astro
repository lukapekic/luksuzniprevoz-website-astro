---
/**
 * SiteHeader — premium site chrome for the Luxury Transportation homepage V1.
 *
 * Contract: docs/home/home-components/02-site-header.md
 * Blueprint: docs/home/reference/blueprint.md §6 (Header)
 * Tokens: docs/home/home-components/00-token-matrix.md (locked color/space/radius vars)
 * Step 5A Visual Refinement:
 *   - Real logo.webp asset + Cormorant Garamond italic wordmark via BrandLockup
 *   - Transparent warm-black/charcoal overlay at top; solid warm-charcoal on scroll
 *   - Clean PageContainer-spanning geometry without large card shell
 *   - Compact globe + locale dropdown for language switcher
 *   - Restrained Manrope navigation with quiet active states
 *   - Consistent mobile language treatment inside full-height drawer
 *
 * Composite built on foundation primitives (LanguageSwitcher, BrandLockup, Link).
 * All links are server-rendered regardless of JS.
 */
import { getPath } from "@astro-foundation/core/i18n";
import { config } from "../../../foundation.config.ts";
import { routes } from "../../data/routes.ts";
import {
  navigation,
  getNavLabel,
  type NavGroup,
  type NavLeaf,
  type NavBranch,
} from "../../data/navigation.ts";
import { t } from "../../lib/i18n.ts";
import LanguageSwitcher from "../../foundation/ui/LanguageSwitcher.astro";
import BrandLockup from "../../foundation/ui/BrandLockup.astro";
import Link from "../../foundation/ui/Link.astro";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";

interface Props {
  currentRouteKey: RouteKey;
  currentLocale: LocaleCode;
  /**
   * Whether the header sits over the hero at page top, allowing the
   * transparent-over-hero state. Defaults true (homepage).
   */
  overHero?: boolean;
  /**
   * Prefix for the header's internal DOM IDs.
   */
  idPrefix?: string;
}

const {
  currentRouteKey,
  currentLocale,
  overHero = true,
  idPrefix = "hdr",
} = Astro.props;

const defaultLocale = (config.locales.locales.find((l) => l.isDefault)?.code ?? "sr") as LocaleCode;

/** Resolve a route href for the current locale (FND-I18N-03). */
const href = (key: RouteKey): string => getPath(key, currentLocale, routes, defaultLocale);
const homeHref = href("home");

// --- Navigation model ------------------------------------------------------
const servicesGroup = navigation.header.find(
  (item): item is NavGroup => "id" in item && item.id === "services",
);
if (!servicesGroup) throw new Error("SiteHeader: 'services' nav group missing in navigation.ts");

const servicesChildren = servicesGroup.children;
const topLeaves = navigation.header.filter(
  (item): item is NavLeaf => "routeKey" in item && !("children" in item),
);

// --- Book CTA -------------------------------------------------------------
const bookLabel = getNavLabel("book", currentLocale);

// --- UI strings (FND-ARCH-03) ---------------------------------------------
const menuLabel = t("nav.menu", currentLocale);
const closeLabel = t("nav.close", currentLocale);
const mainNavLabel = t("nav.main", currentLocale);
const langLabel = t("nav.language", currentLocale);
const skipLabel = t("a11y.skipToContent", currentLocale);

const isCurrent = (key: RouteKey): boolean => currentRouteKey === key;

// Stable panel IDs for aria-controls wiring
const servicesPanelId = `${idPrefix}-services`;
const subPanelId = (key: string): string => `${idPrefix}-sub-${key}`;
const mobilePanelId = `${idPrefix}-mobile`;

/** Type guard: a dropdown-capable branch (route + children). */
const isBranch = (node: unknown): node is NavBranch =>
  typeof node === "object" && node !== null && "routeKey" in node && "children" in node;

/** Type guard: a plain leaf (route, no children). */
const isLeaf = (node: unknown): node is NavLeaf =>
  typeof node === "object" && node !== null && "routeKey" in node && !("children" in node);

const branches = servicesChildren.filter(isBranch);
const leafServices = servicesChildren.filter(isLeaf);
---

<!-- Skip link target is #main-content -->
<a href="#main-content" class="skip-link" data-skip-link>{skipLabel}</a>

<header
  data-site-header
  data-state="top"
  data-over-hero={overHero ? "true" : "false"}
  class="site-header"
>
  <div class="site-header__shell">
    <div class="site-header__row">
      <!-- Brand: real logo + Cormorant Garamond wordmark (wordmark hidden on compact header) -->
      <BrandLockup locale={currentLocale} href={homeHref} variant="responsive" />

      <!-- Desktop navigation (lg+): Services▾ + top leaves -->
      <nav class="nav-desktop" aria-label={mainNavLabel}>
        <ul class="nav-list" role="list">
          <li class="nav-item" data-dropdown>
            <button
              type="button"
              class="nav-trigger"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls={servicesPanelId}
              data-dropdown-trigger
            >
              <span>{getNavLabel("services", currentLocale)}</span>
              <svg class="nav-trigger__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div id={servicesPanelId} class="dropdown" data-dropdown-panel role="menu" hidden>
              <ul class="dropdown__list" role="list">
                {leafServices.map((item) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      class="dropdown-link"
                      href={href(item.routeKey)}
                      aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                      data-astro-prefetch
                    >
                      {getNavLabel(item.routeKey, currentLocale)}
                    </a>
                  </li>
                ))}
                {branches.map((branch) => (
                  <li class="dropdown__sub" data-dropdown role="none">
                    <button
                      type="button"
                      role="menuitem"
                      class="dropdown-link dropdown-link--branch"
                      aria-haspopup="menu"
                      aria-expanded="false"
                      aria-controls={subPanelId(branch.routeKey)}
                      data-dropdown-trigger
                    >
                      <span>{getNavLabel(branch.routeKey, currentLocale)}</span>
                      <svg class="dropdown-link__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 6 6 6-6 6" />
                      </svg>
                    </button>
                    <div id={subPanelId(branch.routeKey)} class="dropdown dropdown--sub" data-dropdown-panel role="menu" hidden>
                      <ul class="dropdown__list" role="list">
                        {branch.children.map((child) => (
                          <li role="none">
                            <a
                              role="menuitem"
                              class="dropdown-link"
                              href={href(child.routeKey)}
                              aria-current={isCurrent(child.routeKey) ? "page" : undefined}
                              data-astro-prefetch
                            >
                              {getNavLabel(child.routeKey, currentLocale)}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </li>
          {topLeaves.map((item) => (
            <li class="nav-item">
              <a
                class="nav-link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Actions: language switcher dropdown + Book CTA + mobile trigger -->
      <div class="header-actions">
        <LanguageSwitcher
          currentLocale={currentLocale}
          currentRouteKey={currentRouteKey}
          class="lang-switcher"
          ariaLabel={langLabel}
          idPrefix={`${idPrefix}-lang`}
        />
        <Link to="contact" variant="cta" size="sm" class="book-cta">
          {bookLabel}
        </Link>
        <button
          type="button"
          class="menu-toggle"
          aria-expanded="false"
          aria-controls={mobilePanelId}
          aria-label={menuLabel}
          data-menu-toggle
          data-menu-label={menuLabel}
          data-close-label={closeLabel}
        >
          <svg class="menu-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

{/* No-JS fail-open (FND-ARCH-06): the mobile panel ships [hidden] so it never
   leaks into desktop states or flash-renders before hydration. Without JS this
   <noscript> rule reveals it as a full-viewport navigation surface; with JS it
   is opened on demand by the menu toggle. The panel is a SIBLING of <header>,
   not a descendant: the header's backdrop-filter would otherwise become the
   containing block for position: fixed and clip the panel to the header box
   instead of the viewport. */}
<noscript>
  <style>@media (max-width:63.98rem){[data-mobile-panel]{display:block !important}}</style>
</noscript>

<!-- Mobile full-viewport menu panel (sibling of the header; fixed to viewport) -->
<div id={mobilePanelId} class="mobile-panel" data-mobile-panel role="dialog" aria-modal="true" aria-label={mainNavLabel} hidden>
    <div class="mobile-panel__inner">
      <div class="mobile-panel__header">
        <BrandLockup locale={currentLocale} href={homeHref} variant="mark-only" />
        <button
          type="button"
          class="menu-close-btn"
          aria-label={closeLabel}
          data-menu-close
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="mobile-nav" aria-label={mainNavLabel}>
        <p class="mobile-nav__group-label">{getNavLabel("services", currentLocale)}</p>
        <ul class="mobile-nav__list" role="list">
          {leafServices.map((item) => (
            <li>
              <a
                class="mobile-link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
          {branches.map((branch) => (
            <li class="mobile-nav__branch">
              <a
                class="mobile-link mobile-link--branch"
                href={href(branch.routeKey)}
                aria-current={isCurrent(branch.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(branch.routeKey, currentLocale)}
              </a>
              <ul class="mobile-nav__sub" role="list">
                {branch.children.map((child) => (
                  <li>
                    <a
                      class="mobile-link mobile-link--sub"
                      href={href(child.routeKey)}
                      aria-current={isCurrent(child.routeKey) ? "page" : undefined}
                      data-astro-prefetch
                    >
                      {getNavLabel(child.routeKey, currentLocale)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>

        <ul class="mobile-nav__list mobile-nav__list--pages" role="list">
          {topLeaves.map((item) => (
            <li>
              <a
                class="mobile-link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-panel__actions">
        <div class="mobile-lang-wrap">
          <LanguageSwitcher
            currentLocale={currentLocale}
            currentRouteKey={currentRouteKey}
            ariaLabel={langLabel}
            idPrefix={`${idPrefix}-m-lang`}
          />
        </div>
        <Link to="contact" variant="cta" size="sm" class="book-cta book-cta--mobile w-full">
          {bookLabel}
        </Link>
      </div>
    </div>
  </div>

<style>
  /* --- Shell & sticky surface states -------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Default = solid (no-JS safe). Scrolled is warm charcoal with high opacity + subtle divider */
    background: color-mix(in oklab, var(--color-background) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--color-border-subtle);
    transition: background var(--duration-normal) var(--ease-standard),
                border-color var(--duration-normal) var(--ease-standard);
  }

  /* Top / overlay state: translucent warm-black / charcoal over hero */
  .site-header[data-over-hero="true"][data-state="top"] {
    background: color-mix(in oklab, var(--color-background) 45%, transparent);
    border-block-end-color: color-mix(in oklab, var(--color-border-subtle) 30%, transparent);
  }

  /* Scrolled state: increased opacity warm charcoal */
  .site-header[data-state="scrolled"] {
    background: color-mix(in oklab, var(--color-background) 96%, transparent);
    border-block-end-color: var(--color-border-subtle);
  }

  .site-header__shell {
    width: min(calc(100% - (2 * var(--gutter-page))), var(--container-main));
    margin-inline: auto;
  }
  .site-header__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    /* Tracks --site-header-height (minus the 1px header border) so the header's
       own min-height and the page-level hero-under-header offset share ONE
       source of truth. */
    min-height: calc(var(--site-header-height) - 1px);
    padding-block: var(--space-2);
  }
  @media (min-width: 64rem) {
    .site-header__row {
      gap: var(--space-6);
    }
  }

  /* --- Desktop nav -------------------------------------------------------- */
  .nav-desktop { display: none; }
  @media (min-width: 64rem) {
    .nav-desktop { display: block; justify-self: center; }
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-item { position: relative; }
  .nav-trigger, .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2);
    background: transparent;
    border: 0;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-ui);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .nav-trigger__chevron {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  [data-dropdown-trigger][aria-expanded="true"] .nav-trigger__chevron { transform: rotate(180deg); }
  .nav-trigger:hover, .nav-link:hover { color: var(--color-accent-hover); }
  .nav-link[aria-current="page"], .nav-trigger[aria-current="page"] { color: var(--color-accent); }
  .nav-trigger:focus-visible, .nav-link:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 2px;
    border-radius: var(--radius-control);
  }

  /* --- Dropdowns (desktop) ----------------------------------------------- */
  /* Intrinsic max-content sizing: the panel fits its longest label without
     wrapping, floored by a rem min and capped so a long single label cannot
     blow out into a mega menu. No arbitrary pixel widths. */
  .dropdown {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-start: 0;
    inline-size: max-content;
    min-inline-size: 16rem;
    max-inline-size: 26rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    padding: var(--space-2);
    z-index: 60;
  }
  .dropdown--sub {
    inset-block-start: 0;
    inset-inline-start: calc(100% + var(--space-1));
    inline-size: max-content;
    min-inline-size: 15rem;
    max-inline-size: 24rem;
  }
  /* Transparent pointer bridge that fills the small visual gap between a branch
     row and its flyout, so the non-bubbling pointerleave on the branch region
     does not fire while the pointer transits the gap (no dead zone). */
  .dropdown--sub::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-end: 100%;
    inline-size: var(--space-1);
  }
  .dropdown[hidden] { display: none; }
  .dropdown__list { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .dropdown__sub { position: relative; }
  .dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    inline-size: 100%;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 0;
    border-radius: var(--radius-control);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    text-align: start;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .dropdown-link:hover {
    background: var(--color-surface);
    color: var(--color-accent-hover);
  }
  .dropdown-link[aria-current="page"] {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
  .dropdown-link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  .dropdown-link__chevron { inline-size: 0.875rem; block-size: 0.875rem; color: var(--color-text-muted); }

  /* --- Actions ------------------------------------------------------------ */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: end;
  }
  .lang-switcher { display: none; }
  @media (min-width: 64rem) { .lang-switcher { display: block; } }

  .book-cta--mobile { min-block-size: 3rem; }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding: var(--space-2);
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .menu-toggle:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-input-border);
  }
  .menu-toggle:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  .menu-toggle__icon { inline-size: 1.5rem; block-size: 1.5rem; }
  @media (min-width: 64rem) { .menu-toggle { display: none; } }

  /* --- Mobile panel -------------------------------------------------------
     Full-viewport navigation surface (Step 5C). The panel is a SIBLING of the
     header (rendered outside <header> in the component) so its position: fixed
     resolves against the viewport, not the header — the header's
     backdrop-filter would otherwise become the containing block and clip the
     panel to the header box. It ships [hidden] (display: none) so it can never
     leak into desktop states or flash before hydration; a <noscript> rule in
     the component reveals it for no-JS fail-open. 100dvh covers the dynamic
     viewport height (100vh fallback); overflow-y scrolls long menus. The
     [hidden] rule is intentionally separate and sets display: none only — no
     more-specific rule overrides it. */
  .mobile-panel[hidden] { display: none; }
  .mobile-panel {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 100vh;
    block-size: 100dvh;
    background: var(--color-surface-elevated);
    overflow-y: auto;
    z-index: 70;
  }
  .mobile-panel__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-block-size: 100%;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-5);
  }
  /* Desktop (lg+): the mobile dialog is visually unavailable even if stale JS
     state accidentally leaves it un-hidden (e.g. menu opened on a narrow
     viewport that then widened). The toggle is already hidden at this
     breakpoint, so this is a defense-in-depth guard. The dev /dev/ui open-frame
     override raises specificity (display:block) to keep the simulated-mobile
     preview working at a desktop browser viewport. */
  @media (min-width: 64rem) {
    .mobile-panel { display: none; }
  }
  .mobile-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-divider);
  }
  .menu-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
    padding: var(--space-2);
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    color: var(--color-text-primary);
    cursor: pointer;
  }
  .menu-close-btn:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-input-border);
  }
  .menu-close-btn:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }

  .mobile-nav__group-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-ui);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .mobile-nav__list { margin: 0 0 var(--space-6); padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .mobile-nav__branch { display: grid; gap: var(--space-1); }
  .mobile-link {
    display: block;
    padding: var(--space-3) var(--space-1);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-block-end: 1px solid var(--color-divider);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .mobile-link--branch { font-weight: var(--font-weight-semibold); }
  .mobile-link--sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    padding-inline-start: var(--space-4);
  }
  .mobile-link:hover { color: var(--color-accent-hover); }
  .mobile-link[aria-current="page"] { color: var(--color-accent); }
  .mobile-link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  .mobile-nav__sub { margin: 0 0 var(--space-2); padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .mobile-panel__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: stretch;
    border-block-start: 1px solid var(--color-divider);
    padding-block-start: var(--space-5);
  }
  .mobile-lang-wrap {
    display: flex;
    justify-content: flex-start;
  }

  /* --- Skip link ---------------------------------------------------------- */
  .skip-link {
    position: fixed;
    top: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-text-on-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transform: translateY(-150%);
  }
  .skip-link:focus { transform: translateY(0); }
</style>

<style is:global>
  /* --site-header-height: the single source of truth for the header's total
     height (row min-height + the 1px header border). The homepage uses it to
     pull its full-bleed hero up under the overlaid sticky header so the hero
     media starts at the page top behind the header chrome (the header's
     z-index keeps it above the media). Defined globally because the hero is a
     later sibling, not a descendant of the header. Mirrors the
     .site-header__row min-heights (4rem mobile / 4.5rem desktop) + 1px. */
  :root {
    --site-header-height: calc(4rem + 1px);
  }
  @media (min-width: 64rem) {
    :root {
      --site-header-height: calc(4.5rem + 1px);
    }
  }
</style>

<script>
  // island: SiteHeader — sticky surface state + dropdowns + mobile menu.
  try {
    const header = document.querySelector<HTMLElement>("[data-site-header]");

    // --- Sticky / transparent-over-hero surface state ----------------------
    if (header) {
      const onScroll = () => {
        const scrolled = window.scrollY > 8;
        header.setAttribute("data-state", scrolled ? "scrolled" : "top");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    // --- Dropdown system (desktop + language) ------------------------------
    // Interaction model:
    //   - Pointer (hover): non-bubbling pointerenter/pointerleave on each
    //     [data-dropdown] REGION (trigger + panel subtree). Entering a region
    //     opens its panel; leaving schedules a short close. Because the panel is
    //     a DOM descendant of its region, pointerleave does NOT fire while
    //     moving trigger→panel or row→flyout — no dead gap, no child-bubbling
    //     closures. A transparent ::before bridge on sub-panels covers the
    //     visual offset gap structurally; a 120ms cancellable close is only a
    //     safety net, never the primary mechanism.
    //   - Click/keyboard: toggles, focuses first item, Escape closes innermost,
    //     outside-click closes all. Hover is additive, never the only path.
    //   - Only one unrelated top-level dropdown open at a time (Services vs
    //     language). Nested branches are siblings under the Services root.
    //   - [data-dropdown-static] regions (dev-preview pinned states) are skipped
    //     by hover/outside-click/escape so previews stay open.
    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger]"),
    );
    const regions = Array.from(
      document.querySelectorAll<HTMLElement>("[data-dropdown]"),
    );
    const getPanel = (trigger: HTMLButtonElement): HTMLElement | null => {
      const id = trigger.getAttribute("aria-controls");
      return id ? document.getElementById(id) : null;
    };
    /** A region's own direct-child trigger (Services button, branch button, language button). */
    const ownTrigger = (region: Element): HTMLButtonElement | null =>
      region.querySelector<HTMLElement>(":scope > [data-dropdown-trigger]") as HTMLButtonElement | null;
    /** Top-level = no ancestor [data-dropdown] (Services root, language). Branches are nested. */
    const isTopLevel = (region: Element): boolean =>
      !region.parentElement?.closest("[data-dropdown]");
    const isStatic = (el: Element | null): boolean =>
      !!el && !!el.closest("[data-dropdown-static]");

    const openPanel = (trigger: HTMLButtonElement): void => {
      const panel = getPanel(trigger);
      if (!panel) return;
      panel.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
    };
    const closePanel = (trigger: HTMLButtonElement, restoreFocus = false): void => {
      const panel = getPanel(trigger);
      if (!panel) return;
      // Close any nested open dropdown first (Services root closes its branches).
      panel.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
        .forEach((t) => closePanel(t));
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger.focus();
    };

    // Close every open top-level dropdown whose region is not `keep` (and not pinned).
    const closeOtherTopLevel = (keep: Element): void => {
      document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
        .forEach((t) => {
          if (keep.contains(t)) return;
          const r = t.closest("[data-dropdown]");
          if (r && isTopLevel(r) && !isStatic(r)) closePanel(t);
        });
    };
    // For a nested branch: close sibling branch sub-panels within the same root,
    // keeping the root Services panel and this branch's own panel open.
    const closeSiblingBranches = (branch: Element): void => {
      const root = branch.parentElement?.closest("[data-dropdown]");
      if (!root) return;
      const rootTrigger = ownTrigger(root);
      root.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
        .forEach((t) => {
          if (t === rootTrigger) return; // keep Services root open
          if (branch.contains(t)) return; // keep this branch open
          if (isStatic(t)) return; // keep pinned dev regions open
          closePanel(t);
        });
    };

    // --- Pointer-region hover (hover-capable pointers only) ----------------
    let closeTimer: number | undefined;
    const cancelClose = (): void => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = undefined; }
    };
    const scheduleClose = (region: Element): void => {
      cancelClose();
      closeTimer = window.setTimeout(() => {
        region.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
          .forEach((t) => closePanel(t));
      }, 120);
    };

    const supportsHover =
      typeof window.matchMedia === "function" &&
      window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (supportsHover) {
      regions.forEach((region) => {
        const trigger = ownTrigger(region);
        if (!trigger) return;
        region.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "mouse" || isStatic(region)) return;
          cancelClose();
          if (isTopLevel(region)) closeOtherTopLevel(region);
          else closeSiblingBranches(region);
          if (trigger.getAttribute("aria-expanded") !== "true") openPanel(trigger);
        });
        region.addEventListener("pointerleave", (event) => {
          if (event.pointerType !== "mouse" || isStatic(region)) return;
          scheduleClose(region);
        });
      });
    }

    // --- Click / activation (toggle; keyboard reaches via Tab + Enter) -----
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        if (isStatic(trigger)) return; // dev-preview pinned state
        const expanded = trigger.getAttribute("aria-expanded") === "true";
        if (expanded) {
          closePanel(trigger, true);
          return;
        }
        const region = trigger.closest("[data-dropdown]");
        if (region) {
          if (isTopLevel(region)) closeOtherTopLevel(region);
          else closeSiblingBranches(region);
        }
        cancelClose();
        openPanel(trigger);
        const panel = getPanel(trigger);
        const first = panel?.querySelector<HTMLElement>("a, button");
        first?.focus();
      });
    });

    // Click outside closes all open (non-pinned) dropdowns
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (isStatic(target)) return;
      if (target.closest("[data-dropdown]") || target.closest("[data-dropdown-trigger]")) return;
      document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']")
        .forEach((t) => { if (!isStatic(t)) closePanel(t); });
    });

    // Escape closes innermost open dropdown (restoring focus), then mobile menu
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openTop = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger][aria-expanded='true']"),
      ).filter((t) => !isStatic(t));
      if (openTop.length) {
        const inner = openTop[openTop.length - 1];
        closePanel(inner, true);
        event.preventDefault();
        return;
      }
      mobileClose();
    });

    // --- Mobile menu -------------------------------------------------------
    const menuToggles = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-menu-toggle]"),
    );
    const menuCloses = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-menu-close]"),
    );
    let activeMobile: { toggle: HTMLButtonElement; panel: HTMLElement; lastFocused: HTMLElement | null } | null = null;

    function mobileOpen(toggle: HTMLButtonElement, panel: HTMLElement): void {
      if (activeMobile && activeMobile.toggle !== toggle) mobileClose(activeMobile);
      const lastFocused = document.activeElement as HTMLElement;
      activeMobile = { toggle, panel, lastFocused };
      panel.removeAttribute("hidden");
      panel.setAttribute("data-open", "");
      toggle.setAttribute("aria-expanded", "true");
      const closeLabel = toggle.getAttribute("data-close-label");
      if (closeLabel) toggle.setAttribute("aria-label", closeLabel);
      document.body.style.overflow = "hidden";
      const first = panel.querySelector<HTMLElement>("a, button");
      first?.focus();
    }
    function mobileClose(ctx = activeMobile, restoreFocus = true): void {
      if (!ctx) return;
      const { toggle, panel, lastFocused } = ctx;
      panel.removeAttribute("data-open");
      panel.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
      const menuLabel = toggle.getAttribute("data-menu-label");
      if (menuLabel) toggle.setAttribute("aria-label", menuLabel);
      document.body.style.overflow = "";
      if (restoreFocus && lastFocused) lastFocused.focus();
      if (activeMobile === ctx) activeMobile = null;
    }
    menuToggles.forEach((toggle) => {
      const panelId = toggle.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;
      toggle.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        expanded ? mobileClose() : mobileOpen(toggle, panel);
      });
      panel.addEventListener("keydown", (event) => {
        if (event.key !== "Tab") return;
        const focusable = Array.from(
          panel.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
        );
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    });
    menuCloses.forEach((closeBtn) => {
      closeBtn.addEventListener("click", () => {
        mobileClose();
      });
    });
  } catch (e) {
    // fail open
  }
</script>
