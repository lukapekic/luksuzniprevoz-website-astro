---
/**
 * LeafPage — shared renderer for non-home content pages (service / hub /
 * fleet / pricing / about / contact archetypes).
 *
 * Extracted from the leaf route files so the default-locale (unprefixed) and
 * non-default-locale (prefixed) leaf routes share one rendering path. The
 * route files own only `getStaticPaths` (via lib/pages.ts buildLeafStaticPaths)
 * + the typed props; this component owns the breadcrumb/heading/prose shell.
 *
 * FND-ARCH-03: all text from the UI dictionary via `t()`. FND-I18N-03: every
 * URL via getPath (Breadcrumbs/Link), never string-built. Uses Page, Container,
 * Section, Breadcrumbs primitives via BaseLayout.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import Section from "../../foundation/ui/Section.astro";
import Breadcrumbs from "../../foundation/ui/Breadcrumbs.astro";
import { buildPageSeo } from "../../lib/seo.ts";
import { t } from "../../lib/i18n.ts";
import type { RouteKey, LocaleCode, UiStringKey } from "@astro-foundation/core";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  routeKey: RouteKey;
  locale: LocaleCode;
  content: CollectionEntry<"pages">;
}

const { routeKey, locale: currentLocale, content } = Astro.props;

// All text from UI strings dictionary (FND-ARCH-03)
const pageTitle = t(`${routeKey}.title` as UiStringKey, currentLocale);
const breadcrumbHome = t("home.title", currentLocale);

// FND-LIFE-02: non-published pages in a dev/preview build are noindex.
const isUnpublishedPreview = content.data.status !== "published" && !import.meta.env.PROD;

// Build SEO data
const seo = buildPageSeo({
  routeKey,
  locale: currentLocale,
  title: content.data.seoTitle ?? pageTitle,
  description: content.data.seoDescription ?? "",
  noindex: (content.data.noindex ?? false) || isUnpublishedPreview,
});

// Build breadcrumbs
const breadcrumbs = [
  { routeKey: "home" as RouteKey, label: breadcrumbHome },
  { routeKey, label: pageTitle },
];

// Render content — Astro 5's render() returns a `Content` component plus
// headings/remarkPluginFrontmatter (not an `.html` string). Render the
// component directly so it slots into the prose container.
const { Content } = await render(content);
---

<BaseLayout seo={seo} currentRouteKey={routeKey} currentLocale={currentLocale}>
  <PageContainer class="py-[var(--space-4)]">
    <Breadcrumbs items={breadcrumbs} ariaLabel={t("nav.breadcrumb", currentLocale)} />
  </PageContainer>

  <Section id="content" class="py-[var(--space-8)]">
    <PageContainer>
      <h1 class="font-heading text-[length:var(--text-h1)] font-bold">
        {content.data.h1}
      </h1>
      {content.data.intro && (
        <p class="mt-[var(--space-4)] font-body text-[length:var(--text-xl)] text-[var(--color-text-muted)]">
          {content.data.intro}
        </p>
      )}

      <div class="mt-[var(--space-8)] prose prose-[var(--color-text-primary)] max-w-none">
        <Content />
      </div>
    </PageContainer>
  </Section>
</BaseLayout>
