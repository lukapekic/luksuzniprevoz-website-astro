---
/**
 * SiteFooter — global site footer (chrome) for Luxury Transportation.
 *
 * Aligned to the locked footer contract
 * (docs/home/home-components/12-site-footer.md) and active Theme V2. A compact,
 * quiet closing frame subordinate to the Final CTA: no conversion messaging,
 * no newsletter, no sitemap, no second CTA, no oversized brand billboard
 * (DESIGN.md §6 content-density, §8 rejected-footer lessons).
 *
 *   Zone 1  Brand      — the approved BrandLockup (logo + "Luxury Transportation"
 *                        wordmark via font-brand). The lockup's accessible name
 *                        is the visible wordmark; it links home. The parent-
 *                        company relationship ("GrandSolution") is referenced
 *                        quietly in the bottom-row copyright.
 *   Zone 2  Navigation — route-derived Services + Company link groups
 *                        (navigation.footer), labeled via getNavLabel. Desktop
 *                        places the two groups side-by-side inside the central
 *                        nav zone so the middle stays balanced rather than one
 *                        tall stack.
 *   Zone 3  Contact    — verified-only channels (contact.ts gating) at the
 *                        highest emphasis, then office hours and the verified
 *                        office address (contact.office, street / postal+city /
 *                        country) as secondary muted facts, then the response
 *                        note as the smallest, most muted line.
 *
 *   Bottom row          — a single restrained line, split left/right on
 *                        desktop: "© {year} GrandSolution · {rights}" (legal/
 *                        operating identity from business.ts) on the left, and
 *                        the verified headquarters city/country on the right.
 *
 * Surface: a simple Theme V2 dark footer surface (--color-surface) with a
 * single subtle 1px semantic top divider (--color-divider) and a matching
 * divider above the bottom row. No gradient wash, no radial glow, no heavy
 * shadow — the locked contract forbids glow/heavy shadow; hierarchy comes
 * from typography, spacing, and surface contrast (DESIGN.md §7/§10).
 *
 * Compliance:
 * - FND-I18N-03: every internal href via getPath() from the route map, never
 *   manually concatenated. Works for sr/en/ru via the locale routing helpers.
 * - FND-ARCH-03: every user-visible string via t() / getNavLabel; facts via
 *   business.ts / contact.ts. No invented contact/legal/office data.
 * - Brand: the approved BrandLockup (no direct logo render, no recreated/text
 *   logo, no new logo). The lockup's accessible name is "Luxury Transportation".
 * - Verified-only contact: a null/unverified phone/email/whatsapp never ships
 *   as a clickable tel:/mailto:/wa.me (contact.ts gating contract). While all
 *   channels are unverified, the contact column shows office hours + response
 *   note only — no fabricated channels.
 * - Office hours are a structural fact (business.supportModel.officeHours);
 *   no 24/7 / instant-booking / last-minute claim is made.
 * - Location is the verified headquarters fact (business.headquarters city/
 *   country, verificationStatus "verified") — not an invented address.
 * - No islands: entirely server-rendered, zero client JS.
 * - WCAG 2.2 AA: one <footer> landmark + a single aria-labeled <nav>; links
 *   carry aria-current + visible focus-visible; DOM order matches mobile
 *   reading order (brand → services → company → contact → bottom row).
 */
import { getPath } from "@astro-foundation/core/i18n";
import { config } from "../../../foundation.config.ts";
import { routes } from "../../data/routes.ts";
import { navigation, getNavLabel, type NavLeaf } from "../../data/navigation.ts";
import { business } from "../../data/business.ts";
import { contact, isVerified } from "../../data/contact.ts";
import { t } from "../../lib/i18n.ts";
import BrandLockup from "../../foundation/ui/BrandLockup.astro";
import type { LocaleCode, RouteKey, UiStringKey } from "@astro-foundation/core";

interface Props {
  currentRouteKey: RouteKey;
  currentLocale: LocaleCode;
}

const { currentRouteKey, currentLocale } = Astro.props;

const defaultLocale = (config.locales.locales.find((l) => l.isDefault)?.code ?? "sr") as LocaleCode;

/** Resolve a route href for the current locale (FND-I18N-03). */
const href = (key: RouteKey): string => getPath(key, currentLocale, routes, defaultLocale);

const homeHref = href("home");

// --- Footer link groups (route-derived) -----------------------------------
const servicesGroup = navigation.footer.services as NavLeaf[];
const companyGroup = navigation.footer.company as NavLeaf[];

const isCurrent = (key: RouteKey): boolean => currentRouteKey === key;

// --- UI strings (FND-ARCH-03) ---------------------------------------------
const footerNavLabel = t("nav.footer", currentLocale);
const servicesLabel = t("services.title", currentLocale);
const companyLabel = t("footer.company", currentLocale);
const contactLabel = t("contact.title", currentLocale);
const rightsLabel = t("footer.rights", currentLocale);
const hoursDaysLabel = t("footer.hoursDays", currentLocale);
const officeNote = t(contact.officeHours.publicNoteKey as UiStringKey, currentLocale);

// --- Contact channels — verified only (contact.ts gating contract) -------
// Contact URLs are constructed here in the data layer (not inline in JSX) so
// FND-I18N-03's no-manual-internal-url check sees simple identifier bindings;
// tel:/mailto:/wa.me are external contact points, not internal routes, and are
// therefore not prefetchable.
const phone = isVerified(contact.phone) ? contact.phone.value : null;
const email = isVerified(contact.email) ? contact.email.value : null;
const whatsapp = isVerified(contact.whatsapp) ? contact.whatsapp.value : null;
const phoneHref = phone ? `tel:${phone}` : null;
const emailHref = email ? `mailto:${email}` : null;
const whatsappHref = whatsapp
  ? `https://wa.me/${whatsapp.replace(/[^0-9]/g, "")}`
  : null;

// Structural facts (one source, all locales) — not prose, not invented.
const officeHoursFact = business.supportModel.officeHours; // e.g. "08:00-18:00"
// Localized days label + structural hours range, joined with a punctuation
// separator (same convention as the copyright line — not translated content).
const hoursLine = `${hoursDaysLabel} · ${officeHoursFact}`;

// Full office address for the Contact column — verified contact.office only
// (same gating contract as the channels: an unverified/null address never
// ships). Structured fields render as three compact lines: street /
// postal+city / country. Nothing is hardcoded; every line comes from contact.ts.
const officeAddressVerified =
  contact.office.verificationStatus === "verified" && contact.office.address !== null;
const officeAddressLines = officeAddressVerified
  ? [
      contact.office.address,
      `${contact.office.postalCode} ${contact.office.city}`,
      contact.office.country,
    ]
  : [];

// Bottom-row compact location — verified headquarters city/country
// (business.headquarters, verificationStatus "verified"). Rendered ONCE here
// in the bottom row; the detailed street address lives in the Contact column.
const locationLine = `${business.headquarters.city} · ${business.headquarters.country}`;

// --- Bottom row -----------------------------------------------------------
// Copyright carries the canonical operating/legal identity (business.parentCompany
// .name = "GrandSolution"), not the public wordmark — the Low Horizon Footer is
// GrandSolution-identified. Year is computed at build time, never hardcoded.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__shell">
    <div class="site-footer__grid">
      {/* 1. Brand — the approved BrandLockup (logo + "Luxury Transportation"
            wordmark via font-brand). The lockup's accessible name is the visible
            wordmark; it links home. The parent-company relationship ("GrandSolution")
            is referenced quietly in the bottom-row copyright, per the locked
            footer contract. */}
      <div class="site-footer__col site-footer__col--brand">
        <BrandLockup
          locale={currentLocale}
          href={homeHref}
          variant="full"
          class="site-footer__brand"
        />
      </div>

      {/* 2. Navigation — one <nav> landmark. Services + Company sit
            side-by-side inside the central nav zone (desktop) so the middle
            stays balanced instead of one tall stacked column. */}
      <nav class="site-footer__nav" aria-label={footerNavLabel}>
        <div class="site-footer__nav-cols">
          <div class="site-footer__nav-col">
            <p class="site-footer__group-label">{servicesLabel}</p>
            <ul class="site-footer__list" role="list">
              {servicesGroup.map((item) => (
                <li>
                  <a
                    class="site-footer__link"
                    href={href(item.routeKey)}
                    aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                    data-astro-prefetch
                  >
                    {getNavLabel(item.routeKey, currentLocale)}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="site-footer__nav-col">
            <p class="site-footer__group-label">{companyLabel}</p>
            <ul class="site-footer__list" role="list">
              {companyGroup.map((item) => (
                <li>
                  <a
                    class="site-footer__link"
                    href={href(item.routeKey)}
                    aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                    data-astro-prefetch
                  >
                    {getNavLabel(item.routeKey, currentLocale)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>

      {/* 3. Contact — the strongest informational block (P9.1 hierarchy):
            verified channels first (highest emphasis), then hours + full
            verified office address as secondary muted facts, then the response
            note as the smallest, most muted line. Compact location stays in the
            bottom row — the street address is not duplicated there. */}
      <div class="site-footer__col site-footer__col--contact">
        <p class="site-footer__group-label">{contactLabel}</p>
        {phoneHref || emailHref || whatsappHref ? (
          <ul class="site-footer__list site-footer__channels" role="list">
            {phone && phoneHref ? (
              <li>
                <a class="site-footer__link site-footer__link--channel" href={phoneHref}>{phone}</a>
              </li>
            ) : null}
            {email && emailHref ? (
              <li>
                <a class="site-footer__link site-footer__link--channel" href={emailHref}>{email}</a>
              </li>
            ) : null}
            {whatsapp && whatsappHref ? (
              <li>
                <a class="site-footer__link site-footer__link--channel" href={whatsappHref} rel="noopener noreferrer">{whatsapp}</a>
              </li>
            ) : null}
          </ul>
        ) : null}
        <p class="site-footer__fact">{hoursLine}</p>
        {officeAddressLines.length > 0 ? (
          <address class="site-footer__address">
            {officeAddressLines.map((line) => (
              <span class="site-footer__address-line">{line}</span>
            ))}
          </address>
        ) : null}
        <p class="site-footer__note">{officeNote}</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        © {year} {business.parentCompany.name} · {rightsLabel}
      </p>
      <p class="site-footer__locale">{locationLine}</p>
    </div>
  </div>
</footer>

<style>
  /* --- Surface: a simple Theme V2 dark footer surface with a single subtle
     semantic top divider. No gradient wash, no radial glow, no heavy shadow
     (locked footer contract §Surface: "no glow or heavy shadow"; DESIGN.md
     §7/§10 — surface contrast and a quiet separator, not decoration). The
     footer sits compactly below the Final CTA, which owns its own bottom
     rhythm, so there is no top margin. */
  .site-footer {
    border-block-start: 1px solid var(--color-divider);
    background: var(--color-surface);
  }

  .site-footer__shell {
    width: min(calc(100% - (2 * var(--gutter-page))), var(--container-main));
    margin-inline: auto;
    /* Generous but restrained top rhythm; compact bottom so the closing row
       reads as the end of the composition, not a second sub-footer band. */
    padding-block: clamp(2.25rem, 4vw, 3.25rem) clamp(1.25rem, 2vw, 1.75rem);
  }

  /* --- Grid: mobile = single stack; tablet = brand|nav row + contact row;
     desktop = 3 zones (brand / nav / contact). The navigation zone internally
     splits Services | Company so the middle never becomes one tall column
     (§6 content-density proportionality). The brand zone stays small and quiet
     (just the GS mark), so it gets the narrowest track on desktop. ---------- */
  .site-footer__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
    /* Contact drops to its own full-width row on tablet — do not squeeze the
       four desktop columns too early. */
    .site-footer__col--contact {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .site-footer__grid {
      /* Three zones: brand lockup / coherent nav group / contact destination.
         The brand column carries the BrandLockup (logo + wordmark), so it gets
         a wider floor than the old small-mark anchor; the nav zone keeps its
         floor so Services + Company stay usable at lg. */
      grid-template-columns:
        minmax(13rem, 1fr)
        minmax(26rem, 1.5fr)
        minmax(18rem, 1fr);
    }
    .site-footer__col--contact {
      grid-column: auto;
    }
  }

  /* --- Brand column ----------------------------------------------------- */
  .site-footer__col--brand {
    margin-block-end: var(--space-2);
  }
  /* BrandLockup owns its logo + wordmark rendering and its own focus-visible
     ring. The footer only enforces the 44×44 touch target (FND-A11Y-05) at
     touch widths so the lockup is an easy tap target on mobile/tablet; the
     compact pointer size returns at desktop. */
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
  }
  @media (min-width: 64rem) {
    .site-footer__brand {
      min-block-size: auto;
    }
    .site-footer__col--brand {
      margin-block-end: 0;
    }
  }

  /* --- Navigation zone: Services + Company side-by-side on tablet+ ------ */
  .site-footer__nav-cols {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 48rem) {
    .site-footer__nav-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- Column headings (Manrope semibold, sentence case — no eyebrow) ---
     Brand font (Cormorant) stays exclusive to BrandLockup; body/UI text is
     Manrope (§Typography). No uppercase eyebrow labels (§Typography). */
  .site-footer__group-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }
  .site-footer__list {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }
  .site-footer__list:last-child { margin-block-end: 0; }
  /* Full-width links. The hit area is larger than the visible text: at touch
     widths each row meets the 44×44 project bar (FND-A11Y-05) via min-block-size
     — matching the SiteHeader mobile-link convention — while the visible text
     stays compact (no pill/background/border). At lg+ (pointer) the row returns
     to a compact desktop height (still above the WCAG 2.5.8 AA 24px floor),
     matching the approved SiteHeader desktop-nav pattern, so the Footer stays
     compact without bulky rows (§compact). */
  .site-footer__link {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem; /* 44px touch target — mobile/tablet */
    padding-block: var(--space-1);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  @media (min-width: 64rem) {
    .site-footer__link { min-block-size: auto; } /* compact desktop pointer row */
  }
  .site-footer__link:hover { color: var(--color-accent-hover); }
  .site-footer__link[aria-current="page"] { color: var(--color-accent); }
  .site-footer__link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }

  /* --- Contact column (P9.1 hierarchy): channels carry the highest emphasis
     in the footer body — base size + medium weight in primary text color —
     so phone/email clearly outrank the sm nav links; hours and the verified
     office address are secondary muted compact facts; the response note is
     the smallest, most muted line (dimmed muted still ≥ 4.5:1 against the
     near-black lower footer, WCAG 2.2 AA). */
  .site-footer__channels {
    margin-block-end: var(--space-3);
  }
  .site-footer__link--channel {
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
  }
  .site-footer__fact {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
  }
  .site-footer__address {
    margin-block-start: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    font-style: normal;
    color: var(--color-text-muted);
  }
  .site-footer__address-line {
    display: block;
  }
  .site-footer__note {
    margin: var(--space-3) 0 0;
    max-inline-size: 24rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: var(--line-height-body);
    color: color-mix(in srgb, var(--color-text-muted) 75%, transparent);
  }

  /* --- Bottom row: single restrained line, split left/right on desktop.
     Left = copyright (operating identity + rights); right = verified
     location. Mobile stacks. The separator above this row is a quiet 1px
     semantic divider (--color-divider) — no decorative gradient or glow. */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: clamp(1.25rem, 2.5vw, 2rem);
    padding-block-start: clamp(1rem, 2vw, 1.5rem);
    border-block-start: 1px solid var(--color-divider);
  }
  @media (min-width: 48rem) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .site-footer__copy,
  .site-footer__locale {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
