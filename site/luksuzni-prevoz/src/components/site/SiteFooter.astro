---
/**
 * SiteFooter — global site footer (chrome) for Luxury Transportation.
 *
 * Compact, dark, 3-column desktop composition that sits immediately below the
 * Final CTA and is deliberately subordinate to it: no conversion messaging,
 * no newsletter, no sitemap, no second CTA (DESIGN.md §6 content-density, §13
 * rejected-footer lessons — "footer made disproportionately tall/empty").
 *
 *   Column 1  Brand       — real BrandLockup (logo.webp + "Luxury
 *                           Transportation" wordmark) + parent-company relation
 *   Column 2  Navigation — route-derived Services + Company link groups
 *                           (navigation.footer), labeled via getNavLabel
 *   Column 3  Contact     — verified-only channels (contact.ts gating) +
 *                           office-hours facts + response note
 *
 * Compliance:
 * - FND-I18N-03: every internal href via getPath() from the route map, never
 *   manually concatenated. Works for sr/en/ru via the locale routing helpers.
 * - FND-ARCH-03: every user-visible string via t() / getNavLabel; facts via
 *   business.ts / contact.ts. No invented contact/legal/office data.
 * - Brand: reuses the approved BrandLockup (variant="full" — wordmark always
 *   visible, the Footer/standalone mode per BrandLockup's contract) — no
 *   second logo or wordmark implementation, no generated monogram square.
 * - Verified-only contact: a null/unverified phone/email/whatsapp never ships
 *   as a clickable tel:/mailto:/wa.me (contact.ts gating contract). While all
 *   channels are unverified, the contact column shows office hours + note only.
 * - Office hours are a structural fact (business.supportModel.officeHours);
 *   no 24/7 / instant-booking / last-minute claim is made (the known project
 *   positioning is not a public 24/7 last-minute service — supportModel
 *   public247SupportClaim is false).
 * - No islands: entirely server-rendered, zero client JS.
 * - WCAG 2.2 AA: one <footer> landmark + a single aria-labeled <nav>; links
 *   carry aria-current + visible focus-visible; DOM order matches mobile
 *   reading order (brand → nav → contact → bottom row).
 */
import { getPath } from "@astro-foundation/core/i18n";
import { config } from "../../../foundation.config.ts";
import { routes } from "../../data/routes.ts";
import { navigation, getNavLabel, type NavLeaf } from "../../data/navigation.ts";
import { business } from "../../data/business.ts";
import { contact, isVerified } from "../../data/contact.ts";
import { t } from "../../lib/i18n.ts";
import BrandLockup from "../../foundation/ui/BrandLockup.astro";
import type { LocaleCode, RouteKey, UiStringKey } from "@astro-foundation/core";

interface Props {
  currentRouteKey: RouteKey;
  currentLocale: LocaleCode;
}

const { currentRouteKey, currentLocale } = Astro.props;

const defaultLocale = (config.locales.locales.find((l) => l.isDefault)?.code ?? "sr") as LocaleCode;

/** Resolve a route href for the current locale (FND-I18N-03). */
const href = (key: RouteKey): string => getPath(key, currentLocale, routes, defaultLocale);

const homeHref = href("home");

// --- Footer link groups (route-derived) -----------------------------------
const servicesGroup = navigation.footer.services as NavLeaf[];
const companyGroup = navigation.footer.company as NavLeaf[];

const isCurrent = (key: RouteKey): boolean => currentRouteKey === key;

// --- UI strings (FND-ARCH-03) ---------------------------------------------
const footerNavLabel = t("nav.footer", currentLocale);
const servicesLabel = t("services.title", currentLocale);
const companyLabel = t("footer.company", currentLocale);
const contactLabel = t("contact.title", currentLocale);
const rightsLabel = t("footer.rights", currentLocale);
const hoursDaysLabel = t("footer.hoursDays", currentLocale);
const officeNote = t(contact.officeHours.publicNoteKey as UiStringKey, currentLocale);
const parentRelation = t(
  business.parentCompany.relationshipDescriptionKey as UiStringKey,
  currentLocale,
);

// --- Contact channels — verified only (contact.ts gating contract) -------
// Contact URLs are constructed here in the data layer (not inline in JSX) so
// FND-I18N-03's no-manual-internal-url check sees simple identifier bindings;
// tel:/mailto:/wa.me are external contact points, not internal routes, and are
// therefore not prefetchable.
const phone = isVerified(contact.phone) ? contact.phone.value : null;
const email = isVerified(contact.email) ? contact.email.value : null;
const whatsapp = isVerified(contact.whatsapp) ? contact.whatsapp.value : null;
const phoneHref = phone ? `tel:${phone}` : null;
const emailHref = email ? `mailto:${email}` : null;
const whatsappHref = whatsapp
  ? `https://wa.me/${whatsapp.replace(/[^0-9]/g, "")}`
  : null;

// Office hours are a structural fact (business.supportModel.officeHours) —
// always present, independent of channel verification.
const officeHoursFact = business.supportModel.officeHours; // e.g. "08:00-18:00"

// --- Bottom row -----------------------------------------------------------
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__shell">
    <div class="site-footer__grid">
      {/* 1. Brand — real logo.webp + "Luxury Transportation" wordmark */}
      <div class="site-footer__col site-footer__col--brand">
        <BrandLockup locale={currentLocale} href={homeHref} variant="full" />
        <p class="site-footer__parent">{parentRelation}</p>
      </div>

      {/* 2. Services / Company */}
      <nav class="site-footer__col" aria-label={footerNavLabel}>
        <p class="site-footer__group-label">{servicesLabel}</p>
        <ul class="site-footer__list" role="list">
          {servicesGroup.map((item) => (
            <li>
              <a
                class="site-footer__link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>

        <p class="site-footer__group-label">{companyLabel}</p>
        <ul class="site-footer__list" role="list">
          {companyGroup.map((item) => (
            <li>
              <a
                class="site-footer__link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* 3. Contact / Hours */}
      <div class="site-footer__col">
        <p class="site-footer__group-label">{contactLabel}</p>
        <ul class="site-footer__list site-footer__list--contact" role="list">
          {phone && phoneHref ? (
            <li>
              <a class="site-footer__link" href={phoneHref}>{phone}</a>
            </li>
          ) : null}
          {email && emailHref ? (
            <li>
              <a class="site-footer__link" href={emailHref}>{email}</a>
            </li>
          ) : null}
          {whatsapp && whatsappHref ? (
            <li>
              <a class="site-footer__link" href={whatsappHref} rel="noopener noreferrer">{whatsapp}</a>
            </li>
          ) : null}
          <li class="site-footer__hours">{hoursDaysLabel} {officeHoursFact}</li>
        </ul>
        <p class="site-footer__note">{officeNote}</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        © {year} {business.publicBrand} · {rightsLabel}
      </p>
      <p class="site-footer__loc">
        {business.headquarters.city}, {business.headquarters.country}
      </p>
    </div>
  </div>
</footer>

<style>
  /* --- Surface: dark, subtle top divider, no rounded outer panel ---------
     No top margin: the footer sits compactly below the Final CTA, which owns
     its own bottom rhythm. The 1px border is the restrained separator
     (§Surface: prefer surface contrast/spacing over a decorative heavy rule). */
  .site-footer {
    background: var(--color-surface);
    border-block-start: 1px solid var(--color-border-subtle);
  }

  .site-footer__shell {
    width: min(calc(100% - (2 * var(--gutter-page))), var(--container-main));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  /* --- Desktop 3-column grid: 1.2fr 1fr 1fr (brand gets a little more) -- */
  .site-footer__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      align-items: start;
    }
  }

  /* --- Brand column ----------------------------------------------------- */
  .site-footer__parent {
    margin: var(--space-4) 0 0;
    max-inline-size: 30rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  /* --- Column headings (Manrope semibold, sentence case — no eyebrow) ---
     Brand font (Cormorant) stays exclusive to the BrandLockup above; body/UI
     text is Manrope (§Typography). No uppercase eyebrow labels (§Typography). */
  .site-footer__group-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }
  /* Visually separate the Company sub-group on desktop; on mobile the gap
     already separates them. */
  @media (min-width: 64rem) {
    .site-footer__group-label + .site-footer__list + .site-footer__group-label {
      margin-block-start: var(--space-5);
    }
  }
  .site-footer__list {
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }
  .site-footer__list:last-child { margin-block-end: 0; }
  /* Full-width links. The hit area is larger than the visible text: at touch
     widths each row meets the 44×44 project bar (FND-A11Y-05) via min-block-size
     — matching the SiteHeader mobile-link convention — while the visible text
     stays compact (no pill/background/border). At lg+ (pointer) the row returns
     to a compact desktop height (still above the WCAG 2.5.8 AA 24px floor),
     matching the approved SiteHeader desktop-nav pattern, so the Footer stays
     compact without bulky rows (§compact). */
  .site-footer__link {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem; /* 44px touch target — mobile/tablet */
    padding-block: var(--space-1);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  @media (min-width: 64rem) {
    .site-footer__link { min-block-size: auto; } /* compact desktop pointer row */
  }
  .site-footer__link:hover { color: var(--color-accent-hover); }
  .site-footer__link[aria-current="page"] { color: var(--color-accent); }
  .site-footer__link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }

  .site-footer__hours {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .site-footer__note {
    margin: var(--space-3) 0 0;
    max-inline-size: 26rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  /* --- Bottom row ------------------------------------------------------- */
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
    margin-block-start: clamp(2rem, 5vw, 4rem);
    padding-block: 1.2rem;
    border-block-start: 1px solid var(--color-border-subtle);
  }
  .site-footer__copy,
  .site-footer__loc {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* --- Mobile: one column, bottom row stacked --------------------------- */
  @media (max-width: 63.99rem) {
    .site-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
