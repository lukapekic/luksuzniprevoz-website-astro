---
/**
 * SiteFooter — premium site footer for the Luxury Transportation homepage V1.
 *
 * Contract: docs/home/home-components/12-site-footer.md
 * Blueprint: docs/home/reference/blueprint.md §17 (Footer)
 * Tokens: docs/home/home-components/00-token-matrix.md (locked color/space/radius vars)
 *
 * 3-column desktop layout (1.2fr 1fr 1fr):
 *   1. Brand — mark + wordmark + parent-company relation (quiet)
 *   2. Services / Company — two route-derived link groups (navigation.footer)
 *   3. Contact / Hours — verified channels (gated) + office-hours facts
 *
 * All links route-derived via getPath (FND-I18N-03 — never manual URLs) and
 * labeled via getNavLabel. All contact/hours facts come from business.ts /
 * contact.ts (FND-ARCH-03 facts). Generic UI strings via t() (FND-ARCH-03).
 *
 * Verified-only contact channels: a null/unverified phone/email/whatsapp never
 * ships as a clickable tel:/mailto: (contact.ts gating contract). While all
 * channels are unverified, the contact column shows hours + office note only.
 *
 * No islands: the footer is entirely server-rendered (no client JS needed).
 *
 * Forbidden (12 §Forbidden): newsletter, giant sitemap, oversized social section.
 */
import { getPath } from "@astro-foundation/core/i18n";
import { config } from "../../../foundation.config.ts";
import { routes } from "../../data/routes.ts";
import { navigation, getNavLabel, type NavLeaf } from "../../data/navigation.ts";
import { business } from "../../data/business.ts";
import { contact, isVerified } from "../../data/contact.ts";
import { t } from "../../lib/i18n.ts";
import type { LocaleCode, RouteKey, UiStringKey } from "@astro-foundation/core";

interface Props {
  currentRouteKey: RouteKey;
  currentLocale: LocaleCode;
}

const { currentRouteKey, currentLocale } = Astro.props;

const defaultLocale = (config.locales.locales.find((l) => l.isDefault)?.code ?? "sr") as LocaleCode;

/** Resolve a route href for the current locale (FND-I18N-03). */
const href = (key: RouteKey): string => getPath(key, currentLocale, routes, defaultLocale);

const homeHref = href("home");

// --- Footer link groups (route-derived) -----------------------------------
const servicesGroup = navigation.footer.services as NavLeaf[];
const companyGroup = navigation.footer.company as NavLeaf[];

const isCurrent = (key: RouteKey): boolean => currentRouteKey === key;

// --- UI strings (FND-ARCH-03) ---------------------------------------------
const footerNavLabel = t("nav.footer", currentLocale);
const servicesLabel = t("services.title", currentLocale);
const companyLabel = t("footer.company", currentLocale);
const contactLabel = t("contact.title", currentLocale);
const rightsLabel = t("footer.rights", currentLocale);
const monogram = t("brand.monogram", currentLocale);
const hoursDaysLabel = t("footer.hoursDays", currentLocale);
const officeNote = t(contact.officeHours.publicNoteKey as UiStringKey, currentLocale);
const parentRelation = t(
  business.parentCompany.relationshipDescriptionKey as UiStringKey,
  currentLocale,
);

// --- Contact channels — verified only (contact.ts gating contract) -----
// Contact URLs are constructed here in the data layer (not inline in JSX) so
// FND-I18N-03's no-manual-internal-url check sees simple identifier bindings;
// tel:/mailto:/wa.me are external contact points, not internal routes.
const phone = isVerified(contact.phone) ? contact.phone.value : null;
const email = isVerified(contact.email) ? contact.email.value : null;
const whatsapp = isVerified(contact.whatsapp) ? contact.whatsapp.value : null;
const phoneHref = phone ? `tel:${phone}` : null;
const emailHref = email ? `mailto:${email}` : null;
const whatsappHref = whatsapp
  ? `https://wa.me/${whatsapp.replace(/[^0-9]/g, "")}`
  : null;

// Office hours are a structural fact (business.supportModel.officeHours) —
// always present, independent of channel verification.
const officeHoursFact = business.supportModel.officeHours; // e.g. "08:00-18:00"

// --- Bottom row -----------------------------------------------------------
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__shell">
    <div class="site-footer__grid">
      {/* 1. Brand */}
      <div class="site-footer__col site-footer__col--brand">
        <a href={homeHref} class="site-footer__brand" aria-label={config.brand}>
          <span class="site-footer__mark" aria-hidden="true">{monogram}</span>
          <span class="site-footer__word">{config.brand}</span>
        </a>
        <p class="site-footer__parent">{parentRelation}</p>
      </div>

      {/* 2. Services / Company */}
      <nav class="site-footer__col" aria-label={footerNavLabel}>
        <p class="site-footer__group-label">{servicesLabel}</p>
        <ul class="site-footer__list" role="list">
          {servicesGroup.map((item) => (
            <li>
              <a
                class="site-footer__link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>

        <p class="site-footer__group-label">{companyLabel}</p>
        <ul class="site-footer__list" role="list">
          {companyGroup.map((item) => (
            <li>
              <a
                class="site-footer__link"
                href={href(item.routeKey)}
                aria-current={isCurrent(item.routeKey) ? "page" : undefined}
                data-astro-prefetch
              >
                {getNavLabel(item.routeKey, currentLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* 3. Contact / Hours */}
      <div class="site-footer__col">
        <p class="site-footer__group-label">{contactLabel}</p>
        <ul class="site-footer__list site-footer__list--contact" role="list">
          {phone && phoneHref ? (
            <li>
              <a class="site-footer__link" href={phoneHref} data-astro-prefetch>{phone}</a>
            </li>
          ) : null}
          {email && emailHref ? (
            <li>
              <a class="site-footer__link" href={emailHref} data-astro-prefetch>{email}</a>
            </li>
          ) : null}
          {whatsapp && whatsappHref ? (
            <li>
              <a class="site-footer__link" href={whatsappHref} data-astro-prefetch rel="noopener">{whatsapp}</a>
            </li>
          ) : null}
          <li class="site-footer__hours">{hoursDaysLabel} {officeHoursFact}</li>
        </ul>
        <p class="site-footer__note">{officeNote}</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        © {year} {config.brand} · {rightsLabel}
      </p>
      <p class="site-footer__loc">
        {business.headquarters.city}, {business.headquarters.country}
      </p>
    </div>
  </div>
</footer>

<style>
  /* --- Surface: dark, subtle top divider, no rounded outer panel (12 §Surface) */
  .site-footer {
    background: var(--color-surface);
    border-block-start: 1px solid var(--color-border-subtle);
    /* Top separation from Final CTA (12 §Separation). */
    margin-block-start: var(--space-section-standard);
  }

  .site-footer__shell {
    width: min(calc(100% - (2 * var(--gutter-page))), var(--container-main));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  /* --- Desktop 3-column grid: 1.2fr 1fr 1fr (12 §Desktop inner layout) --- */
  .site-footer__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      align-items: start;
    }
  }

  /* --- Brand column ------------------------------------------------------ */
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text-primary);
  }
  .site-footer__mark {
    display: inline-grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-text-on-light);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xs);
    letter-spacing: var(--letter-spacing-tight);
  }
  .site-footer__word {
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    letter-spacing: var(--letter-spacing-ui);
    text-transform: uppercase;
    color: var(--color-text-primary);
  }
  .site-footer__parent {
    margin: var(--space-4) 0 0;
    max-inline-size: 30rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  /* --- Link groups ------------------------------------------------------- */
  .site-footer__group-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-ui);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  /* Visually separate the Company sub-group on desktop; on mobile the gap
     already separates them. */
  @media (min-width: 64rem) {
    .site-footer__group-label + .site-footer__list + .site-footer__group-label {
      margin-block-start: var(--space-5);
    }
  }
  .site-footer__list {
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .site-footer__list:last-child { margin-block-end: 0; }
  .site-footer__list--contact { gap: var(--space-2); }
  .site-footer__link {
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--line-height-body);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .site-footer__link:hover { color: var(--color-accent-hover); }
  .site-footer__link[aria-current="page"] { color: var(--color-accent); }
  .site-footer__link:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }

  .site-footer__hours {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .site-footer__note {
    margin: var(--space-3) 0 0;
    max-inline-size: 26rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  /* --- Bottom row (12 §Bottom row) --------------------------------------- */
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
    margin-block-start: clamp(2rem, 5vw, 4rem);
    padding-block: 1.2rem;
    border-block-start: 1px solid var(--color-border-subtle);
  }
  .site-footer__copy,
  .site-footer__loc {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* --- Mobile: one column, bottom row stacked (12 §Mobile) --------------- */
  @media (max-width: 63.99rem) {
    .site-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
