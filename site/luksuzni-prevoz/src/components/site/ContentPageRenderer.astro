---
import type { CollectionEntry } from "astro:content";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import LeafPage from "./LeafPage.astro";
import AirportTransportationPage from "../services/airport-transportation/AirportTransportationPage.astro";

interface Props { routeKey: RouteKey; locale: LocaleCode; content: CollectionEntry<"pages"> }
const { routeKey, locale, content } = Astro.props;
---

{routeKey === "airportTransportation" ? (
  <AirportTransportationPage routeKey="airportTransportation" locale={locale} content={content} />
) : (
  <LeafPage routeKey={routeKey} locale={locale} content={content} />
)}
