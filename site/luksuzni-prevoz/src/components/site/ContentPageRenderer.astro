---
import type { CollectionEntry } from "astro:content";
import type { LocaleCode, RouteKey } from "@astro-foundation/core";
import LeafPage from "./LeafPage.astro";
import ScaffoldPage from "./ScaffoldPage.astro";
import AirportTransportationPage from "../services/airport-transportation/AirportTransportationPage.astro";
import BusinessTransportationPage from "../services/business-transportation/BusinessTransportationPage.astro";
import SpecialEventsPage from "../services/special-events/SpecialEventsPage.astro";
import PrivateChauffeurPage from "../services/private-chauffeur/PrivateChauffeurPage.astro";
import CorporateTransportationPage from "../services/corporate-transportation/CorporateTransportationPage.astro";
import DelegationTransportationPage from "../services/delegation-transportation/DelegationTransportationPage.astro";
import ConferenceCongressTransportationPage from "../services/conference-congress-transportation/ConferenceCongressTransportationPage.astro";
import WeddingTransportationPage from "../services/wedding-transportation/WeddingTransportationPage.astro";
import PromTransportationPage from "../services/prom-transportation/PromTransportationPage.astro";
import ContactPage from "../contact/ContactPage.astro";
import BookingPage from "../booking/BookingPage.astro";
import FleetPage from "../fleet/FleetPage.astro";

interface Props { routeKey: RouteKey; locale: LocaleCode; content: CollectionEntry<"pages"> }
const { routeKey, locale, content } = Astro.props;
---

{content.data.pageType === "scaffold" ? (
  <ScaffoldPage routeKey={routeKey} locale={locale} content={content} />
) : routeKey === "airportTransportation" ? (
  <AirportTransportationPage routeKey="airportTransportation" locale={locale} content={content} />
) : routeKey === "businessTransportation" ? (
  <BusinessTransportationPage routeKey="businessTransportation" locale={locale} content={content} />
) : routeKey === "specialEvents" ? (
  <SpecialEventsPage routeKey="specialEvents" locale={locale} content={content} />
) : routeKey === "privateChauffeur" ? (
  <PrivateChauffeurPage routeKey="privateChauffeur" locale={locale} content={content} />
) : routeKey === "corporateTransportation" ? (
  <CorporateTransportationPage routeKey="corporateTransportation" locale={locale} content={content} />
) : routeKey === "delegationTransportation" ? (
  <DelegationTransportationPage routeKey="delegationTransportation" locale={locale} content={content} />
) : routeKey === "conferenceCongressTransportation" ? (
  <ConferenceCongressTransportationPage routeKey="conferenceCongressTransportation" locale={locale} content={content} />
) : routeKey === "weddingTransportation" ? (
  <WeddingTransportationPage routeKey="weddingTransportation" locale={locale} content={content} />
) : routeKey === "promTransportation" ? (
  <PromTransportationPage routeKey="promTransportation" locale={locale} content={content} />
) : routeKey === "contact" ? (
  <ContactPage routeKey="contact" locale={locale} content={content} />
) : routeKey === "booking" ? (
  <BookingPage routeKey="booking" locale={locale} content={content} />
) : routeKey === "fleet" ? (
  <FleetPage routeKey="fleet" locale={locale} content={content} />
) : (
  <LeafPage routeKey={routeKey} locale={locale} content={content} />
)}
