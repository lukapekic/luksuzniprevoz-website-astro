---
/**
 * FAQ — reusable single-column accordion for editorial reading.
 *
 * Identity: divider-based editorial rows, NOT floating cards. Reading-focused
 * information (DESIGN.md §7). Uses native <details>/<summary> so open/close
 * works with zero client-side JavaScript (component-architecture.md §21; the
 * low-level Disclosure primitive is slot-based and does not fit data-driven
 * rows, so FAQ owns the native semantics directly).
 *
 * Surface ownership: FAQ owns ONLY its rows. It creates no page-section
 * background, no horizontal padding, and no max-width — compose it inside the
 * page's <Section> + <ReadingContainer> (design-foundation-governance.md §6/§11):
 *
 *   <Section surface="light" aria-labelledby="faq-h">
 *     <ReadingContainer>
 *       <SectionHeading id="faq-h" heading={faq.heading} on="light" />
 *       <FAQ items={faq.items} on="light" />
 *     </ReadingContainer>
 *   </Section>
 *
 * Heading: the page owns the section heading via <SectionHeading>. FAQ does NOT
 * embed a title (no "FAQ" / "Frequently Asked Questions" / "Česta pitanja"),
 * keeping it focused on rows only (component-architecture.md §14, task §6).
 *
 * Data: `items` is the canonical FaqItem[] ({ question, answer }) — the
 * shape owned by the content model's `faqItemSchema` in
 * `src/content/schemas/shared.ts` and consumed by the `buildFaqPage`
 * structured-data builder. The component imports that canonical type (not a
 * local redefinition), so one source feeds visible rows + FAQ schema with no
 * second copy (FND-ARCH-03, structured-data.md; same convention as HomeHero /
 * FinalCTA importing from the shared content-schema layer). FAQ emits NO
 * JSON-LD itself; the Page primitive owns <head> schema emission.
 *
 * Surface color: `on` mirrors <SectionHeading>'s model so the same component
 * renders correctly on a dark or light <Section> without a parallel variant
 * matrix. Default "dark". class passthrough is layout-only (FND-UI-06). CSS
 * logical properties only (FND-I18N-13).
 */
import type { FaqItem } from "../../content/schemas/shared.ts";

interface Props {
  /** FAQ question/answer rows, rendered in the order given (1+ items). */
  items: FaqItem[];
  /** Surface the rows sit on — drives text/divider/focus color (default dark). */
  on?: "dark" | "light";
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const { items, on = "dark", class: className } = Astro.props;

// Surface-driven semantic color maps (mirror SectionHeading's `on` model).
// On light, no dedicated light-divider token exists, so the divider and muted
// answer color are derived from the on-light text token via color-mix — the
// same technique SectionHeading uses for its description (no new token).
const surface =
  on === "light"
    ? {
        question: "text-[var(--color-text-on-light)]",
        answer:
          "text-[color-mix(in_oklab,var(--color-text-on-light),var(--color-surface-light)_35%)]",
        focus: "focus-visible:outline-[var(--color-focus-light)]",
        indicator: "text-[var(--color-text-on-light)]",
      }
    : {
        question: "text-[var(--color-text-primary)]",
        answer: "text-[var(--color-text-muted)]",
        focus: "focus-visible:outline-[var(--color-focus-dark)]",
        indicator: "text-[var(--color-text-primary)]",
      };
---

<div data-on={on} class={className}>
  <div class="faq-list">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary
            class:list={[
              "faq-summary flex items-center justify-between gap-[var(--space-4)]",
              "min-h-11 py-[var(--space-5)]",
              "cursor-pointer",
              "font-body font-semibold text-[length:var(--text-lg)] leading-[var(--line-height-ui)] tracking-[var(--letter-spacing-normal)]",
              surface.question,
              "transition-colors duration-[var(--duration-fast)] ease-[var(--ease-standard)]",
              "focus-visible:outline-2 focus-visible:outline-offset-2",
              surface.focus,
            ]}
          >
            <span>{item.question}</span>
            <span class:list={["faq-indicator shrink-0", surface.indicator]} aria-hidden="true" />
          </summary>
          <div class="pb-[var(--space-5)] pt-[var(--space-4)]">
            <p
              class:list={[
                "max-w-[var(--measure-body)]",
                "font-body text-[length:var(--text-base)] leading-[var(--line-height-body)]",
                surface.answer,
              ]}
            >
              {item.answer}
            </p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  /* Editorial divider hairlines. Color is token-driven per surface; width is a
     1px hairline (no border-width token exists; matches Section/border usage). */
  .faq-list {
    border-block-start: 1px solid var(--color-divider);
  }
  .faq-item {
    border-block-end: 1px solid var(--color-divider);
  }
  [data-on="light"] .faq-list,
  [data-on="light"] .faq-item {
    border-block-color: color-mix(
      in oklab,
      var(--color-text-on-light),
      var(--color-surface-light) 75%
    );
  }

  /* Remove the native <summary> disclosure marker (the indicator replaces it). */
  .faq-summary {
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  /* Restrained plus/minus indicator — two CSS bars; the vertical bar fades out
     on [open] so the plus becomes a minus. Decorative (aria-hidden). Built with
     currentColor so it inherits the surface's text color; a tiny accent emphasis
     is allowed on hover only (gold scarcity — indicator only, never the text). */
  .faq-indicator {
    position: relative;
    inline-size: var(--space-4);
    block-size: var(--space-4);
    flex: none;
  }
  .faq-indicator::before,
  .faq-indicator::after {
    content: "";
    position: absolute;
    background: currentColor;
    border-radius: 9999px;
  }
  .faq-indicator::before {
    inset-block-start: 50%;
    inset-inline: 0;
    block-size: 1.5px;
    transform: translateY(-50%);
  }
  .faq-indicator::after {
    inset-block: 0;
    inset-inline-start: 50%;
    inline-size: 1.5px;
    transform: translateX(-50%);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  details[open] .faq-indicator::after {
    opacity: 0;
  }
  .faq-summary:hover .faq-indicator {
    color: var(--color-accent);
  }
</style>
