---
/** Shared full-width photographic closing CTA; page copy/actions remain caller-owned. */
import PageContainer from "../../foundation/ui/PageContainer.astro";
import SectionHeading from "../../foundation/ui/SectionHeading.astro";
import Link from "../../foundation/ui/Link.astro";
import { Image } from "astro:assets";
import { closingMedia } from "../../data/closing-media.ts";
import { imageQuality, imageSizes, imageWidths } from "../../data/image-delivery.ts";
import type { FinalCTAProps } from "./FinalCTA.types.ts";
type Props = FinalCTAProps;
const { heading, description, primaryAction, secondaryAction, contacts, locale, class: className } = Astro.props;
const headingId = "final-cta-heading";
const phone = contacts?.phone;
const email = contacts?.email;
const phoneHref = phone ? `tel:${phone}` : null;
const emailHref = email ? `mailto:${email}` : null;
const image = closingMedia.finalCtaInterior;
---

<section class:list={["final-cta", className]} aria-labelledby={headingId}>
  <Image class="final-cta__image" src={image} alt="" loading="lazy" decoding="async" format="webp" quality={imageQuality.photoWebp} widths={imageWidths(image, "hero")} sizes={imageSizes.fullWidthCta} />
  <div class="final-cta__scrim" aria-hidden="true"></div>
  <PageContainer>
    <div class="final-cta__content">
      <SectionHeading id={headingId} heading={heading} description={description} />
      {(primaryAction || secondaryAction) && <div class="final-cta__actions">
        {primaryAction && <Link variant="cta" to={primaryAction.to} href={primaryAction.href} locale={locale}>{primaryAction.label}</Link>}
        {secondaryAction && <Link variant="button" to={secondaryAction.to} href={secondaryAction.href} locale={locale}>{secondaryAction.label}</Link>}
      </div>}
      {(phoneHref || emailHref) && <ul class="final-cta__contacts" role="list">
        {phoneHref && <li><a href={phoneHref}>{phone}</a></li>}
        {emailHref && <li><a href={emailHref}>{email}</a></li>}
      </ul>}
    </div>
  </PageContainer>
</section>

<style>
  .final-cta { position: relative; isolation: isolate; min-block-size: 26.25rem; overflow: hidden; background: var(--color-background); }
  .final-cta__image { position: absolute; inset: 0; z-index: -2; display: block; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 70% 0%; }
  .final-cta__scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, color-mix(in srgb, var(--color-background) 4%, transparent) 0%, color-mix(in srgb, var(--color-background) 6%, transparent) 23%, color-mix(in srgb, var(--color-background) 80%, transparent) 42%, color-mix(in srgb, var(--color-background) 96%, transparent) 60%, color-mix(in srgb, var(--color-background) 99%, transparent) 100%); }
  .final-cta__content { display: grid; gap: var(--space-4); max-inline-size: 32rem; min-block-size: 26.25rem; align-content: end; padding-block: 14rem var(--space-12); overflow-wrap: anywhere; }
  .final-cta__actions, .final-cta__contacts { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .final-cta__actions > :global(a) { min-inline-size: 0; max-inline-size: 100%; }
  .final-cta__contacts { margin: 0; padding: 0; list-style: none; }
  .final-cta__contacts li { min-inline-size: 0; }
  .final-cta__contacts a { display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-inline: var(--space-2); color: var(--color-text-primary); font-family: var(--font-body); font-size: var(--text-sm); overflow-wrap: anywhere; text-decoration: none; }
  .final-cta__contacts a:hover { color: var(--color-accent-hover); text-decoration: underline; }
  .final-cta__contacts a:focus-visible { outline: 2px solid var(--color-focus-dark); outline-offset: 2px; }
  @media (max-width: 29.99rem) { .final-cta__actions, .final-cta__contacts { flex-direction: column; } .final-cta__actions > :global(a) { inline-size: 100%; justify-content: center; } }
  @media (min-width: 30rem) and (max-width: 63.99rem) { .final-cta__content { padding-block-start: 16rem; } }
  @media (min-width: 64rem) {
    .final-cta__image { object-position: 50% 14%; }
    .final-cta__scrim { background: linear-gradient(90deg, color-mix(in srgb, var(--color-background) 96%, transparent) 0%, color-mix(in srgb, var(--color-background) 85%, transparent) 25%, color-mix(in srgb, var(--color-background) 65%, transparent) 42%, color-mix(in srgb, var(--color-background) 12%, transparent) 66%, color-mix(in srgb, var(--color-background) 3%, transparent) 100%); }
    .final-cta__content { align-content: center; padding-block: var(--space-16); }
  }
</style>
