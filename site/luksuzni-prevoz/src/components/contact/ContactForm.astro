---
import Button from "../../foundation/ui/Button.astro";
import Field from "../../foundation/ui/Field.astro";
import FormStatus from "../../foundation/ui/FormStatus.astro";
import Input from "../../foundation/ui/Input.astro";
import SectionHeading from "../../foundation/ui/SectionHeading.astro";
import Textarea from "../../foundation/ui/Textarea.astro";
import { CONTACT_FORM_LIMITS } from "./contact-form-validation.ts";
import type { ContactFormCopy } from "./contact-form.types.ts";
import type { LocaleCode } from "@astro-foundation/core";

interface Props {
  heading: string;
  intro?: string;
  copy: ContactFormCopy;
  locale: LocaleCode;
  formId?: string;
}

const {
  heading,
  intro,
  copy,
  locale,
  formId = "contact-question-form",
} = Astro.props;
const fullNameId = `${formId}-full-name`;
const emailId = `${formId}-email`;
const phoneId = `${formId}-phone`;
const messageId = `${formId}-message`;
const statusId = `${formId}-status`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<section
  class="h-full rounded-[var(--radius-section)] bg-[var(--color-surface-light)] p-[var(--space-6)] md:p-[var(--space-8)] lg:p-[var(--space-10)]"
  aria-labelledby={`${formId}-heading`}
>
  <SectionHeading
    id={`${formId}-heading`}
    heading={heading}
    description={intro}
    on="light"
  />

  <form
    id={formId}
    class="mt-[var(--space-8)] grid gap-[var(--space-5)]"
    novalidate
    aria-describedby={statusId}
    data-contact-question-form
    data-endpoint="/api/forms/contact"
    data-locale={locale}
    data-turnstile-site-key={turnstileSiteKey}
    data-submit-action={copy.submitAction}
    data-status-submitting={copy.submittingStatus}
    data-status-success={copy.successStatus}
    data-status-reference={copy.referenceStatus}
    data-status-bot-verification={copy.botVerificationStatus}
    data-status-rate-limited={copy.rateLimitedStatus}
    data-status-service-unavailable={copy.serviceUnavailableStatus}
    data-status-server-error={copy.serverErrorStatus}
    data-status-turnstile-required={copy.turnstileRequiredStatus}
    data-error-required={copy.errors.required}
    data-error-full-name-format={copy.errors.fullNameFormat}
    data-error-email-format={copy.errors.emailFormat}
    data-error-phone-format={copy.errors.phoneFormat}
    data-error-message-length={copy.errors.messageLength}
  >
    <div
      class="rounded-[var(--radius-control)] border border-[var(--color-error)] p-[var(--space-4)] text-[var(--color-error)]"
      data-contact-error-summary
      hidden
      tabindex="-1"
      role="alert"
    >
      <p class="font-heading font-bold">{copy.errorSummaryHeading}</p>
      <ul class="mt-[var(--space-2)] list-disc ps-[var(--space-5)]" data-contact-error-summary-list></ul>
    </div>
    <Field
      label={copy.fullNameLabel}
      htmlFor={fullNameId}
      required
      hint={copy.fullNameHint}
    >
      <Input
        slot="control"
        id={fullNameId}
        name="fullName"
        type="text"
        autocomplete="name"
        inputmode="text"
        autocapitalize="words"
        spellcheck={false}
        minlength={CONTACT_FORM_LIMITS.fullName.min}
        maxlength={CONTACT_FORM_LIMITS.fullName.max}
        required
        hint={Boolean(copy.fullNameHint)}
      />
    </Field>

    <Field
      label={copy.emailLabel}
      htmlFor={emailId}
      required
      hint={copy.emailHint}
    >
      <Input
        slot="control"
        id={emailId}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        autocapitalize="none"
        spellcheck={false}
        maxlength={CONTACT_FORM_LIMITS.email.max}
        required
        hint={Boolean(copy.emailHint)}
      />
    </Field>

    <Field label={copy.phoneLabel} htmlFor={phoneId} hint={copy.phoneHint}>
      <Input
        slot="control"
        id={phoneId}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        spellcheck={false}
        maxlength={CONTACT_FORM_LIMITS.phone.max}
        hint={Boolean(copy.phoneHint)}
      />
    </Field>

    <Field
      label={copy.messageLabel}
      htmlFor={messageId}
      required
      hint={copy.messageHint}
    >
      <Textarea
        slot="control"
        id={messageId}
        name="message"
        autocomplete="off"
        autocapitalize="sentences"
        spellcheck
        rows={6}
        minlength={CONTACT_FORM_LIMITS.message.min}
        maxlength={CONTACT_FORM_LIMITS.message.max}
        required
        hint={Boolean(copy.messageHint)}
      />
    </Field>

    <div class="grid gap-[var(--space-3)]">
      <div data-contact-turnstile></div>
      <div data-contact-submit class="justify-self-start">
        <Button type="submit"><span data-contact-submit-label>{copy.submitAction}</span></Button>
      </div>
      <FormStatus id={statusId} type="info" on="light" />
    </div>
  </form>
</section>

<script>
  // Client-script justification: localized field state, asynchronous same-origin
  // submission, and explicit Turnstile token lifecycle require browser behavior.
  import { mountContactForms } from "./contact-form-controller.ts";

  mountContactForms();
</script>
