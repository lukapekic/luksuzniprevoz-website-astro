{
  "families": {
    "heading": "Instrument Serif, Georgia, serif",
    "body": "Manrope Variable, system-ui, sans-serif"
  },
  "fallbacks": {
    "heading": "Georgia, serif",
    "body": "system-ui, sans-serif"
  },
  "weights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "sizes": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "h3": "clamp(1.375rem, 1.8vw, 1.75rem)",
    "h2": "clamp(2rem, 3.5vw, 3.25rem)",
    "h1": "clamp(2.75rem, 5.5vw, 5rem)",
    "display": "clamp(3.25rem, 7vw, 6.25rem)",
    "ui": "0.875rem",
    "caption": "0.75rem"
  },
  "lineHeight": {
    "tight": 0.98,
    "heading": 1.05,
    "body": 1.6,
    "ui": 1.3
  },
  "letterSpacing": {
    "tight": "-0.03em",
    "heading": "-0.02em",
    "normal": "0em",
    "ui": "0.01em"
  },
  "measure": {
    "body": "46rem",
    "narrow": "38rem"
  }
}
