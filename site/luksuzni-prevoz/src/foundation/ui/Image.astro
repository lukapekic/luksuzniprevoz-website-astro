---
/**
 * Image primitive — FND-IMG-08, FND-IMG-01
 *
 * Contract:
 * - role="decorative" forces alt=""
 * - role="hero" forces loading="eager" (FND-IMG-04)
 * - role="hero" allows fetchPriority="high" (only one per view, enforced at page level FND-IMG-05)
 * - Uses Astro's Image component internally (FND-IMG-01)
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import { Image } from "astro:assets";

interface Props {
  /** Image source */
  src: string;
  /** Alt text */
  alt: string;
  /** Image role */
  role: "hero" | "content" | "decorative" | "contained";
  /** Width */
  width: number;
  /** Height */
  height: number;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Loading behavior */
  loading?: "eager" | "lazy";
  /** Fetch priority */
  fetchPriority?: "high" | "low" | "auto";
}

const {
  src,
  alt: altText,
  role,
  width,
  height,
  class: className,
  loading,
  fetchPriority,
} = Astro.props;

// FND-IMG-08: decorative images must have empty alt
const finalAlt = role === "decorative" ? "" : altText;

// FND-IMG-04: hero images are always eager
const finalLoading = role === "hero" ? "eager" : (loading ?? "lazy");

// FND-IMG-05: only hero images can have fetchPriority="high"
const finalFetchPriority = role === "hero" ? (fetchPriority ?? "high") : undefined;

// Role attribute: decorative images get role="presentation"
const roleAttr = role === "decorative" ? "presentation" : undefined;
---

<Image
  src={src}
  alt={finalAlt}
  width={width}
  height={height}
  loading={finalLoading}
  fetchpriority={finalFetchPriority}
  role={roleAttr}
  class={className}
/>
