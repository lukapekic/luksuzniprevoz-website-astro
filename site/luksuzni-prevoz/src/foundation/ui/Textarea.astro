---
/**
 * Textarea primitive — Form group, FND-A11Y-10
 *
 * Contract:
 * - Renders <textarea> with autocomplete support (FND-A11Y-10)
 * - Min 44×44 target size (FND-A11Y-05)
 * - Error state styling via aria-invalid
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import { inputVariants } from "./Input.variants.ts";

interface Props {
  /** Input name */
  name: string;
  /** Autocomplete value (FND-A11Y-10) */
  autocomplete?: string;
  /** Required state */
  required?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Read-only state */
  readonly?: boolean;
  /** Native minimum character count */
  minlength?: number;
  /** Native maximum character count */
  maxlength?: number;
  /** Browser capitalization hint */
  autocapitalize?: "none" | "off" | "sentences" | "on" | "words" | "characters";
  /** Browser spelling assistance */
  spellcheck?: boolean;
  /** Error state — triggers aria-invalid + links `${id}-error` */
  error?: string;
  /** Hint id link — when set, `${id}-hint` is added to aria-describedby */
  hint?: boolean;
  /** Value */
  value?: string;
  /** Placeholder */
  placeholder?: string;
  /** Number of rows */
  rows?: number;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Size variant */
  size?: "sm" | "md" | "lg";
  /** Element id */
  id?: string;
}

const {
  name,
  autocomplete,
  required = false,
  disabled = false,
  readonly: isReadonly = false,
  minlength,
  maxlength,
  autocapitalize,
  spellcheck,
  error,
  hint,
  value,
  placeholder,
  rows = 4,
  class: className,
  size,
  id,
} = Astro.props;

const classNames = inputVariants({ size: size ?? "md" }, className);

// Link help/error text rendered by <Field> (ids `${id}-hint` / `${id}-error`).
const describedByParts: string[] = [];
if (hint) describedByParts.push(`${id ?? name}-hint`);
if (error) describedByParts.push(`${id ?? name}-error`);
const describedBy =
  describedByParts.length > 0 ? describedByParts.join(" ") : undefined;
---

<textarea
  id={id}
  name={name}
  autocomplete={autocomplete}
  required={required}
  disabled={disabled}
  readonly={isReadonly}
  minlength={minlength}
  maxlength={maxlength}
  autocapitalize={autocapitalize}
  spellcheck={spellcheck}
  aria-invalid={error ? "true" : undefined}
  aria-describedby={describedBy}
  rows={rows}
  placeholder={placeholder}
  class={`${classNames} resize-y`}
>
  {value}
</textarea>
