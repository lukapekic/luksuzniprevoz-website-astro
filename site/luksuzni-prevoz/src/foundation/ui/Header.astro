---
/**
 * Header component — FND-ARCH-03
 *
 * Uses NavList for navigation, LanguageSwitcher.
 * Responsive: full nav on desktop, hamburger menu on mobile.
 * island: responsive navigation toggle (justified by mobile/desktop breakpoint)
 */
import Container from "./Container.astro";
import NavList from "./NavList.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getPath } from "@astro-foundation/core/i18n";
import { primaryNavFlat, getNavLabel } from "../../data/navigation.ts";
import { routes } from "../../data/routes.ts";
import type { RouteKey, LocaleCode } from "@astro-foundation/core";
import { config } from "../../../foundation.config.ts";

interface Props {
  currentRouteKey: RouteKey;
  currentLocale: LocaleCode;
}

const { currentRouteKey, currentLocale } = Astro.props;

// Generic UI strings (nav.menu, nav.close, nav.main) still come from
// content/ui/*.json; route display labels come from navigation-labels.json
// via getNavLabel (FND-ARCH-03 — labels from the UI strings dictionary).
import srStrings from "../../content/ui/sr.json";
import enStrings from "../../content/ui/en.json";
import ruStrings from "../../content/ui/ru.json";

const uiStrings: Record<string, Record<string, string>> = {
  sr: srStrings as unknown as Record<string, string>,
  en: enStrings as unknown as Record<string, string>,
  ru: ruStrings as unknown as Record<string, string>,
};

const strings = uiStrings[currentLocale] ?? uiStrings["sr"];

// Flat top-level route items only — the `services` dropdown (2-level nested
// branches) and the `book` CTA (booking flow) need a dropdown-capable Header
// component, pending. Until then NavList renders the route-bearing leaves.
const navItems = primaryNavFlat.map((item) => ({
  routeKey: item.routeKey,
  label: getNavLabel(item.routeKey, currentLocale),
}));

const menuLabel = strings["nav.menu"] ?? "Menu";
const closeLabel = strings["nav.close"] ?? "Close";
const mainNavLabel = strings["nav.main"] ?? "Main navigation";
const defaultLocale = config.locales.locales.find((l) => l.isDefault)?.code ?? "sr";
const homeHref = getPath("home", currentLocale, routes, defaultLocale);
---

<!-- island: responsive navigation toggle — mobile hamburger requires client-side state -->
<header class="border-b border-[var(--border-default)] bg-[var(--surface-base)]">
  <Container size="xl" class="flex items-center justify-between py-[var(--space-4)]">
    <!-- Brand -->
    <a href={homeHref} class="text-xl font-bold text-[var(--text-primary)]">
      {config.brand}
    </a>

    <!-- Desktop navigation -->
    <div class="hidden md:flex md:items-center md:gap-4">
      <NavList
        items={navItems}
        currentRouteKey={currentRouteKey}
        class="flex flex-row gap-2"
        ariaLabel={mainNavLabel}
      />
      <LanguageSwitcher
        currentLocale={currentLocale}
        currentRouteKey={currentRouteKey}
      />
    </div>

    <!-- Mobile: hamburger + language -->
    <div class="flex items-center gap-3 md:hidden">
      <LanguageSwitcher
        currentLocale={currentLocale}
        currentRouteKey={currentRouteKey}
      />
      <!-- island: responsive navigation toggle -->
      <button
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[var(--radius-md)] border border-[var(--border-default)] bg-[var(--surface-base)] px-3 py-2 text-sm font-medium text-[var(--text-primary)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--surface-raised)] focus-visible:outline-2 focus-visible:outline-[var(--focus-ring)] focus-visible:outline-offset-2"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={menuLabel}
        data-nav-toggle
        data-close-label={closeLabel}
        data-menu-label={menuLabel}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </Container>

  {/* FND-ARCH-06: progressive enhancement. The panel is server-rendered OPEN so
      no-JS users can navigate. This inline script hides it as early as possible
      when JS is available; the toggle script below reopens it. Wrapped in
      try/catch per FND-ARCH-06's island-entry requirement. */}
  <script is:inline>
    try { document.getElementById("mobile-nav")?.classList.add("hidden"); } catch (e) {}
  </script>

  <!-- Mobile navigation panel (open by default; hidden by JS above) -->
  <!-- island: responsive navigation toggle -->
  <nav
    id="mobile-nav"
    class="border-t border-[var(--border-default)] bg-[var(--surface-base)] md:hidden"
    aria-label={menuLabel}
    data-nav-panel
  >
    <Container size="xl" class="py-[var(--space-4)]">
      <NavList
        items={navItems}
        currentRouteKey={currentRouteKey}
        class="flex flex-col gap-2"
        ariaLabel={menuLabel}
      />
    </Container>
  </nav>
</header>

<script>
  // island: responsive navigation toggle
  // Minimal JS for mobile hamburger open/close. FND-ARCH-05: data attributes.
  // FND-ARCH-06: the whole island entry is wrapped in try/catch so a failure
  // never breaks the page — the nav is already in the DOM (server-rendered).
  try {
    const toggle = document.querySelector("[data-nav-toggle]");
    const panel = document.querySelector("[data-nav-panel]");
    if (toggle && panel) {
      toggle.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        panel.classList.toggle("hidden");
        const closeLabel = toggle.getAttribute("data-close-label");
        const menuLabel = toggle.getAttribute("data-menu-label");
        if (closeLabel && menuLabel) {
          toggle.setAttribute("aria-label", expanded ? menuLabel : closeLabel);
        }
      });
    }
  } catch (e) {
    // FND-ARCH-06: fail open — the panel is server-rendered, so navigation
    // works even if this script never runs.
  }
</script>
