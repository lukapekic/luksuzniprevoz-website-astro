---
/**
 * Breadcrumbs primitive — Navigation group, FND-SEO-11
 *
 * Contract:
 * - Renders <nav aria-label="Breadcrumb"> with <ol> list
 * - Generates BreadcrumbList JSON-LD (FND-SEO-11)
 * - Last item is aria-current="page" (not a link)
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import Link from "./Link.astro";
import { buildBreadcrumbJsonLd } from "@astro-foundation/core/seo";
import type { RouteKey, LocaleCode } from "@astro-foundation/core";
import { t } from "../../lib/i18n.ts";

interface BreadcrumbItem {
  routeKey: RouteKey;
  label: string;
  locale?: LocaleCode;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /** Site URL for JSON-LD absolute URLs */
  siteUrl?: string;
  /** Current locale, for the localized nav label (FND-ARCH-03) */
  locale?: LocaleCode;
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const {
  items,
  siteUrl,
  locale,
  class: className,
} = Astro.props;

// Build JSON-LD from the items
const jsonLd = buildBreadcrumbJsonLd(
  items.map((item) => ({
    name: item.label,
    url: item.href ? `${siteUrl ?? ""}${item.href}` : "#",
  })),
);
---

<nav aria-label={t("nav.breadcrumb", locale ?? "sr")} class={className}>
  <ol class="flex flex-wrap items-center gap-1 text-sm text-[var(--text-secondary)]">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && (
          <span aria-hidden="true" class="text-[var(--text-muted)]">/</span>
        )}
        {index < items.length - 1 ? (
          <Link to={item.routeKey} locale={item.locale} variant="default" size="sm">
            {item.label}
          </Link>
        ) : (
          <span aria-current="page" class="text-[var(--text-primary)] font-medium">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</nav>
