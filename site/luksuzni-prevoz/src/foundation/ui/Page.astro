---
/**
 * Page primitive — FND-UI-14
 *
 * Contract:
 * - OWNS <head>. No other component or page should emit head tags.
 * - Renders <html lang={locale.htmlLang} dir={locale.dir}>
 * - Full <head> with title template, meta, canonical, hreflang, OG, JSON-LD, noindex
 * - <body> with SkipLink, slot content
 * - Sets data-theme attribute for light/dark mode
 * - FND-SEO-13: Title template "{title} | {brand}" by default
 */
import type { SeoData } from "@astro-foundation/core/seo";
import { composeTitle } from "@astro-foundation/core/seo";
import type { LocaleCode } from "@astro-foundation/core";
import { t } from "../../lib/i18n.ts";
import favicon from "../../assets/logo.webp";
import interTightCyrillicUrl from "@fontsource-variable/inter-tight/files/inter-tight-cyrillic-wght-normal.woff2?url";
import interTightLatinUrl from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import manropeCyrillicUrl from "@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url";
import manropeLatinUrl from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import SkipLink from "./SkipLink.astro";
// Global CSS entry (Tailwind v4 + Foundation theme). Imported here because
// Page owns <html>/<head>; every page uses Page directly or via BaseLayout.
import "../../styles/global.css";

interface Props {
  seo: SeoData;
  /** Preload primary text faces; pages with an image LCP may opt out. */
  preloadFonts?: boolean;
  /** Title template — default "{title} | {brand}" (FND-SEO-13) */
  titleTemplate?: string;
  /** Layout-only class on <body> (FND-UI-06) */
  class?: string;
  /** Current locale — localizes the SkipLink label (FND-ARCH-03). */
  locale: LocaleCode;
}

const {
  seo,
  preloadFonts = true,
  titleTemplate,
  class: className,
  locale,
} = Astro.props;

const skipText = t("a11y.skipToContent", locale);
const headingFontUrl = locale === "ru" ? interTightCyrillicUrl : interTightLatinUrl;
const bodyFontUrl = locale === "ru" ? manropeCyrillicUrl : manropeLatinUrl;

const pageTitle = composeTitle(seo.title, seo.brand, titleTemplate);
const ogType = seo.ogType ?? "website";
---

<!doctype html>
<html lang={seo.locale.htmlLang} dir={seo.locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href={favicon.src} />
    {preloadFonts && (
      <link
        rel="preload"
        href={headingFontUrl}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
        fetchpriority="low"
      />
    )}
    {preloadFonts && (
      <link
        rel="preload"
        href={bodyFontUrl}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
        fetchpriority="low"
      />
    )}
    <meta name="description" content={seo.description} />
    <title>{pageTitle}</title>

    {seo.canonical && (
      <link rel="canonical" href={seo.canonical} />
    )}

    {seo.noindex && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    {/* Hreflang links (FND-I18N-11) */}
    {seo.hreflang?.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    {/* Open Graph tags */}
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={ogType} />
    {seo.canonical && (
      <meta property="og:url" content={seo.canonical} />
    )}
    {seo.ogImage && (
      <meta property="og:image" content={seo.ogImage} />
    )}
    {seo.ogImage && seo.ogImageWidth && (
      <meta property="og:image:width" content={String(seo.ogImageWidth)} />
    )}
    {seo.ogImage && seo.ogImageHeight && (
      <meta property="og:image:height" content={String(seo.ogImageHeight)} />
    )}
    {seo.ogImageAlt && (
      <meta property="og:image:alt" content={seo.ogImageAlt} />
    )}

    {/* JSON-LD structured data */}
    {seo.structuredData?.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class={className}>
    {/* Single skip-to-content link, owned by Page (FND-A11Y-08). No other
        component renders one. Label is localized through the UI dictionary
        via the `locale` prop (FND-ARCH-03). */}
    <SkipLink text={skipText} />
    <slot />
  </body>
</html>
