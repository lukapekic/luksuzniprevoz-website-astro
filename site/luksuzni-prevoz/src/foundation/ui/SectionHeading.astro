---
/**
 * SectionHeading — canonical reusable section-heading composition.
 *
 * Anatomy: optional short platinum accent rule → heading (H2 or H3) → optional
 * concise description. Heading level is configurable (2 default) without
 * changing the visual role unpredictably. Left-aligned by default; no
 * center/right variants (design-foundation-governance.md §14).
 *
 * Typography: Inter Tight for the heading (font-heading), Manrope for the
 * description (font-body), via the approved typography utilities/tokens.
 *
 * Accent rule: restrained, short, platinum accent, left-aligned, above the heading. It is
 * NOT an uppercase eyebrow/kicker label and NOT a full-width separator
 * (design-foundation-governance.md §5/§15).
 *
 * Surface: `on` controls the text-color treatment so the same semantic tokens
 * handle dark and light surfaces without a parallel variant matrix. `on="light"`
 * (used inside a light <Section>) swaps heading text to --color-text-on-light
 * and mutes the description toward the cream surface. Default `on="dark"`.
 *
 * `heading` / `description` are UI-string values (FND-ARCH-03) passed as
 * expressions by the caller, so they are not flagged by no-hardcoded-ui-string.
 * class passthrough is layout-only (FND-UI-06). CSS logical properties only
 * (FND-I18N-13).
 */
interface Props {
  /** Heading text (UI string — pass as an expression) */
  heading: string;
  /** Optional concise description (UI string — pass as an expression) */
  description?: string;
  /** Heading level (default 2) */
  level?: 2 | 3;
  /** Surface the heading sits on — drives text color (default dark) */
  on?: "dark" | "light";
  /** Show the short platinum accent rule above the heading (default false) */
  accent?: boolean;
  /** Element id (for aria-labelledby on the parent <Section>) */
  id?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const {
  heading,
  description,
  level = 2,
  on = "dark",
  accent = false,
  id,
  class: className,
} = Astro.props;

const Tag: "h2" | "h3" = level === 3 ? "h3" : "h2";
const sizeCls =
  level === 3 ? "text-[length:var(--text-h3)]" : "text-[length:var(--text-h2)]";
const headingColor =
  on === "light"
    ? "text-[var(--color-text-on-light)]"
    : "text-[var(--color-text-primary)]";
const descColor =
  on === "light"
    ? "text-[color-mix(in_oklab,var(--color-text-on-light),var(--color-surface-light)_30%)]"
    : "text-[var(--color-text-muted)]";
---

<div class={className}>
  {accent && (
    <span
      aria-hidden="true"
      class="mb-[var(--space-4)] block h-0.5 w-[var(--space-12)] rounded-full bg-[var(--color-accent)]"
    />
  )}
  <Tag
    id={id}
    class={`font-heading ${sizeCls} font-semibold leading-[var(--line-height-heading)] tracking-[var(--letter-spacing-heading)] ${headingColor}`}
  >
    {heading}
  </Tag>
  {description && (
    <p
      class={`mt-[var(--space-4)] max-w-[var(--measure-body)] font-body text-lg leading-[var(--line-height-body)] ${descColor}`}
    >
      {description}
    </p>
  )}
</div>
