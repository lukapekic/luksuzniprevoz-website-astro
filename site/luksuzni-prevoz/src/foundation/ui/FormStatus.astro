---
/**
 * FormStatus primitive — Form group
 *
 * Contract:
 * - Renders an aria-live region for form feedback
 * - Screen reader announces changes without interrupting
 * - Uses Theme V2 semantic status tokens (--color-success, --color-error)
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
interface Props {
  /** Status type */
  type?: "success" | "error" | "info";
  /** Status message */
  message?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const {
  type = "info",
  message,
  class: className,
} = Astro.props;

const colorMap = {
  success: "text-[var(--color-success)]",
  error: "text-[var(--color-error)]",
  info: "text-[var(--color-text-muted)]",
};
---

<div
  role="status"
  aria-live="polite"
  aria-atomic="true"
  class={`text-sm font-medium ${colorMap[type] ?? ""} ${className ?? ""}`}
>
  {message && <p>{message}</p>}
</div>
