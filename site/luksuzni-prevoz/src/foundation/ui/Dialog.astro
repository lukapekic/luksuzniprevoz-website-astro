---
/**
 * Dialog primitive — Interactive group, FND-A11Y-08
 *
 * Contract:
 * - Uses native <dialog> element (no polyfill needed)
 * - Focus trap via native dialog behavior
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import { dialogVariants } from "./Dialog.variants.ts";

interface Props {
  /** Whether the dialog is open */
  open?: boolean;
  /** Element id */
  id?: string;
  /** Accessible label */
  ariaLabel?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const {
  open = false,
  id,
  ariaLabel,
  class: className,
} = Astro.props;

const classNames = dialogVariants({ size: "md" }, className);
---

<dialog id={id} open={open} aria-label={ariaLabel} class={classNames}>
  <slot />
</dialog>
