---
/**
 * Checkbox primitive — Form group, FND-A11Y-10
 *
 * Contract:
 * - Renders native <input type="checkbox"> + associated <label>.
 * - Native keyboard/input semantics are preserved; the visual mark is tinted
 *   via `accent-color` (modern CSS), not a custom widget.
 * - Min 44×44 target (FND-A11Y-05): the input is sized to 24px and the label
 *   row is min-h-11, so the full label+control hit area meets the target.
 * - Error state: aria-invalid swaps the border/accent to --color-error; the
 *   caller renders a text explanation (not color-only).
 * - Light-surface form primitive (on-light tokens).
 * - class passthrough is layout-only (FND-UI-06).
 * - CSS logical properties only (FND-I18N-13).
 */
interface Props {
  /** Checkbox name */
  name: string;
  /** Label text from UI strings (FND-ARCH-03) */
  label: string;
  /** Checkbox value */
  value?: string;
  /** Required state */
  required?: boolean;
  /** Error state — triggers aria-invalid */
  error?: string;
  /** Checked state */
  checked?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Element id */
  id?: string;
}

const {
  name,
  label,
  value,
  required = false,
  error,
  checked = false,
  disabled = false,
  class: className,
  id,
} = Astro.props;
---

<div class={`flex min-h-11 items-center gap-[var(--space-3)] ${className ?? ""}`}>
  <input
    id={id}
    type="checkbox"
    name={name}
    value={value}
    required={required}
    disabled={disabled}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error ? `${id ?? name}-error` : undefined}
    checked={checked}
    class="size-6 shrink-0 rounded border-2 border-solid border-[var(--color-input-border)] bg-[var(--color-input-surface)] accent-[var(--color-accent)] aria-invalid:border-[var(--color-error)] aria-invalid:accent-[var(--color-error)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus-light)] disabled:cursor-not-allowed disabled:opacity-70"
  />
  <label
    for={id}
    class="font-body text-[length:var(--text-ui)] leading-[var(--line-height-ui)] text-[var(--color-text-on-light)] cursor-pointer"
  >
    {label}
    {required && (
      <span class="text-[var(--color-accent)]" aria-hidden="true"> *</span>
    )}
  </label>
</div>
