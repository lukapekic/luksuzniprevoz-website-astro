---
/**
 * NavList primitive — Navigation group
 *
 * Contract:
 * - Renders navigation links using the Link primitive
 * - Marks current page link with aria-current="page"
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import Link from "./Link.astro";
import type { RouteKey, LocaleCode } from "@astro-foundation/core";

interface NavItem {
  routeKey: RouteKey;
  label: string;
  locale?: LocaleCode;
}

interface Props {
  items: NavItem[];
  /** Current route key to mark active */
  currentRouteKey?: RouteKey;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Accessible label */
  ariaLabel?: string;
}

const {
  items,
  currentRouteKey,
  class: className,
  ariaLabel,
} = Astro.props;
---

<nav aria-label={ariaLabel} class={className}>
  <ul class="flex flex-col gap-1" role="list">
    {items.map((item) => (
      <li>
        <Link
          to={item.routeKey}
          locale={item.locale}
          variant="nav"
          aria-current={
            currentRouteKey === item.routeKey ? "page" : undefined
          }
        >
          {item.label}
        </Link>
      </li>
    ))}
  </ul>
</nav>
