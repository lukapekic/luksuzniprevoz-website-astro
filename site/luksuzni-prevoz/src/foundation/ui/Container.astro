---
/**
 * Container primitive — FND-UI-03, Document group
 *
 * Contract:
 * - Owns horizontal gutter + max-width + centering ONLY (no surface/rhythm).
 * - Width axis maps to semantic layout tokens (main/reading/narrow/full).
 * - `main` element gets id="main-content" for skip link target.
 * - Composes inside <Section>: Section provides py + surface; Container
 *   provides px + width cap.
 * - class passthrough is layout-only (FND-UI-06): margin, grid/flex, width, order.
 * - CSS logical properties only (FND-I18N-13).
 *
 * PageContainer / ReadingContainer are the canonical named wrappers over this
 * primitive (width="main" / width="reading").
 */
import { containerVariants } from "./Container.variants.ts";

interface Props {
  /** Container width role (maps to --container-* tokens) */
  width?: "main" | "reading" | "narrow" | "full";
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** HTML element to render */
  as?: "div" | "section" | "main" | "article";
  /** Element id */
  id?: string;
}

const {
  width = "main",
  class: className,
  as: Element = "div",
  id,
} = Astro.props;

const classNames = containerVariants({ width }, className);

// main element gets id="main-content" for skip link target
const elementId = id ?? (Element === "main" ? "main-content" : undefined);
---

<Element id={elementId} class={classNames}>
  <slot />
</Element>
