---
/**
 * LanguageSwitcher primitive — Navigation group
 *
 * Contract:
 * - Renders links to the current page in other locales
 * - Each link has proper hreflang and lang attributes
 * - Uses Link primitive for path resolution
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import Link from "./Link.astro";
import { config } from "../../../foundation.config.ts";
import { t } from "../../lib/i18n.ts";
import type { RouteKey, LocaleCode } from "@astro-foundation/core";

interface Props {
  currentLocale: LocaleCode;
  currentRouteKey: RouteKey;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Accessible label */
  ariaLabel?: string;
}

const {
  currentLocale,
  currentRouteKey,
  class: className,
  ariaLabel,
} = Astro.props;

const switcherLabel = ariaLabel ?? t("nav.language", currentLocale);

const locales = config.locales.locales;
const otherLocales = locales.filter((l) => l.code !== currentLocale);
---

<nav aria-label={switcherLabel} class={className}>
  <ul class="flex flex-wrap items-center gap-2" role="list">
    {otherLocales.map((locale) => (
      <li>
        <Link
          to={currentRouteKey}
          locale={locale.code}
          variant="default"
          size="sm"
          hreflang={locale.hreflang}
          lang={locale.htmlLang}
          rel="alternate"
        >
          {locale.label}
        </Link>
      </li>
    ))}
  </ul>
</nav>
