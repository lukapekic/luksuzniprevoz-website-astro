---
/** Shared public brand: approved owner-supplied car symbol plus canonical name. */
import type { LocaleCode } from "@astro-foundation/core";
import { business } from "../../data/business.ts";

interface Props {
  /** Identity is language-independent; locale is accepted for existing consumers. */
  locale?: LocaleCode;
  href?: string;
  /** Layout-only class (FND-UI-06). */
  class?: string;
  /** Keep the existing header/mobile API. */
  variant?: "full" | "responsive" | "mark-only";
}

const { href, class: className, variant = "full" } = Astro.props;
const Tag: "a" | "span" = href ? "a" : "span";
const wordmarkDisplay =
  variant === "mark-only" ? "sr-only" : variant === "responsive" ? "max-lg:sr-only" : "";
---

<Tag
  href={href}
  class={`group inline-flex min-h-11 items-center gap-[var(--space-3)] rounded-[var(--radius-control)] no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus-dark)] ${className ?? ""}`}
>
  {/* Geometry follows assets/symbol-dark.svg in the owner-approved logo package.
      currentColor maps the supplied artwork to the active semantic accent. */}
  <svg class="h-8 w-8 shrink-0 text-[var(--color-accent)]" viewBox="0 0 1000 1000" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M 300 350 L 500 265 L 700 350 L 700 470" stroke-width="28" />
    <path d="M 355 610 Q 500 770 645 610" stroke-width="28" />
    <path d="M 180 495 C 280 438 382 412 530 420 C 648 427 703 485 758 512" stroke-width="26" />
    <path d="M 334 492 C 410 443 492 433 604 444 C 656 450 681 475 714 509" stroke-width="12" />
    <path d="M 110 520 L 640 520" stroke-width="18" />
    <path d="M 70 520 L 350 520" stroke-width="12" />
    <path d="M 88 555 L 418 555" stroke-width="12" />
    <path d="M 118 590 L 350 590" stroke-width="12" />
    <path d="M 742 514 C 850 520 915 526 955 566" stroke-width="18" />
    <path d="M 760 557 C 868 563 935 576 970 634" stroke-width="12" />
  </svg>
  <span
    data-brand-wordmark
    class={`select-none font-brand text-[length:var(--text-brand)] font-normal italic leading-none tracking-normal text-[var(--color-accent)] ${wordmarkDisplay}`}
  >{business.publicBrand}</span>
</Tag>
