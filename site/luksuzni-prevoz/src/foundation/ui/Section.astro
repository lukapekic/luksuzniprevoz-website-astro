---
/**
 * Section primitive — Document group
 *
 * Contract:
 * - Wraps content in a <section> with heading level context
 * - Supports aria-labelledby for accessibility
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
interface Props {
  /** Section id */
  id?: string;
  /** ID of the heading element that labels this section */
  "aria-labelledby"?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
}

const {
  id,
  "aria-labelledby": ariaLabelledby,
  class: className,
} = Astro.props;
---

<section id={id} aria-labelledby={ariaLabelledby} class={className}>
  <slot />
</section>
