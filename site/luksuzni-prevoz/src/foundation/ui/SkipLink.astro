---
/**
 * SkipLink primitive — FND-A11Y-08
 *
 * Contract:
 * - Links to #main-content for keyboard navigation.
 * - Visually hidden, revealed on focus (keyboard only).
 * - Visible label comes from the UI string dictionary (FND-ARCH-03) — passed in
 *   by `Page`, which resolves the localized `a11y.skipToContent` string per
 *   locale. The component never hardcodes user-visible copy.
 * - Meets the 44×44 target-size requirement when revealed (FND-A11Y-05).
 * - Semantic Theme V2 spacing/type/color roles (no default-scale utilities).
 * - CSS logical properties only (FND-I18N-13).
 *
 * Ownership: `Page` renders exactly one SkipLink per document. No site chrome
 * component (SiteHeader etc.) renders a second skip link — there is a single
 * skip-to-content target (#main-content).
 */
interface Props {
  /** Localized skip-to-content label (resolved by Page from the UI dictionary). */
  text: string;
}

const { text } = Astro.props;
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:inset-block-start-[var(--space-2)] focus:inset-inline-start-[var(--space-2)] focus:z-[9999] focus:min-h-11 focus:min-w-11 focus:px-[var(--space-4)] focus:py-[var(--space-2)] focus:bg-[var(--color-accent)] focus:text-[var(--color-text-on-light)] focus:rounded-[var(--radius-control)] focus:font-body focus:text-[length:var(--text-sm)] focus:font-semibold focus:outline-2 focus:outline-[var(--color-focus-dark)] focus:outline-offset-2 focus:no-underline"
>
  {text}
</a>
