---
/**
 * Select primitive — Form group, FND-A11Y-10
 *
 * Contract:
 * - Renders <select> element
 * - Min 44×44 target size (FND-A11Y-05)
 * - Error state styling via aria-invalid
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import { inputVariants } from "./Input.variants.ts";

interface SelectOption {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  /** Select name */
  name: string;
  /** Options */
  options: SelectOption[];
  /** Required state */
  required?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Error state — triggers aria-invalid + links `${id}-error` */
  error?: string;
  /** Hint id link — when set, `${id}-hint` is added to aria-describedby */
  hint?: boolean;
  /** Selected value */
  value?: string;
  /** Placeholder option */
  placeholder?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Size variant */
  size?: "sm" | "md" | "lg";
  /** Element id */
  id?: string;
}

const {
  name,
  options,
  required = false,
  disabled = false,
  error,
  hint,
  value,
  placeholder,
  class: className,
  size,
  id,
} = Astro.props;

const classNames = inputVariants({ size: size ?? "md" }, className);

// Link help/error text rendered by <Field> (ids `${id}-hint` / `${id}-error`).
const describedByParts: string[] = [];
if (hint) describedByParts.push(`${id ?? name}-hint`);
if (error) describedByParts.push(`${id ?? name}-error`);
const describedBy =
  describedByParts.length > 0 ? describedByParts.join(" ") : undefined;
---

<select
  id={id}
  name={name}
  value={value}
  required={required}
  disabled={disabled}
  aria-invalid={error ? "true" : undefined}
  aria-describedby={describedBy}
  class={classNames}
>
  {placeholder && (
    <option value="" disabled>
      {placeholder}
    </option>
  )}
  {options.map((option) => (
    <option value={option.value} disabled={option.disabled}>
      {option.label}
    </option>
  ))}
</select>
