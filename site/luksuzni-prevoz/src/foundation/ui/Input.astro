---
/**
 * Input primitive — Form group, FND-A11Y-10
 *
 * Contract:
 * - Renders <input> with autocomplete support (FND-A11Y-10)
 * - Min 44×44 target size (FND-A11Y-05)
 * - Error state styling via aria-invalid
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import { inputVariants } from "./Input.variants.ts";
import type { AutocompleteToken } from "@astro-foundation/core/content";

/** Valid HTML input types (WHATWG). FND-A11Y-10: autocomplete + type are
 *  validated so a screen reader announces the correct field purpose. */
type InputType =
  | "text" | "email" | "password" | "number" | "tel" | "url"
  | "search" | "date" | "time" | "datetime-local" | "month" | "week"
  | "checkbox" | "radio" | "range" | "color" | "file" | "hidden"
  | "submit" | "button" | "reset" | "image";

interface Props {
  /** Input name */
  name: string;
  /** Input type (FND-A11Y-10: must be a valid WHATWG input type) */
  type?: InputType;
  /** Autocomplete value (FND-A11Y-10: a WHATWG autofill token, e.g. "email" or "section-main shipping street-address") */
  autocomplete?: AutocompleteToken | `${AutocompleteToken}`;
  /** Required state */
  required?: boolean;
  /** Error state */
  error?: string;
  /** Value */
  value?: string;
  /** Placeholder */
  placeholder?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Size variant */
  size?: "sm" | "md" | "lg";
  /** Element id */
  id?: string;
}

const {
  name,
  type = "text",
  autocomplete,
  required = false,
  error,
  value,
  placeholder,
  class: className,
  size,
  id,
} = Astro.props;

const classNames = inputVariants({ size: size ?? "md" }, className);
---

<input
  id={id}
  name={name}
  type={type}
  autocomplete={autocomplete}
  required={required}
  aria-invalid={error ? "true" : undefined}
  aria-describedby={error ? `${id ?? name}-error` : undefined}
  value={value}
  placeholder={placeholder}
  class={classNames}
/>
