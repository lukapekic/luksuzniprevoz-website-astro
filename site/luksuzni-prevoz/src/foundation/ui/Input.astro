---
/**
 * Input primitive — Form group, FND-A11Y-10
 *
 * Contract:
 * - Renders <input> with autocomplete support (FND-A11Y-10)
 * - Min 44×44 target size (FND-A11Y-05)
 * - Error state styling via aria-invalid
 * - class passthrough is layout-only (FND-UI-06)
 * - CSS logical properties only (FND-I18N-13)
 */
import { inputVariants } from "./Input.variants.ts";
import type { AutocompleteToken } from "@astro-foundation/core/content";

/** Valid HTML input types (WHATWG). FND-A11Y-10: autocomplete + type are
 *  validated so a screen reader announces the correct field purpose. */
type InputType =
  | "text" | "email" | "password" | "number" | "tel" | "url"
  | "search" | "date" | "time" | "datetime-local" | "month" | "week"
  | "checkbox" | "radio" | "range" | "color" | "file" | "hidden"
  | "submit" | "button" | "reset" | "image";

interface Props {
  /** Input name */
  name: string;
  /** Input type (FND-A11Y-10: must be a valid WHATWG input type) */
  type?: InputType;
  /** Autocomplete value (FND-A11Y-10: a WHATWG autofill token, e.g. "email" or "section-main shipping street-address") */
  autocomplete?: AutocompleteToken | `${AutocompleteToken}`;
  /** Required state */
  required?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Read-only state */
  readonly?: boolean;
  /** Native minimum character count */
  minlength?: number;
  /** Native maximum character count */
  maxlength?: number;
  /** Native validation pattern (custom messages remain caller-owned) */
  pattern?: string;
  /** Native numeric/date minimum */
  min?: number | string;
  /** Native numeric/date maximum */
  max?: number | string;
  /** Native numeric/time increment */
  step?: number | string;
  /** Mobile keyboard hint */
  inputmode?: "none" | "text" | "decimal" | "numeric" | "tel" | "search" | "email" | "url";
  /** Browser capitalization hint */
  autocapitalize?: "none" | "off" | "sentences" | "on" | "words" | "characters";
  /** Browser spelling assistance */
  spellcheck?: boolean;
  /** Error state — triggers aria-invalid + links `${id}-error` */
  error?: string;
  /** Hint id link — when set, `${id}-hint` is added to aria-describedby */
  hint?: boolean;
  /** Value */
  value?: string;
  /** Placeholder */
  placeholder?: string;
  /** Layout-only class (FND-UI-06) */
  class?: string;
  /** Size variant */
  size?: "sm" | "md" | "lg";
  /** Element id */
  id?: string;
}

const {
  name,
  type = "text",
  autocomplete,
  required = false,
  disabled = false,
  readonly: isReadonly = false,
  minlength,
  maxlength,
  pattern,
  min,
  max,
  step,
  inputmode,
  autocapitalize,
  spellcheck,
  error,
  hint,
  value,
  placeholder,
  class: className,
  size,
  id,
} = Astro.props;

const classNames = inputVariants({ size: size ?? "md" }, className);

// Link help/error text rendered by <Field> (ids `${id}-hint` / `${id}-error`)
// when the caller passes matching hint/error + a matching id (FND-A11Y-03).
const describedByParts: string[] = [];
if (hint) describedByParts.push(`${id ?? name}-hint`);
if (error) describedByParts.push(`${id ?? name}-error`);
const describedBy =
  describedByParts.length > 0 ? describedByParts.join(" ") : undefined;
---

<input
  id={id}
  name={name}
  type={type}
  autocomplete={autocomplete}
  required={required}
  disabled={disabled}
  readonly={isReadonly}
  minlength={minlength}
  maxlength={maxlength}
  pattern={pattern}
  min={min}
  max={max}
  step={step}
  inputmode={inputmode}
  autocapitalize={autocapitalize}
  spellcheck={spellcheck}
  aria-invalid={error ? "true" : undefined}
  aria-describedby={describedBy}
  value={value}
  placeholder={placeholder}
  class={classNames}
/>
