---
/**
 * Root home — the Serbian (default-locale) homepage at `/`.
 *
 * The default locale is UNPREFIXED (AGENTS.md / .skills/multilingual-routing.md
 * "default locale unprefixed"; getPath / buildHreflangSet / routes:validate /
 * seo:validate all model sr as the unprefixed root). This route therefore
 * generates the Serbian homepage at the unprefixed root. Non-default locales
 * are prefixed and generated by
 * `[locale]/index.astro` (en→/en/, ru→/ru/). Both render the shared HomePage
 * component so there is a single rendering path.
 *
 * Routing invariant (P1.5): the route generated here (`/`) == getPath("home",
 * "sr") (`/`) == the hreflang `sr-Latn`/`x-default` path == the canonical URL ==
 * the internal nav links SiteHeader emits for the default locale.
 */
import HomePage from "../components/home/HomePage.astro";
import { defaultLocale } from "../data/locales.ts";

const locale = defaultLocale;
---

<HomePage locale={locale} />
