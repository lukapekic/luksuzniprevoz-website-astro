---
/**
 * Root index — redirects to the default locale home page.
 * FND-I18N-02: Default locale URLs are unprefixed, but for the reference site
 * we redirect to the default locale prefixed path to avoid ambiguity.
 */
import { config } from "../../foundation.config.ts";

const defaultLocale = config.locales.locales.find((l) => l.isDefault)?.code ?? "sr";

return Astro.redirect(`/${defaultLocale}/`);
---
