---
/**
 * Locale-specific home page — non-default locales (en, ru) only.
 *
 * The default locale (sr) is UNPREFIXED and generated at `/` by
 * pages/index.astro; this route generates only the prefixed non-default
 * homepages: /en/ (English), /ru/ (Russian). Both this route and the root
 * home render the shared HomePage component so there is one rendering path
 * (route file → shared page component).
 *
 * Assembly: docs/home/home-components/13-home-assembly.md
 * Blueprint: docs/home/reference/blueprint.md §5 (Homepage order)
 */
import HomePage from "../../components/home/HomePage.astro";
import type { LocaleCode } from "@astro-foundation/core";
import { nonDefaultLocales } from "../../data/locales.ts";

export function getStaticPaths() {
  // Default locale (sr) is unprefixed — generated at `/` by pages/index.astro,
  // never here. Only the prefixed non-default locales are emitted.
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const currentLocale = locale as LocaleCode;
if (!nonDefaultLocales.includes(currentLocale)) {
  throw new Error(`Unconfigured prefixed locale: ${locale ?? "(missing)"}`);
}
---

<HomePage locale={currentLocale} />
