---
/**
 * Locale-specific home page — FND-ARCH-03.
 *
 * Assembly: docs/home/home-components/13-home-assembly.md
 * Blueprint: docs/home/reference/blueprint.md §5 (Homepage order)
 *
 * Uses the `Page` primitive directly (owns <head>/SEO/hreflang/global CSS — only
 * Page emits head tags) rather than BaseLayout, because the premium home chrome
 * is the SiteHeader + SiteFooter pair, not the generic foundation Header/Footer
 * BaseLayout composes. Body holds: SkipLink (Page), SiteHeader, <main>,
 * SiteFooter.
 *
 * Content is fetched per locale from the `pages` collection and narrowed to the
 * `home` archetype (homePageSchema via the pageType discriminator) so the hero
 * and finalCta blocks are typed and passed straight to the components. All three
 * locales (sr/en/ru) are required (FND-I18N — every locale for every page).
 *
 * V1 partial assembly: only the chrome + Hero + FinalCTA are mounted today. The
 * remaining sections (ServiceShowcase, PrivateChauffeur, Trust, Fleet,
 * HowItWorks, GoogleReviews) slot into <main> between Hero and FinalCTA as their
 * components land (13 §Exact order). Each component owns its own section spacing,
 * so no wrapper rhythm is added here.
 */
import Page from "../../foundation/ui/Page.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import HomepageHero from "../../components/home/HomepageHero.astro";
import FinalCTA from "../../components/home/FinalCTA.astro";
import { getCollection } from "astro:content";
import { buildPageSeo } from "../../lib/seo.ts";
import { resolveCtaHref, type Cta } from "../../lib/cta.ts";
import heroImg from "../../assets/hero.webp";
import type { LocaleCode } from "@astro-foundation/core";

export function getStaticPaths() {
  return [
    { params: { locale: "sr" } },
    { params: { locale: "en" } },
    { params: { locale: "ru" } },
  ];
}

const { locale } = Astro.params;
const currentLocale = (locale ?? "sr") as LocaleCode;

// --- Editorial content (per locale) --------------------------------------
const pages = await getCollection("pages");
const entry = pages.find(
  (p) => p.data.routeKey === "home" && p.data.locale === currentLocale,
);
if (!entry) {
  throw new Error(
    `Home page content not found for locale "${currentLocale}" — every locale requires a published home entry (src/content/pages/home/home.${currentLocale}.md).`,
  );
}
// Discriminate the union to the home archetype so hero/finalCta are typed.
if (entry.data.pageType !== "home") {
  throw new Error(
    `Home route entry for locale "${currentLocale}" has pageType "${entry.data.pageType}" — expected "home".`,
  );
}
const { hero, finalCta, seoTitle, seoDescription } = entry.data;

// --- SEO (content-driven) -------------------------------------------------
const seo = buildPageSeo({
  routeKey: "home",
  locale: currentLocale,
  title: seoTitle,
  description: seoDescription,
});

// Hero CTAs resolve via resolveCtaHref (FND-I18N-03 — flow targets route to
// the contact page as the interim booking/quote target; lib/cta.ts).
//
// TEMPORARY COMPATIBILITY WIRING — NOT the final locked Hero composition.
// The locked hero contract (03-home-hero / blueprint §7) requires:
//   • primary    Book            → booking flow (interim → contact)   [wired]
//   • secondary  Request a Quote  → caller equivalent                  [pending]
//   • right-side support statement                                    [pending]
// The editorial hero block (src/content/pages/home/home.*.md) authors
// `primaryCta` ("Book a ride" → booking flow → interim contact) and a
// `secondaryCta` of "View fleet" → fleet. "View fleet" is NOT the final
// approved secondary hero action (the contract wants Request a Quote), and
// the right-side support statement is not authored at all (heroSchema has no
// support field — blueprint §20 pending content pass). So `secondaryAction`
// is wired from the current `secondaryCta` only to keep the secondary <Link>
// rendering, and `supportText` is omitted → HomepageHero renders a single
// left content column. Do NOT treat "View fleet" as the final secondary.
//
// TODO(home-assembly): author the final hero secondary ("Request a Quote") and
//   the right-side support statement in the editorial home content, then
//   promote `secondaryAction` / `supportText` to required props (see
//   HomepageHero.types.ts TODO(home-visual-lock)) and re-wire this call site
//   before the Homepage visual lock.
// The hero image is the approved pending S-Class asset (blueprint §21).
const heroPrimaryAction = {
  label: hero.primaryCta.label,
  href: resolveCtaHref(hero.primaryCta as Cta, currentLocale),
};
const heroSecondaryAction = hero.secondaryCta
  ? {
      label: hero.secondaryCta.label,
      href: resolveCtaHref(hero.secondaryCta as Cta, currentLocale),
    }
  : undefined;
---

<Page
  seo={seo}
  class="min-h-screen flex flex-col bg-[var(--color-background)] text-[var(--color-text-primary)]"
>
  <SiteHeader currentRouteKey="home" currentLocale={currentLocale} overHero={true} />

  <main id="main-content" class="flex-1">
    <HomepageHero
      title={hero.title}
      description={hero.description}
      primaryAction={heroPrimaryAction}
      secondaryAction={heroSecondaryAction}
      image={heroImg}
      imageAlt=""
      locale={currentLocale}
    />
    {/* 13 §Exact order: ServiceShowcase, PrivateChauffeur, Trust, Fleet,
        HowItWorks, GoogleReviews mount here as their components land. */}
    <FinalCTA currentLocale={currentLocale} finalCta={finalCta} />
  </main>

  <SiteFooter currentRouteKey="home" currentLocale={currentLocale} />
</Page>
