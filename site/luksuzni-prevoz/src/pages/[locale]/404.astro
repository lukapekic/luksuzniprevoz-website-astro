---
/**
 * Per-locale 404 page — FND-ENV-04.
 *
 * Emits /en/404/, /ru/404/ so a host can serve a locale-specific 404 based on
 * the path prefix (e.g. Netlify/Cloudflare edge rules). The default locale
 * (sr) is UNPREFIXED — its 404 is the root src/pages/404.astro (host fallback
 * for un-prefixed URLs). Both use the production chrome (Page + SiteHeader +
 * SiteFooter) and the UI dictionary (FND-ARCH-03) — no hardcoded strings —
 * and the approved Link `cta` variant (no hand-built action).
 */
import Page from "../../foundation/ui/Page.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import Section from "../../foundation/ui/Section.astro";
import PageContainer from "../../foundation/ui/PageContainer.astro";
import Link from "../../foundation/ui/Link.astro";
import type { RouteKey, LocaleCode } from "@astro-foundation/core";
import { config } from "../../../foundation.config.ts";
import { t } from "../../lib/i18n.ts";
import { getLocaleConfig, nonDefaultLocales } from "../../data/locales.ts";

export function getStaticPaths() {
  // Default locale (sr) is unprefixed — its 404 is the root pages/404.astro.
  // Emit only prefixed non-default-locale 404s for hosts that serve a
  // locale-specific 404 by path prefix.
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const currentLocale = locale as LocaleCode;
if (!nonDefaultLocales.includes(currentLocale)) {
  throw new Error(`Unconfigured locale-specific 404: ${locale ?? "(missing)"}`);
}
const currentRouteKey: RouteKey = "home";

const localeConfig = getLocaleConfig(currentLocale);
const localeInfo = {
  htmlLang: localeConfig.htmlLang,
  dir: localeConfig.dir,
};

const notFoundTitle = t("error.404.title", currentLocale);
const notFoundMessage = t("error.404.message", currentLocale);
const homeLabel = t("home.title", currentLocale);

const seo = {
  title: `404 — ${notFoundTitle}`,
  description: notFoundMessage,
  locale: localeInfo,
  brand: config.brand,
  noindex: true,
};
---

<Page seo={seo} locale={currentLocale} class="min-h-screen flex flex-col bg-[var(--color-background)] text-[var(--color-text-primary)]">
  <SiteHeader currentRouteKey={currentRouteKey} currentLocale={currentLocale} overHero={false} />

  <main id="main-content" class="flex-1">
    <Section id="not-found" spacing="feature" class="text-center">
      <PageContainer>
        <h1 class="font-heading text-[length:var(--text-display)] font-bold text-[var(--color-text-muted)] leading-[var(--line-height-tight)]">
          404
        </h1>
        <p class="mt-[var(--space-4)] font-body text-[length:var(--text-xl)] text-[var(--color-text-muted)]">
          {notFoundTitle}
        </p>
        <p class="mt-[var(--space-2)] font-body text-[var(--color-text-muted)]">
          {notFoundMessage}
        </p>
        <div class="mt-[var(--space-8)] flex justify-center">
          <Link to={currentRouteKey} locale={currentLocale} variant="cta">
            {homeLabel}
          </Link>
        </div>
      </PageContainer>
    </Section>
  </main>

  <SiteFooter currentRouteKey={currentRouteKey} currentLocale={currentLocale} />
</Page>
