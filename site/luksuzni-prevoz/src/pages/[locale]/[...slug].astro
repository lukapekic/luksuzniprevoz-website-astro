---
/**
 * Non-default-locale leaf pages — PREFIXED (/en/…, /ru/…).
 *
 * Generates English and Russian non-home content pages at their canonical
 * prefixed URLs: /en/contact/, /ru/kontakty/, etc. The default locale (sr) is
 * UNPREFIXED and emitted by the root [...slug].astro; this route emits only
 * the prefixed non-default locales. Both render the shared LeafPage component.
 *
 * FND-ARCH-03 / FND-I18N-03: URLs come from the route map (getPath), content
 * from the `pages` collection by routeKey + locale.
 */
import ContentPageRenderer from "../../components/site/ContentPageRenderer.astro";
import { buildLeafStaticPaths } from "../../lib/pages.ts";
import { nonDefaultLocales } from "../../data/locales.ts";

export async function getStaticPaths() {
  // Default locale (sr) is unprefixed — emitted by the root [...slug].astro,
  // never here. Only prefixed non-default locales ({ locale, slug } params).
  return buildLeafStaticPaths(nonDefaultLocales, { prefixed: true });
}

const { routeKey, locale, content } = Astro.props;
---

<ContentPageRenderer routeKey={routeKey} locale={locale} content={content} />
