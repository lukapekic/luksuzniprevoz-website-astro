const faqItems: FaqItem[] = [
  { question: "Da li možete doći po nas direktno na aerodrom?", answer: "Da. Vozač prati let u realnom vremenu i dočekuje vas u holu, sa tablom na kojoj piše vaše ime — i u slučaju kašnjenja i pri ranijem prispeću." },
