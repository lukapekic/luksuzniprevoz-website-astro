// FinalCTA contact channels — verified-only canonical gating, mirroring the
// production home/FinalCTA adapter + SiteFooter (task 2E/3C). Repository
// contact.ts currently has phone/email/whatsapp = null +
// "owner-confirmation-required" → no verified channels → the contact row is
// absent here (no fake placeholder values). Once the owner supplies +
// verifies phone/email, exactly one phone + one email render here and in
// production. BLOCKER: see completion report — real launch phone/email are
// not yet in the repository.
const fctaPhone = isVerified(contact.phone) ? contact.phone.value : null;
const fctaEmail = isVerified(contact.email) ? contact.email.value : null;
const fctaContacts =
  fctaPhone || fctaEmail
    ? {
        phone: fctaPhone ?? undefined,
        email: fctaEmail ?? undefined,
      }
    : undefined;

// ── Breadcrumbs sample trails (dev-only). hrefs are sample anchors ("#"),
