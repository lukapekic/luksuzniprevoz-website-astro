           SiteHeader component API. It runs after the component's is:inline
           hide script (document order), so it re-opens the panel the component
           hid for JS users. */}
      <script is:inline>
        try {
          var p = document.getElementById("hdr-mo-mobile");
          var t = document.querySelector('[data-menu-toggle][aria-controls="hdr-mo-mobile"]');
          if (p && t) { p.removeAttribute("hidden"); p.setAttribute("data-open", ""); t.setAttribute("aria-expanded", "true"); }
        } catch (e) {}
      </script>

      {/* Dev-only: pin the desktop dropdown states open inside their bounded
           frames. Opens the panel (remove hidden + aria-expanded) and marks the
           region data-dropdown-static so the production hover/click/escape logic
           leaves it open. This mirrors the mobile-panel force-open mechanism —
           it lives outside the production SiteHeader API. */}
      <script is:inline>
        try {
          function pin(panelId) {
            var panel = document.getElementById(panelId);
            var trig = document.querySelector('[data-dropdown-trigger][aria-controls="' + panelId + '"]');
            if (panel && trig) {
              panel.removeAttribute("hidden");
              trig.setAttribute("aria-expanded", "true");
              var region = trig.closest("[data-dropdown]");
              if (region) region.setAttribute("data-dropdown-static", "");
            }
          }
          // Services root + Business Transportation nested flyout
          pin("hdr-dd-biz-services");
          pin("hdr-dd-biz-sub-businessTransportation");
          // Services root + Special Events nested flyout
          pin("hdr-dd-evt-services");
          pin("hdr-dd-evt-sub-specialEvents");
          // Language dropdown
          pin("hdr-dd-lang-lang-panel");
        } catch (e) {}
