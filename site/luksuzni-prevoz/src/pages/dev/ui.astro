// ── HorizontalCarousel dev-only fixture items (not production copy). Two
//    independent instances review instance isolation + both item-size presets.
//    Fleet-like = image-heavy (compact); Review-like = text-heavy (standard).
//    Passed as typed array expressions so no-hardcoded-ui-string (FND-ARCH-03)
//    is not flagged; the preview is noindex/internal. Fixture imagery
//    (hero / final-cta-bg) stands in for not-yet-produced fleet photography;
//    attribution labels are generic dev labels (no real client names). Serbian
//    copy is Latin-only (the sr locale is Latin-only). `ImageMetadata` is not
//    re-exported by astro:assets in this Astro version, so it is anchored via a
//    type-only import of a representative asset (mirrors ServiceCard.types.ts).
import type sampleHeroAsset from "../../assets/hero.webp";
type FixtureImage = typeof sampleHeroAsset;

type FleetFixture = {
