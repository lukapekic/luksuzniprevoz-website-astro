      </div>

      {/* Mobile open state — same component, panel forced open by a dev-only script */}
      <SectionHeading heading={samples.mobileOpenLabel} description={samples.mobileOpenNote} level={3} class="mt-[var(--space-section-compact)]" />
      <div class="preview-frame force-mobile open-frame mt-[var(--space-8)]">
        <SiteHeader currentRouteKey="home" currentLocale="sr" overHero={false} idPrefix="hdr-mo" />
      </div>

      {/* Dev-only: force the mobile-open panel open inside its bounded frame.
           This is a /dev/ui preview mechanism — it lives outside the production
           SiteHeader component API. It runs after the component's is:inline
           hide script (document order), so it re-opens the panel the component
           hid for JS users. */}
      <script is:inline>
        try {
          var p = document.getElementById("hdr-mo-mobile");
          var t = document.querySelector('[data-menu-toggle][aria-controls="hdr-mo-mobile"]');
          if (p && t) { p.removeAttribute("hidden"); p.setAttribute("data-open", ""); t.setAttribute("aria-expanded", "true"); }
        } catch (e) {}
      </script>
    </PreviewBlock>

    {/* ── Placeholders (later steps) ───────────────────────────────────── */}
    {placeholderGroups.map((group) => (
      <PreviewBlock
        id={group.id}
        heading={group.heading}
        description={group.description}
      />
    ))}
  </main>
</Page>

<style>
  /* Dev-only preview frames for the Navigation / Header section.
   *
   * These styles are NOT production. They only:
   *   - keep the sticky SiteHeader in-frame (position: relative) so each state
   *     renders inside its bounded box instead of escaping to the viewport;
   *   - provide a hero-image background for the transparent overlay state;
   *   - force the mobile layout (.force-mobile) on wide screens so the mobile
   *     states are previewable without resizing the browser;
   *   - contain the mobile panel inside the open-frame (.open-frame) instead of
   *     the viewport-fixed production behavior.
   * They reach into SiteHeader internals via :global() because the Header's own
   * scoped styles own those elements. No second fake Header is rendered. */
  .preview-frame {
    position: relative;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-background);
  }
  .preview-frame :global([data-site-header]) { position: relative; }

  /* Overlay / top-of-page — hero image is a decorative CSS backdrop */
  .overlay-frame {
    min-block-size: 22rem;
    background-size: cover;
    background-position: center;
  }
  .overlay-frame__hero { position: relative; padding: var(--space-12) var(--gutter-page); }

  /* Solid / scrolled */
  .solid-frame__body { padding: var(--space-12) var(--gutter-page); }

  /* Force mobile layout regardless of viewport width (preview only) */
  .force-mobile { max-inline-size: 28rem; }
  .force-mobile :global(.nav-desktop) { display: none !important; }
  .force-mobile :global(.menu-toggle) { display: inline-flex !important; }
  .force-mobile :global(.lang-switcher) { display: none !important; }

  /* Contain the mobile panel inside the open-frame (production is viewport-fixed) */
  .open-frame { block-size: 32rem; }
  .open-frame :global(.mobile-panel) {
    position: absolute !important;
    inset-block: 0;
    inset-inline-start: auto;
    inset-inline-end: 0;
    inline-size: min(100%, 22rem) !important;
    transform: translateX(0) !important;
  }
</style>
