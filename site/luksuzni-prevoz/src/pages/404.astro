---
/**
 * Localized 404 page — FND-ENV-04
 *
 * Uses Page with noindex, working navigation.
 * Shows content for current locale (defaults to sr).
 */
import Page from "../foundation/ui/Page.astro";
import PageContainer from "../foundation/ui/PageContainer.astro";
import Section from "../foundation/ui/Section.astro";
import Header from "../foundation/ui/Header.astro";
import Footer from "../foundation/ui/Footer.astro";
import { getPath } from "@astro-foundation/core/i18n";
import { config } from "../../foundation.config.ts";
import { routes } from "../data/routes.ts";

// Default to sr locale for 404
const currentLocale = "sr";
const currentRouteKey = "home";

const localeConfig = config.locales.locales.find((l) => l.code === currentLocale);
const localeInfo = {
  htmlLang: localeConfig?.htmlLang ?? "sr",
  dir: localeConfig?.dir ?? "ltr",
};

const seo = {
  title: "404 — Page not found",
  description: "The page you are looking for does not exist.",
  locale: localeInfo,
  brand: config.brand,
  noindex: true,
};

// Load UI strings
import srStrings from "../content/ui/sr.json";
const strings = srStrings as unknown as Record<string, string>;

const defaultLocale = config.locales.locales.find((l) => l.isDefault)?.code ?? "sr";
const homeHref = getPath("home", currentLocale, routes, defaultLocale);
const notFoundTitle = strings["error.404.title"] ?? "Page not found";
const notFoundMessage = strings["error.404.message"] ?? "The page you are looking for does not exist.";
---

<Page seo={seo} class="min-h-screen flex flex-col bg-[var(--color-background)] text-[var(--color-text-primary)]">
  <Header currentRouteKey={currentRouteKey} currentLocale={currentLocale} />

  <main id="main-content" class="flex-1">
    <Section id="not-found" class="py-[var(--space-16)]">
      <PageContainer class="text-center">
        <h1 class="font-heading text-[length:var(--text-display)] font-bold text-[var(--color-text-muted)]">
          404
        </h1>
        <p class="mt-[var(--space-4)] font-body text-[length:var(--text-xl)] text-[var(--color-text-muted)]">
          {notFoundTitle}
        </p>
        <p class="mt-[var(--space-2)] font-body text-[var(--color-text-muted)]">
          {notFoundMessage}
        </p>
        <div class="mt-[var(--space-8)] flex justify-center gap-4">
          <a
            href={homeHref}
            class="inline-flex min-h-11 items-center justify-center rounded-[var(--radius-control)] bg-[var(--color-accent)] px-6 py-3 font-body text-base font-medium text-[var(--color-text-on-light)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-accent-hover)]"
          >
            {strings["home.title"] ?? "Добродошли"}
          </a>
        </div>
      </PageContainer>
    </Section>
  </main>

  <Footer currentRouteKey={currentRouteKey} currentLocale={currentLocale} />
</Page>
