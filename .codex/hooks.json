{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/design/hook.mjs\"",
            "timeout": 8,
            "statusMessage": "Checking design rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/design/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design governance pass"
          }
        ]
      }
    ]
  }
}
