{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI review evidence",
  "type": "object",
  "required": ["schemaVersion", "sourceHash", "reviewer", "browser", "manualReview", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceHash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "reviewer": {
      "type": "object",
      "required": ["role", "identity"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "browser": {
      "type": "object",
      "required": ["artifact", "viewports", "locales", "commands"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "viewports": { "type": "array", "minItems": 5, "items": { "type": "string" } },
        "locales": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "manualReview": {
      "type": "object",
      "required": ["authorities", "screenshots", "disposition"],
      "properties": {
        "authorities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "screenshots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "disposition": { "enum": ["accepted", "accepted-with-exception"] }
      },
      "additionalProperties": false
    },
    "findings": { "type": "array" }
  },
  "additionalProperties": false
}
