{
  "ci": {
    "collect": {
      "startServerCommand": "cd examples/reference-site && npx astro build && npx astro preview --port 4321",
      "startServerReadyPattern": "ready",
      "url": [
        "http://localhost:4321/sr/",
        "http://localhost:4321/en/",
        "http://localhost:4321/ru/",
        "http://localhost:4321/sr/aerodrom/",
        "http://localhost:4321/en/about/",
        "http://localhost:4321/sr/o-nama/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 150,
          "downloadThroughputKbps": 1638.4,
          "uploadThroughputKbps": 1638.4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports"
    }
  }
}
