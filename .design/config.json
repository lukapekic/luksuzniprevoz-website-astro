{
  "$schema": "./config.schema.json",
  "schemaVersion": 1,
  "project": "Luxury Transportation",
  "siteRoot": "site/luksuzni-prevoz",
  "theme": {
    "versionsDir": "site/luksuzni-prevoz/src/theme/versions",
    "generatedCss": "site/luksuzni-prevoz/src/theme/generated/theme.css",
    "activeThemeSources": ["site/luksuzni-prevoz/foundation.config.ts"]
  },
  "productionUiRoots": [
    "site/luksuzni-prevoz/src/components",
    "site/luksuzni-prevoz/src/foundation/ui",
    "site/luksuzni-prevoz/src/layouts",
    "site/luksuzni-prevoz/src/pages",
    "site/luksuzni-prevoz/src/styles"
  ],
  "docsRoots": ["site/luksuzni-prevoz/src/docs"],
  "dataRoot": "site/luksuzni-prevoz/src/data",
  "contentRoot": "site/luksuzni-prevoz/src/content",
  "legacyAllowedRoots": ["site/luksuzni-prevoz/src/theme/versions/version-1"],
  "generatedAllowedRoots": ["site/luksuzni-prevoz/src/theme/generated"],
  "sharedComponents": [
    "SiteHeader",
    "SiteFooter",
    "FinalCTA",
    "FAQ",
    "OpenSplitSection",
    "ServiceCard",
    "TrustStrip",
    "HorizontalCarousel",
    "HubServiceSelector",
    "PageContainer",
    "ReadingContainer",
    "Section",
    "SectionHeading",
    "ServiceHero",
    "ServiceOverview",
    "ServiceStandards",
    "VehicleRecommendations",
    "BusinessMovementSequence",
    "OccasionServiceDefinition",
    "OccasionScope",
    "OccasionStandards",
    "OccasionProcessSteps",
    "Button",
    "Link",
    "BrandLockup"
  ],
  "surfaceMap": {
    "home": {
      "match": [
        "src/pages/index.astro",
        "src/pages/[locale]/index.astro",
        "src/components/home/",
        "src/content/pages/home/",
        "src/docs/home/"
      ],
      "blueprints": ["site/luksuzni-prevoz/src/docs/home/reference/blueprint.md"],
      "contracts": ["site/luksuzni-prevoz/src/docs/home/home-components"]
    },
    "private-chauffeur": {
      "match": ["private-chauffeur", "privatni-vozac", "chauffeur"],
      "blueprints": ["site/luksuzni-prevoz/src/docs/services/private-chauffeur/blueprint.md"],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/private-chauffeur"
      ]
    },
    "airport-transportation": {
      "match": ["airport-transportation", "airport-transfer", "aerodrom"],
      "blueprints": ["site/luksuzni-prevoz/src/docs/services/airport-transportation/blueprint.md"],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/airport-transportation"
      ]
    },
    "business-transportation": {
      "match": ["business-transportation", "poslovni"],
      "blueprints": ["site/luksuzni-prevoz/src/docs/services/business-transportation/blueprint.md"],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/business-transportation"
      ]
    },
    "corporate-transportation": {
      "match": [
        "corporate-transportation",
        "corporateTransportation",
        "korporativni-prevoz",
        "korporativnyy-transfer"
      ],
      "blueprints": [
        "site/luksuzni-prevoz/src/docs/services/corporate-transportation/blueprint.md"
      ],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/corporate-transportation"
      ]
    },
    "delegation-transportation": {
      "match": [
        "delegation-transportation",
        "delegationTransportation",
        "prevoz-delegacija",
        "transfer-delegatsiy"
      ],
      "blueprints": [
        "site/luksuzni-prevoz/src/docs/services/delegation-transportation/blueprint.md"
      ],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/delegation-transportation"
      ]
    },
    "conference-congress-transportation": {
      "match": [
        "conference-congress-transportation",
        "conferenceCongressTransportation",
        "prevoz-za-konferencije-i-kongrese",
        "transfer-dlya-konferentsiy-i-kongressov"
      ],
      "blueprints": [
        "site/luksuzni-prevoz/src/docs/services/conference-congress-transportation/blueprint.md"
      ],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/conference-congress-transportation"
      ]
    },
    "special-events": {
      "match": ["special-events", "specialEvents", "specijalne-dogadjaje", "osobykh-meropriyatiy"],
      "blueprints": ["site/luksuzni-prevoz/src/docs/services/special-events/blueprint.md"],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/special-events"
      ]
    },
    "wedding-transportation": {
      "match": [
        "wedding-transportation",
        "weddingTransportation",
        "prevoz-za-vencanja",
        "svadebnyy-transfer"
      ],
      "blueprints": ["site/luksuzni-prevoz/src/docs/services/wedding-transportation/blueprint.md"],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/wedding-transportation"
      ]
    },
    "prom-transportation": {
      "match": [
        "prom-transportation",
        "promTransportation",
        "prevoz-za-maturu",
        "transfer-na-vypusknoy"
      ],
      "blueprints": ["site/luksuzni-prevoz/src/docs/services/prom-transportation/blueprint.md"],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/services/shared",
        "site/luksuzni-prevoz/src/docs/services/prom-transportation"
      ]
    },
    "contact": {
      "match": [
        "src/components/contact/",
        "src/content/pages/contact/",
        "src/docs/contact/",
        "kontakt",
        "kontakty"
      ],
      "blueprints": ["site/luksuzni-prevoz/src/docs/contact/blueprint.md"],
      "contracts": ["site/luksuzni-prevoz/src/docs/contact"]
    },
    "shared-ui": {
      "match": [
        "src/components/shared/",
        "src/components/site/",
        "src/components/services/shared/",
        "src/foundation/ui/",
        "src/layouts/",
        "src/styles/"
      ],
      "blueprintRequired": false,
      "blueprints": [],
      "contracts": [
        "site/luksuzni-prevoz/src/docs/home/home-components",
        "site/luksuzni-prevoz/src/docs/services/shared"
      ]
    },
    "dev-ui": {
      "match": ["src/pages/dev/", "src/components/dev/"],
      "blueprintRequired": false,
      "blueprints": [],
      "contracts": []
    }
  }
}
