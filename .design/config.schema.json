{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Governance Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "siteRoot",
    "theme",
    "productionUiRoots",
    "docsRoots",
    "dataRoot",
    "contentRoot",
    "generatedAllowedRoots",
    "legacyAllowedRoots",
    "sharedComponents",
    "surfaceMap"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "siteRoot": { "type": "string", "minLength": 1 },
    "theme": {
      "type": "object",
      "required": ["versionsDir", "generatedCss", "activeThemeSources"],
      "properties": {
        "versionsDir": { "type": "string", "minLength": 1 },
        "generatedCss": { "type": "string", "minLength": 1 },
        "activeThemeSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "productionUiRoots": { "$ref": "#/$defs/uniquePaths" },
    "docsRoots": { "$ref": "#/$defs/uniquePaths" },
    "dataRoot": { "type": "string" },
    "contentRoot": { "type": "string" },
    "legacyAllowedRoots": { "$ref": "#/$defs/uniquePaths" },
    "generatedAllowedRoots": { "$ref": "#/$defs/uniquePaths" },
    "sharedComponents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "surfaceMap": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "uniquePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
