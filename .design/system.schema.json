{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luxury Transportation Design System Snapshot",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "sourceHash",
    "theme",
    "tokens",
    "cssVariables",
    "inventory"
  ],
  "properties": {
    "$schema": { "const": "./system.schema.json" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "theme": {
      "type": "object",
      "required": ["directory", "version", "name", "status"],
      "properties": {
        "directory": { "type": "string" },
        "version": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "tokens": { "type": "object" },
    "cssVariables": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "cssVariablesReducedMotion": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "inventory": {
      "type": "object",
      "required": ["components", "docs", "dataModules"],
      "properties": {
        "components": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } },
        "dataModules": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
